:root {
  color-scheme: light;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #eef4f8;
  color: #15202b;
  --page-gap: 12px;
  --surface-gap: 10px;
  --surface-radius: 10px;
  --rail-border: rgba(92,132,154,.16);
  --scrollbar-thumb: rgba(99,121,138,.38);
  --scrollbar-thumb-hover: rgba(99,121,138,.56);
  --scrollbar-track: rgba(99,121,138,.08);
}
:root[data-theme="dark"] { color-scheme: dark; background: #070c12; color: #edf7fb; }
* {
  box-sizing: border-box;
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(255,255,255,.22), rgba(255,255,255,.06)), var(--scrollbar-thumb);
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;
}
*::-webkit-scrollbar-thumb:hover { background: linear-gradient(180deg, rgba(255,255,255,.28), rgba(255,255,255,.08)), var(--scrollbar-thumb-hover); }
html, body, #app { width: 100%; height: 100%; }
body { margin: 0; min-width: 320px; overflow: hidden; }

.desktop-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: #091018;
}
.theme-light.desktop-shell { background: #f5f9fc; }
.shell-titlebar {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr) 140px;
  align-items: center;
  height: 24px;
  padding: 0 10px;
  background: #3558e6;
  color: #fff;
  flex: 0 0 auto;
}
.shell-titlegroup { justify-self: center; display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
.shell-titlegroup img { width: 12px; height: 12px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(255,255,255,.2)); }
.shell-titlegroup strong { font-size: 11px; line-height: 1; letter-spacing: .04em; text-transform: capitalize; }
.shell-window-actions { justify-self: end; display: inline-flex; align-items: center; gap: 12px; font-size: 11px; opacity: .95; }
.shell-toolbar {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  align-items: center;
  height: 48px;
  background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,0)), #242424;
  border-bottom: 1px solid #323232;
  flex: 0 0 auto;
}
.theme-light .shell-toolbar { background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,0)), #f5f7fb; border-bottom-color: #d9e0ea; }
.theme-dark .shell-toolbar { background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,0)), #242424; border-bottom-color: #323232; }
.shell-toolbar-left, .shell-toolbar-right { display: flex; align-items: center; height: 100%; }
.shell-toolbar-left { justify-content: center; border-right: 1px solid #323232; }
.shell-toolbar-right { justify-content: flex-end; gap: 12px; padding-right: 12px; border-left: 1px solid #323232; }
.shell-toolbar-center { min-width: 0; display: flex; justify-content: center; padding: 0 16px; }
.theme-light .shell-toolbar-left, .theme-light .shell-toolbar-right { border-color: #d9e0ea; }
.shell-sidebar-dock {
  position: relative;
  width: 18px;
  height: 18px;
  padding: 0;
  border-radius: 5px;
  border: 1px solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.02);
  cursor: pointer;
}
.shell-sidebar-dock::before {
  content: "";
  position: absolute;
  left: 4px;
  top: 3px;
  bottom: 3px;
  width: 3px;
  border-radius: 99px;
  background: rgba(255,255,255,.58);
  transition: left .15s ease;
}
.shell-sidebar-dock.is-collapsed::before { left: 10px; }
.theme-light .shell-sidebar-dock {
  border-color: #c6d3e0;
  background: #ffffff;
  box-shadow: 0 1px 2px rgba(16, 24, 40, .06);
}
.theme-light .shell-sidebar-dock::before { background: #3558e6; }
.shell-model-picker {
  width: min(560px, 100%);
  height: 32px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(10,167,216,.22);
  border-radius: 8px;
  background: rgba(10,167,216,.07);
  color: inherit;
  padding: 0 10px;
  cursor: pointer;
}
.shell-model-picker span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: left; font-size: .84rem; font-weight: 650; }
.shell-model-picker kbd { border: 1px solid rgba(99,121,138,.22); border-radius: 5px; padding: 1px 6px; color: #63798a; background: rgba(255,255,255,.55); font: 700 .68rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
.theme-dark .shell-model-picker { border-color: rgba(255,255,255,.06); background: rgba(255,255,255,.05); color: #efefef; }
.theme-dark .shell-model-picker kbd { color: #8e8e8e; background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.08); }
.toolbarSwitchButton {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 78px;
  height: 28px;
  padding: 0 8px 0 10px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 999px;
  background: rgba(255,255,255,.07);
  color: #efefef;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: background 120ms ease, border-color 120ms ease;
}
.toolbarSwitchButton:hover { filter: brightness(1.08); }
.switchLabel { min-width: 20px; font-size: 11px; font-weight: 700; text-align: right; }
.switchTrack {
  position: relative;
  flex: none;
  width: 34px;
  height: 18px;
  border-radius: 999px;
  background: rgba(255,255,255,.14);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
}
.switchThumb {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 4px rgba(0,0,0,.24);
  transition: transform 140ms ease;
}
.toolbarSwitchButton.isChecked .switchTrack { background: linear-gradient(90deg, #4f7dff, #7c8fff); }
.toolbarSwitchButton.isChecked .switchThumb { transform: translateX(16px); }
.theme-light .toolbarSwitchButton { border-color: #dbe3ef; background: #ffffff; color: #1f2d3d; }
.theme-light .switchTrack { background: rgba(68,82,106,.16); box-shadow: inset 0 0 0 1px rgba(68,82,106,.08); }
.theme-light .toolbarSwitchButton.isChecked .switchTrack { background: linear-gradient(90deg, #3558e6, #5f82ff); }
.toolbarIconButton {
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 8px;
  background: transparent;
  cursor: pointer;
}
.toolbarIconButton:hover, .toolbarIconButton.isActive { background: rgba(255,255,255,.07); }
.theme-light .toolbarIconButton { border-color: #dbe3ef; }
.theme-light .toolbarIconButton:hover, .theme-light .toolbarIconButton.isActive { background: rgba(68,82,106,.08); }
.toolbarIcon { color: rgba(255,255,255,.84); font-size: 17px; line-height: 1; }
.toolbarSvgIcon { display: inline-flex; color: rgba(255,255,255,.84); font-size: 16px; line-height: 1; }
.toolbarIconButton.hasBadge { position: relative; }
.toolbarBadge {
  position: absolute; top: -6px; right: -7px;
  min-width: 16px; height: 16px; padding: 0 4px;
  border-radius: 999px; background: #0aa7d8; color: #fff;
  font-size: 10px; line-height: 16px; font-weight: 800;
  box-shadow: 0 0 0 2px rgba(7,16,22,.98), 0 6px 14px rgba(10,167,216,.35);
}
.theme-light .toolbarIcon, .theme-light .toolbarSvgIcon { color: #44526a; }
.theme-light .toolbarBadge { box-shadow: 0 0 0 2px #fff, 0 6px 14px rgba(10,167,216,.28); }
.shell-downloads-panel {
  position: absolute;
  top: 54px;
  right: 10px;
  z-index: 30;
  width: min(360px, calc(100vw - 20px));
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  border-radius: 14px;
}
.theme-light .shell-downloads-panel { background: #ffffff; border: 1px solid #dbe3ef; box-shadow: 0 20px 32px rgba(31,45,61,.14); }
.theme-dark .shell-downloads-panel { background: #262626; border: 1px solid rgba(255,255,255,.08); box-shadow: 0 24px 40px rgba(0,0,0,.38); }
.shell-downloads-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.shell-downloads-list { max-height: 360px; overflow: auto; display: grid; gap: 8px; }
.shell-download-row {
  width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  padding: 9px;
  border-radius: 8px;
  border: 1px solid rgba(99,121,138,.12);
  background: rgba(10,167,216,.045);
  color: inherit;
  text-align: left;
  cursor: pointer;
}
.shell-download-row span { min-width: 0; display: grid; gap: 2px; }
.shell-download-row b, .shell-download-row small { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.shell-download-row small { color: #63798a; }
.theme-dark .shell-download-row small { color: #9bb4c3; }
.shell-download-glyph { width: 30px; height: 30px; place-items: center; border-radius: 7px; color: #0aa7d8; background: rgba(10,167,216,.1); }
.app-shell { display: grid; grid-template-columns: 216px minmax(0, 1fr); flex: 1; min-height: 0; height: calc(100vh - 72px); transition: grid-template-columns .18s ease; }
.app-shell.sidebar-collapsed { grid-template-columns: 72px minmax(0, 1fr); }
.sidebar { padding: 0; display: flex; flex-direction: column; gap: 0; border-right: 1px solid rgba(49, 197, 255, .22); }
.theme-light .sidebar { background: #f7fbfd; color: #20313d; border-right-color: #d7e7f0; }
.theme-dark .sidebar { background: #071016; color: #d8eef8; border-right-color: rgba(49, 197, 255, .22); }
.sidebar-toggle { color: #557084; }
.theme-dark .brand-block { border-bottom-color: rgba(255,255,255,.12); }
.brand-mark { width: 42px; height: 42px; object-fit: contain; filter: drop-shadow(0 0 14px rgba(0, 191, 255, .18)); }
.brand-mark-wide { width: 44px; height: 44px; object-position: left center; }
.brand-text { display: grid; gap: 2px; min-width: 0; }
.brand-text strong { font-size: .98rem; line-height: 1.2; }
.brand-text span { font-size: .72rem; color: #557084; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.theme-dark .brand-text span { color: #94b7c8; }
.side-menu.ant-menu { background: transparent; border-inline-end: 0; }
.side-menu .ant-menu-item { border-radius: 6px; margin-inline: 0; width: 100%; height: 38px; line-height: 38px; }
.side-menu.ant-menu-inline-collapsed { width: 52px; border-inline-end: 0; }
.side-menu.ant-menu-inline-collapsed .ant-menu-item { width: 52px; padding-inline: 0; display: flex; justify-content: center; }
.side-menu .ant-menu-item-icon { font-size: 16px; }
.theme-light .side-menu .ant-menu-item { color: #294253; }
.theme-dark .side-menu .ant-menu-item { color: #cfe7f2; }
.theme-light .side-menu .ant-menu-item-selected { background: rgba(10, 167, 216, .12); color: #006b95; }
.theme-dark .side-menu .ant-menu-item-selected { background: rgba(16, 162, 211, .2); color: #fff; }
.sidebar-status { margin-top: auto; display: grid; gap: 8px; }
.sidebar-status .ant-tag { width: fit-content; margin-inline-end: 0; }
.sidebar-copyright { display: grid; gap: 2px; padding: 8px 4px; border-top: 1px solid rgba(99,121,138,.14); }
.sidebar-copyright span:first-child { font-size: .72rem; font-weight: 650; color: #557084; }
.sidebar-copyright span:last-child { font-size: .68rem; color: #94b7c8; }
.theme-dark .sidebar-copyright { border-top-color: rgba(74,190,255,.14); }
.theme-dark .sidebar-copyright span:first-child { color: #94b7c8; }
.theme-dark .sidebar-copyright span:last-child { color: #6b8a9e; }
.sideNavMiniLogo img { width: 18px; height: 18px; object-fit: contain; }
.workspace { position: relative; min-width: 0; min-height: 0; height: 100%; overflow: hidden; }
.theme-light .workspace { background: #f5f9fc; }
.theme-dark .workspace { background: #091018; }
.topbar { position: sticky; top: 0; z-index: 8; display: flex; justify-content: space-between; gap: 14px; align-items: center; min-height: 48px; padding: 8px 22px; backdrop-filter: blur(14px); border-bottom: 1px solid rgba(92, 132, 154, .18); }
.theme-light .topbar { background: rgba(245, 249, 252, .78); }
.theme-dark .topbar { background: rgba(9, 16, 24, .74); }
.topbar-info { min-width: 0; color: #5d7180; font-size: .82rem; justify-content: flex-end; margin-left: auto; }
.topbar > .ant-space:last-child { flex: 0 0 auto; }
.theme-dark .topbar-info { color: #a8bfcb; }
.hero { position: relative; min-height: 168px; display: flex; align-items: flex-end; overflow: hidden; border-bottom: 1px solid #d5e3ed; }
.theme-dark .hero { border-bottom-color: rgba(70, 190, 255, .18); }
.hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(245,249,252,.94), rgba(245,249,252,.76) 38%, rgba(245,249,252,.12)); }
.theme-dark .hero::after { background: linear-gradient(90deg, rgba(7,12,18,.84), rgba(7,12,18,.5) 45%, rgba(7,12,18,.1)); }
.hero-copy { position: relative; z-index: 1; padding: 22px 28px; max-width: 760px; }
.hero-copy p { margin: 0 0 7px; color: #0076a3; font-weight: 800; letter-spacing: 0; text-transform: uppercase; font-size: .72rem; }
.theme-dark .hero-copy p { color: #67e8f9; }
.hero-copy h1 { margin: 0; font-size: 1.72rem; line-height: 1.12; }
.hero-copy span { display: block; margin-top: 8px; color: #526b7b; font-size: .95rem; }
.theme-dark .hero-copy { color: #f7fbff; }
.theme-dark .hero-copy span { color: #bdd4df; }
.ant-card { border-radius: var(--surface-radius) !important; }
.ant-card .ant-card-head { min-height: 38px; padding: 0 12px; }
.ant-card .ant-card-head-title { padding: 10px 0; font-size: 13px; }
.ant-card .ant-card-extra { padding: 8px 0; }
.ant-card .ant-card-body { padding: 12px; }
.panel-stack, .settings-panel { padding: 14px 16px 0; display: grid; gap: var(--surface-gap); }
.glass-card, .model-card, .task-list { border-radius: var(--surface-radius) !important; }
.theme-light .glass-card, .theme-light .model-card, .theme-light .task-list { background: rgba(255,255,255,.95) !important; border: 1px solid #d6e4ee !important; box-shadow: 0 8px 20px rgba(18, 45, 63, .055); }
.theme-dark .glass-card, .theme-dark .model-card, .theme-dark .task-list { background: rgba(13, 24, 34, .94) !important; border: 1px solid rgba(74, 190, 255, .2) !important; box-shadow: 0 12px 26px rgba(0,0,0,.22); }
.glass-card .ant-card-head, .model-card .ant-card-head { min-height: 38px; padding: 0 12px; }
.glass-card .ant-card-body, .model-card .ant-card-body { padding: 12px; }
.toolbar-panel { display: grid; grid-template-columns: minmax(240px, 1fr) auto auto auto; gap: 10px; align-items: center; }
.model-download-toolbar { grid-template-columns: minmax(280px, 1fr) auto auto auto; align-items: start; }
.model-download-toolbar > .ant-btn { height: 32px; }
.model-download-input-wrap { position: relative; min-width: 0; display: block; }
.model-download-input-wrap .ant-input-affix-wrapper,
.model-download-input-wrap .ant-input { height: 32px; }
.model-download-input-wrap small {
  position: absolute; left: 2px; top: 36px;
  color: #63798a; font-size: .68rem; line-height: 1; white-space: nowrap;
}
.theme-dark .model-download-input-wrap small { color: #9bb4c3; }
.runtime-hints { display: grid; gap: 8px; margin-top: 10px; }
.download-policy { margin-bottom: 12px; }
.dashboard-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto minmax(132px, .55fr) minmax(0, 1fr) auto; align-items: stretch; height: calc(100vh - 222px); min-height: 0; overflow: hidden; gap: var(--surface-gap); }
.endpoint-strip { grid-column: 1 / -1; min-height: auto !important; align-self: start; }
.endpoint-strip .ant-card-body { padding: 12px 14px; }
.endpoint-strip-inner { display: flex; gap: 10px; align-items: center; min-width: 0; }
.endpoint-strip-inner label { font-weight: 700; white-space: nowrap; }
.console-address-input { width: 25ch; flex: 0 0 auto; }
.console-address-input .ant-input[disabled] { color: #1d3445; cursor: default; }
.theme-dark .console-address-input .ant-input[disabled] { color: #edf7fb; }
.endpoint-strip-inner .ant-tag { max-width: 100%; overflow: hidden; text-overflow: ellipsis; margin-inline-end: 0; }
.lan-status-tag { margin-left: auto; flex: 0 0 auto; }
.endpoint-strip-inner .ant-switch { flex: 0 0 auto; width: 44px; min-width: 44px; justify-self: end; }
.endpoint-strip .ant-empty { margin: 0; }
.endpoint-strip .ant-empty-image { display: none; }
.dashboard-grid > .glass-card:not(.endpoint-strip) { height: 100%; min-height: 0; display: flex; flex-direction: column; }
.dashboard-grid > .glass-card:not(.endpoint-strip) > .ant-card-body { flex: 1; min-height: 0; overflow: hidden; }
.dashboard-scroll-list { max-height: 100%; overflow-y: auto; padding-right: 4px; }
.fill-scroll-list { height: 100%; max-height: none; }
.fill-scroll-list .ant-spin-nested-loading, .fill-scroll-list .ant-spin-container { min-height: 0; height: 100%; }
.compact-dashboard-list { max-height: 100%; }
.dashboard-device { grid-column: 1; width: 100%; }
.dashboard-resources { grid-column: 2; width: 100%; }
.dashboard-activity { grid-column: 3; }
.dashboard-grid > .glass-card.dashboard-device,
.dashboard-grid > .glass-card.dashboard-resources,
.dashboard-grid > .glass-card.dashboard-activity { min-height: 240px; }
.dashboard-containers { grid-column: 1; min-height: 0 !important; }
.dashboard-published { grid-column: 2; min-height: 0 !important; }
.dashboard-tasks { grid-column: 3; min-height: 0 !important; }
.dashboard-descriptions { margin-top: 12px; flex: 1; min-height: 0; overflow-y: auto; }
.host-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; margin-top: 12px; align-content: start; }
.host-stat-item { min-width: 0; padding: 6px 8px; border-radius: 6px; }
.host-stat-item.host-stat-primary { background: rgba(10, 167, 216, 0.06); border-left: 3px solid #0aa7d8; padding-left: 8px; }
.host-stat-item.host-stat-accent { background: rgba(82, 196, 26, 0.05); border-left: 3px solid #52c41a; padding-left: 8px; }
.host-stat-item .host-stat-label { display: block; font-size: 0.7rem; color: #63798a; margin-bottom: 2px; text-transform: uppercase; letter-spacing: 0.03em; }
.host-stat-item b { display: block; font-size: 0.86rem; color: #1e3343; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 650; }
.host-stat-item.host-stat-primary b { font-size: 0.9rem; font-weight: 700; color: #005d82; }
.theme-dark .host-stat-item .host-stat-label { color: #9bb4c3; }
.theme-dark .host-stat-item b { color: #edf7fb; }
.theme-dark .host-stat-item.host-stat-primary { background: rgba(10, 167, 216, 0.1); border-left-color: #4abeff; }
.theme-dark .host-stat-item.host-stat-primary b { color: #67e8f9; }
.theme-dark .host-stat-item.host-stat-accent { background: rgba(82, 196, 26, 0.08); border-left-color: #73d13d; }
.theme-dark .host-stat-item.host-stat-accent b { color: #95de64; }
.resource-grid { display: grid; grid-template-columns: repeat(3, minmax(92px, 1fr)); gap: 12px; align-items: start; text-align: center; overflow-x: auto; padding-bottom: 2px; }
.resource-grid > div { min-width: 0; display: grid; justify-items: center; gap: 6px; }
.resource-grid p, .muted-line { margin: 0; color: #63798a; overflow-wrap: anywhere; }
.theme-dark .resource-grid p, .theme-dark .muted-line { color: #9bb4c3; }
.activity-stats { height: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; align-content: stretch; }
.activity-stat-card { min-width: 0; padding: 10px 12px; border-radius: 8px; background: rgba(10, 167, 216, .07); display: grid; gap: 4px; align-content: center; }
.activity-stat-card span { min-width: 0; color: #63798a; font-size: .76rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.activity-stat-card b { color: #162d3d; font-size: 1.76rem; line-height: 1; font-weight: 760; }
.activity-stat-card strong { min-width: 0; color: #162d3d; font-size: .84rem; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.activity-stat-wide { min-height: 54px; }
.theme-dark .activity-stat-card { background: rgba(10, 167, 216, .12); }
.theme-dark .activity-stat-card span { color: #9bb4c3; }
.theme-dark .activity-stat-card b, .theme-dark .activity-stat-card strong { color: #edf7fb; }
.dashboard-published-table { height: 100%; overflow: auto; }
.dashboard-published-table .ant-table-wrapper, .dashboard-published-table .ant-spin-nested-loading, .dashboard-published-table .ant-spin-container, .dashboard-published-table .ant-table { height: 100%; }
.dashboard-published-table .ant-table-container { max-height: 100%; overflow: auto; }
.dashboard-published-table .ant-table-cell { white-space: nowrap; }
.theme-dark .dashboard-published-table .ant-table { background: transparent; }
.theme-dark .dashboard-published-table .ant-table-cell { color: #bdd4df; background: rgba(13,24,34,.6); border-color: rgba(74,190,255,.1); }
.theme-dark .dashboard-published-table .ant-table-thead .ant-table-cell { background: rgba(10,167,216,.12); color: #67e8f9; }
/* Dashboard: fixed bottom expandable model-list panel */
.dashboard-bottom-panel { position: sticky; bottom: 0; grid-column: 1 / -1; z-index: 10; border-radius: 8px 8px 0 0; overflow: hidden; box-shadow: 0 -4px 16px rgba(18,45,63,.08); }
.panel-toggle-bar { display: flex; align-items: center; gap: 12px; padding: 10px 16px; cursor: pointer; background: rgba(10,167,216,.08); border: 1px solid rgba(10,167,216,.22); border-radius: 8px 8px 0 0; transition: background .2s; }
.panel-toggle-bar:hover { background: rgba(10,167,216,.14); }
.panel-toggle-bar b { font-size: .84rem; color: #0aa7d8; }
.panel-url-hint { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .76rem; color: #63798a; }
.panel-arrow { font-size: .8rem; color: #0aa7d8; }
.panel-expand-body { max-height: 0; overflow: hidden; transition: max-height .3s ease; background: rgba(255,255,255,.97); border: 1px solid rgba(10,167,216,.15); border-top: none; border-radius: 0 0 8px 8px; }
.panel-expanded .panel-expand-body { max-height: 360px; overflow-y: auto; }
.theme-dark .panel-toggle-bar { background: rgba(10,167,216,.1); border-color: rgba(74,190,255,.2); }
.theme-dark .panel-expand-body { background: rgba(13,24,34,.98); border-color: rgba(74,190,255,.18); }
.theme-dark .panel-url-hint { color: #9bb4c3; }
@media (max-width:1120px) { .dashboard-bottom-panel { position: static; } }
.compact-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
/* Deploy page: main + right task bar layout */
.deploy-page-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 12px; min-height: 0; overflow: auto; align-items: stretch; }
.deploy-main-col { display: grid; grid-template-rows: minmax(240px, 1fr) auto; min-height: 0; height: 100%; overflow: hidden; gap: 10px; }
.runtime-service-grid { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; align-content: flex-start; overflow-y: auto; min-height: 0; padding-right: 2px; }
.runtime-service-card { width: 380px; flex-shrink: 0; max-width: 400px; }
.service-log-card .ant-card-body { display: flex; flex-direction: column; min-height: 0; }
.service-log-block { flex: 1; min-height: 0; max-height: none; overflow: auto; word-break: break-all; }
/* Deploy log keeps its own row to avoid a fixed bottom overlay/black bar. */
.deploy-log-bottom { margin-top: 0; flex-shrink: 0; position: static; z-index: auto; }
.deploy-log-bottom .ant-card-body { display: flex; flex-direction: column; min-height: 0; max-height: 260px; overflow: hidden; }
.deploy-log-bottom .service-log-block { background: rgba(255,255,255,.98); box-shadow: none; }
.theme-dark .deploy-log-bottom .service-log-block { background: rgba(7,16,22,.98); box-shadow: none; }
/* Right-side task bar */
.deploy-task-bar { min-height: 0; height: 100%; overflow: hidden; }
.deploy-task-bar > .ant-card { height: 100%; display: flex; flex-direction: column; }
.deploy-task-bar > .ant-card > .ant-card-body { flex: 1; min-height: 0; padding: 10px; overflow: hidden; }
.deploy-task-list { height: 100%; min-height: 0; overflow-y: auto; }
.deploy-task-item { cursor: pointer; padding: 6px 8px; border-radius: 6px; border-bottom: 1px solid rgba(99,121,138,.08); }
.deploy-task-item:hover { background: rgba(10,167,216,.04); }
.deploy-action-row { display: flex; align-items: center; gap: 4px; margin-top: 10px; }
@media (max-width:1120px) { .deploy-page-layout { grid-template-columns: 1fr; height: auto; overflow: visible; } .deploy-task-bar { max-height: 300px; } }
.compact-card { min-height: 100%; }
.model-library-card .ant-card-head-title { min-width: 0; }
.model-library-card .ant-card-body { display: flex; flex-direction: column; min-height: 236px; }
.model-card-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-card-body { display: grid; gap: 10px; min-width: 0; }
.model-path, .model-path-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; margin: 0; color: #63798a; font-size: .82rem; }
.model-path span, .model-path-row span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.theme-dark .model-path, .theme-dark .model-path-row { color: #94aebb; }
.model-chip-strip { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 0; }
.model-chip-strip .ant-tag { max-width: 100%; margin-inline-end: 0; line-height: 20px; }
.model-facts, .container-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 7px 10px; font-size: .82rem; }
.model-facts-clean { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.model-facts span, .container-facts span { min-width: 0; color: #62798a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-facts-clean span { display: grid; gap: 2px; padding: 8px 9px; border-radius: 7px; background: rgba(10, 167, 216, .055); white-space: normal; overflow: visible; }
.model-facts-clean small { color: #63798a; font-size: .72rem; line-height: 1; }
.model-facts b, .container-facts b { margin-left: 4px; color: #1e3343; font-weight: 650; }
.model-facts-clean b { margin-left: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .82rem; line-height: 1.25; }
.theme-dark .model-facts span, .theme-dark .container-facts span { color: #a0b8c6; }
.theme-dark .model-facts b, .theme-dark .container-facts b { color: #edf7fb; }
.theme-dark .model-facts-clean span { background: rgba(74, 190, 255, .075); }
.theme-dark .model-facts-clean small { color: #9bb4c3; }
.model-audit-summary { margin-top: 8px; color: #526a78; font-size: .78rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.theme-dark .model-audit-summary { color: #9fb6c4; }
.container-facts { grid-template-columns: 1fr; }
.container-facts b { display: block; margin: 2px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.support-row { display: flex; gap: 7px; margin-top: 10px; font-size: .82rem; align-items: center; flex-wrap: wrap; }
.model-support-row { display: grid; gap: 6px; align-items: start; margin-top: 0; }
.model-support-row > span { color: #1e3343; font-weight: 650; font-size: .78rem; }
.support-tags { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
.support-tags .ant-tag { margin-inline-end: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
.theme-dark .model-support-row > span { color: #edf7fb; }
.tag-row { margin-top: 10px; }
.runtime-create-hint { margin-top: 10px; padding: 8px 10px; border-radius: 6px; background: rgba(10, 167, 216, .08); }
.card-actions { margin-top: 12px; }
.model-actions { justify-content: flex-end; width: 100%; margin-top: auto; padding-top: 12px; }
.model-actions .ant-space-item { min-width: 0; }
.custom-mode { margin-top: 14px; }
.deploy-grid { grid-template-columns: minmax(220px, 19%) minmax(380px, 1fr) minmax(260px, 320px); align-items: stretch; min-height: calc(100vh - 222px); }
.deploy-tuned { align-items: stretch; }
.deploy-column-card { min-height: 0; }
.deploy-list .ant-card-body { max-height: calc(100vh - 304px); overflow-y: auto; }
.deploy-list .ant-list-item { cursor: pointer; border-radius: 8px; margin-bottom: 6px; padding: 10px; }
.deploy-model-list { min-height: 0; }
.deploy-model-list .ant-list-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
.model-list-content { min-width: 0; flex: 1; display: grid; gap: 2px; }
.model-list-name { font-weight: 650; font-size: .84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-list-path { font-size: .72rem; color: #63798a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-list-tags { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }
.theme-dark .model-list-path { color: #9bb4c3; }
.deploy-center { display: grid; grid-template-rows: auto 1fr auto; gap: 12px; min-height: 0; }
.deploy-side { display: grid; gap: 12px; }
.deploy-params { position: sticky; top: 62px; align-self: start; }
.deploy-params .ant-card-body { max-height: calc(100vh - 150px); overflow-y: auto; }
.param-control { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 10px; align-items: center; }
.param-control .ant-input-number { width: 92px; }
.param-control .ant-slider { margin-inline: 4px 8px; }
.deploy-log { min-height: 0; }
.deploy-log .ant-card-body { display: flex; flex-direction: column; min-height: 0; }
.deploy-info { margin-top: 12px; }
/* When log collapsed, info card fills space */
.deployment-info-short { transition: flex 0.3s; }
.deploy-live-log { flex: 1; min-height: 120px; max-height: none; overflow: auto; }
.deploy-compact-card .ant-card-body { padding: 12px 14px; }
.deploy-kv-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 10px; margin-top: 10px; }
.deploy-kv-grid span { min-width: 0; color: #63798a; font-size: .8rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.deploy-kv-grid b { display: block; margin-top: 2px; color: #1e3343; font-size: .84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.theme-dark .deploy-kv-grid span { color: #9bb4c3; }
.theme-dark .deploy-kv-grid b { color: #edf7fb; }
.version-tags { display: grid; gap: 7px; margin-top: 10px; font-size: .8rem; }
.deploy-action-row { margin-top: 10px; display: flex; align-items: center; gap: 4px; }

.deploy-action-row .runtime-action-btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.deploy-action-row .runtime-action-btn .anticon {
  font-size: 15px;
}
.action-label { display: block; font-size: .82rem; color: #63798a; margin-bottom: 2px; }
.theme-dark .action-label { color: #9bb4c3; }
.model-runtime-summary { border-top: 1px solid rgba(99, 121, 138, .16); padding-top: 8px; }
.deploy-live-log { flex: 1; min-height: 120px; max-height: none; }
.dashboard-task-item {
  cursor: pointer;
  padding: 8px 4px;
  transition: background 0.2s;
  border-bottom: 1px solid rgba(99, 121, 138, 0.08);
}
.dashboard-task-item:last-child { border-bottom: none; }
.theme-light .dashboard-task-item:hover { background: rgba(10, 167, 216, 0.04); }
.theme-dark .dashboard-task-item:hover { background: rgba(10, 167, 216, 0.08); }
.theme-dark .dashboard-task-item { border-bottom-color: rgba(74, 190, 255, 0.1); }
.dashboard-task-row { width: 100%; min-width: 0; display: grid; gap: 4px; }
.task-row-top { display: flex; align-items: center; gap: 8px; min-width: 0; }
.task-row-top .task-name { font-weight: 650; font-size: 0.84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.task-row-top .ant-tag { flex-shrink: 0; }
.task-inline-progress { flex: 0 0 80px; min-width: 60px; }
.task-row-bottom { display: flex; gap: 10px; align-items: center; min-width: 0; }
.task-meta { font-size: 0.74rem; color: #63798a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-meta-desc { flex: 1; min-width: 0; }
.theme-dark .task-meta { color: #9bb4c3; }
.task-grid { grid-template-columns: minmax(320px, 44%) minmax(0, 1fr); align-items: start; }
.task-list .ant-list-item { padding: 10px 12px; cursor: pointer; gap: 10px; }
.task-progress { width: 86px; flex: 0 0 86px; }
.theme-light .task-list .ant-list-item { background: rgba(255,255,255,.92); }
.theme-dark .task-list .ant-list-item { background: rgba(13, 24, 34, .92); }
.selected-row { outline: 2px solid rgba(10, 167, 216, .36); border-radius: 8px; }
.log-toolbar { width: 100%; justify-content: space-between; margin-bottom: 10px; }
.inline-pre, .message-block { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .8rem; line-height: 1.45; }
.message-block { max-height: 420px; overflow: auto; border-radius: 8px; padding: 12px; }
.log-block { min-height: 120px; max-height: 52vh; }
.theme-light .message-block { background: #f8fbfd; border: 1px solid #d6e4ee; }
.theme-dark .message-block { background: #071016; border: 1px solid rgba(74, 190, 255, .2); }
.settings-controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 12px 0; }
.plan-alert { margin-top: 12px; position: static; }
.full-width { width: 100%; }
@media (max-width: 1120px) {
  .dashboard-grid, .runtime-service-page { height: auto; overflow: visible; }
  .dashboard-device, .dashboard-resources, .dashboard-activity, .dashboard-containers, .dashboard-published, .dashboard-tasks, .deploy-log { grid-column: 1 / -1; max-width: none; }
  .deploy-grid, .task-grid { grid-template-columns: 1fr; min-height: auto; }
  .deploy-params { position: static; }
  .deploy-list .ant-card-body, .deploy-params .ant-card-body { max-height: none; }
  .deploy-center { grid-template-rows: auto; }
}
@media (max-width: 840px) {
  .app-shell { grid-template-columns: 1fr; }
  .sidebar { position: static; }
  .workspace { height: auto; min-height: 100vh; }
  .topbar { padding: 8px 14px; align-items: flex-start; }
  .topbar-info { display: none !important; }
  .hero { min-height: 152px; }
  .hero-copy { padding: 18px; }
  .hero-copy h1 { font-size: 1.38rem; }
  .toolbar-panel, .model-download-toolbar { grid-template-columns: 1fr; }
  .endpoint-strip-inner { flex-wrap: wrap; }
  .lan-status-tag { margin-left: 0; }
  .console-address-input { width: min(25ch, calc(100vw - 106px)); }
  .runtime-split { grid-template-columns: 1fr; }
  .param-control { grid-template-columns: 1fr; gap: 2px; }
  .param-control .ant-input-number { width: 100%; }
  .resource-grid { grid-template-columns: repeat(3, minmax(82px, 1fr)); gap: 8px; }
  .resource-grid .ant-progress { transform: scale(.86); transform-origin: center top; margin-bottom: -10px; }
  .resource-grid p { font-size: .76rem; }
  .compact-grid, .settings-card-grid { grid-template-columns: 1fr; }
}


.compatibility-guide-card .ant-card-body {
  padding-top: 12px;
}
.guide-intro {
  margin-bottom: 12px;
}
.compatibility-matrix {
  display: grid;
  gap: 7px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(99, 121, 138, .16);
}
.compatibility-row {
  display: grid;
  grid-template-columns: 74px 86px minmax(0, 1fr);
  gap: 7px;
  align-items: start;
  font-size: .78rem;
}
.compatibility-row b {
  overflow-wrap: anywhere;
}
.compatibility-row span:last-child {
  color: #63798a;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.theme-dark .compatibility-row span:last-child {
  color: #9bb4c3;
}
@media (max-width: 840px) {
  .compatibility-row {
    grid-template-columns: 1fr;
  }
}

.console-strip .endpoint-strip-inner {
  grid-template-columns: auto minmax(0, 1fr) auto;
}
.endpoint-mini {
  display: grid;
  gap: 4px;
  justify-items: end;
}
.endpoint-mini .ant-tag {
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
}
.compact-support .compatibility-row {
  grid-template-columns: 74px auto;
}
.compact-support .compatibility-row span:last-child {
  display: none;
}
.container-config-form {
  margin-top: 12px;
  display: grid;
  gap: 4px;
}
.container-config-form .ant-form-item {
  margin-bottom: 8px;
}
/* Inline container config row: port | mode | restart | save */
.container-config-inline {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  align-items: center;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid rgba(99,121,138,.14);
}
.config-inline-item {
  display: grid;
  grid-template-columns: 70px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
}
.container-config-inline .ant-btn { grid-column: 2; justify-self: start; }
.config-inline-item label {
  font-size: .72rem;
  color: #63798a;
  white-space: nowrap;
}
.theme-dark .config-inline-item label { color: #9bb4c3; }
.theme-dark .container-config-inline { border-top-color: rgba(74,190,255,.14); }
.settings-form-grid {
  display: grid;
  grid-template-columns: minmax(240px, 360px) minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}
.settings-summary {
  display: grid;
  gap: 10px;
}
.settings-summary span {
  color: #63798a;
  font-size: .86rem;
}
.settings-summary b {
  display: block;
  color: #1e3343;
  margin-top: 2px;
  overflow-wrap: anywhere;
}
.theme-dark .settings-summary span { color: #9bb4c3; }
.theme-dark .settings-summary b { color: #edf7fb; }
.settings-card-grid { grid-template-columns: repeat(2, minmax(320px, 1fr)); align-items: stretch; }
.settings-row-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.settings-block { min-width: 0; }
.settings-block > b { font-size: .88rem; color: #1e3343; }
.theme-dark .settings-block > b { color: #edf7fb; }
.settings-card { min-height: 100%; border-radius: 10px !important; box-shadow: 0 4px 16px rgba(18,45,63,.06); }
.settings-card .ant-card-body { height: calc(100% - 42px); display: flex; flex-direction: column; }
.theme-dark .settings-card { box-shadow: 0 6px 20px rgba(0,0,0,.2); }
.compact-settings-summary { gap: 8px; }
.compact-settings-controls { margin: 12px 0 0; }
.compact-plan-alert { margin-top: auto; }
.capability-settings-card { grid-column: 1 / -1; }
.capability-settings-card .ant-card-body { height: auto; }
.capability-settings-intro { margin: 0 0 12px; }
.capability-settings-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 12px;
}
.capability-setting-item {
  min-width: 0;
  border: 1px solid rgba(99, 121, 138, 0.16);
  border-radius: 8px;
  padding: 12px;
  background: rgba(255,255,255,.66);
}
.capability-setting-head {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  align-items: flex-start;
}
.capability-setting-head b {
  display: block;
  color: #1e3343;
  font-size: .9rem;
}
.capability-setting-head span {
  display: block;
  margin-top: 2px;
  color: #63798a;
  font-size: .74rem;
  font-family: var(--font-mono);
}
.capability-setting-item p {
  min-height: 42px;
  margin: 10px 0;
  color: #63798a;
  font-size: .82rem;
  line-height: 1.45;
}
.capability-setting-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 10px;
}
.capability-setting-metrics span {
  border-radius: 6px;
  background: rgba(10, 167, 216, 0.07);
  padding: 7px 8px;
  color: #63798a;
  font-size: .74rem;
}
.capability-setting-metrics b {
  display: block;
  margin-top: 1px;
  color: #1e3343;
  font-size: .98rem;
}
.capability-setting-actions { width: 100%; }
.theme-dark .capability-setting-item {
  border-color: rgba(74, 190, 255, 0.16);
  background: rgba(255,255,255,.035);
}
.theme-dark .capability-setting-head b,
.theme-dark .capability-setting-metrics b { color: #edf7fb; }
.theme-dark .capability-setting-head span,
.theme-dark .capability-setting-item p,
.theme-dark .capability-setting-metrics span { color: #9bb4c3; }
.theme-dark .capability-setting-metrics span { background: rgba(74, 190, 255, 0.08); }
@media (max-width: 1280px) { .capability-settings-grid { grid-template-columns: repeat(2, minmax(180px, 1fr)); } }
@media (max-width: 760px) { .capability-settings-grid, .settings-row-grid { grid-template-columns: 1fr; } }
.load .panel-stack, .deploy-grid.deploy-tuned, .task-grid {
  min-height: 0;
}
.deploy-grid.deploy-tuned {
  height: calc(100vh - 222px);
  overflow: hidden;
}
.deploy-column-card,
.deploy-column-card.glass-card,
.deploy-column-card > .ant-card,
.deploy-column-card .ant-card-body {
  min-height: 0;
}
.deploy-list {
  height: 100%;
  overflow: hidden;
}
.deploy-list .ant-card-body {
  max-height: none;
  height: calc(100vh - 304px);
  overflow-y: auto;
}
.deploy-center {
  height: 100%;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  overflow: hidden;
}
.deployment-info-short .ant-card-body {
  padding-bottom: 10px;
}
.deploy-log {
  overflow: hidden;
}
.deploy-log .ant-card-body {
  height: 100%;
}
.deploy-live-log {
  min-height: 0;
  max-height: none;
  height: 100%;
  overflow: auto;
}
.deploy-params {
  height: 100%;
  position: static;
  align-self: stretch;
  overflow: hidden;
}
.deploy-params > .ant-card {
  height: 100%;
}
.deploy-params .ant-card-body {
  height: calc(100vh - 304px);
  max-height: none;
  overflow-y: auto;
}
.task-grid {
  height: calc(100vh - 222px);
  overflow: hidden;
  align-items: stretch;
}
.task-grid > .ant-card,
.task-grid > .glass-card {
  min-height: 0;
  overflow: hidden;
}
.task-grid > .ant-card > .ant-card-body,
.task-grid > .glass-card > .ant-card-body {
  height: calc(100% - 42px);
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.task-list {
  min-height: 0;
  overflow-y: auto;
}
.task-list .ant-list-items {
  min-height: 0;
}
.task-grid .log-block {
  flex: 1;
  min-height: 0;
  max-height: none;
  overflow: auto;
}
@media (max-width: 1120px) {
  .deploy-grid.deploy-tuned,
  .task-grid {
    height: auto;
    overflow: visible;
  }
  .deploy-list .ant-card-body,
  .deploy-params .ant-card-body {
    height: auto;
    max-height: none;
  }
  .task-grid > .ant-card > .ant-card-body,
  .task-grid > .glass-card > .ant-card-body {
    height: auto;
    max-height: 70vh;
  }
  .settings-card-grid { grid-template-columns: repeat(2, minmax(220px, 1fr)); }
  .settings-form-grid {
    grid-template-columns: 1fr;
  }
}

/* ── Dashboard: device card scrolling ──────────────────────────────── */
.dashboard-device .ant-card-body {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

/* ── Dashboard: model-list strip anchored to bottom ────────────────── */
.model-list-drawer-strip {
  margin-top: auto !important;
}

/* ── Load Model Modal ──────────────────────────────────────────────── */
.load-model-modal-body { display: grid; gap: 12px; }
.load-model-current {
  display: flex; align-items: center; gap: 10px;
  min-height: 40px; margin-bottom: 12px; padding: 8px 12px;
  border-radius: 8px; font-size: .82rem;
  background: rgba(255, 255, 255, .92);
  border: 1px solid rgba(255, 255, 255, .92);
  box-shadow: inset 3px 0 0 #0aa7d8;
}
.load-model-current b {
  flex: none; color: #101820; font-size: .78rem; font-weight: 820;
}
.load-model-current-tag {
  display: inline-flex; align-items: center; min-width: 0; max-width: min(360px, 62%); height: 24px; padding: 0 10px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  color: #06131a !important; background: #ffffff; border: 1px solid rgba(6, 19, 26, .18);
  border-radius: 6px; font-family: var(--font-mono); font-size: .74rem; font-weight: 800; line-height: 24px;
}
.theme-dark .load-model-current {
  background: rgba(10, 167, 216, .12);
  border-color: rgba(103, 232, 249, .26);
  box-shadow: inset 3px 0 0 #67e8f9, 0 10px 22px rgba(0, 0, 0, .18);
}
.theme-dark .load-model-current b { color: #edf7fb; }
.theme-dark .load-model-current-tag {
  color: #dffbff !important; background: rgba(14, 116, 144, .58); border-color: rgba(103, 232, 249, .44);
}
:root[data-theme="dark"] .load-model-current {
  background: #0d1d29;
  border-color: rgba(74,190,255,.28);
  box-shadow: inset 3px 0 0 #4abfff;
}
:root[data-theme="dark"] .load-model-current b { color: #edf7fb; }
:root[data-theme="dark"] .load-model-current-tag {
  color: #dff7ff !important;
  background: rgba(10,167,216,.12);
  border-color: rgba(74,190,255,.32);
}
.load-model-sort { display: flex; align-items: center; gap: 10px; }
.load-model-sort > span { color: #63798a; font-size: .78rem; font-weight: 650; }
.theme-dark .load-model-sort > span { color: #9bb4c3; }
.load-model-table .ant-table-tbody > tr { cursor: pointer; }
.load-model-table .ant-table-tbody > tr:hover > td { background: rgba(10, 167, 216, 0.05); }
.theme-dark .load-model-table .ant-table-tbody > tr:hover > td { background: rgba(10, 167, 216, 0.08); }

/* ── Model library: compatibility guide table ──────────────────────── */
.compat-guide-table {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr);
  gap: 0;
  border: 1px solid rgba(10, 167, 216, 0.18);
  border-radius: 8px;
  overflow: hidden;
}
.compat-guide-header {
  display: contents;
  font-weight: 700;
  font-size: 0.82rem;
}
.compat-guide-header > span {
  padding: 10px 14px;
  background: rgba(10, 167, 216, 0.08);
  border-bottom: 2px solid rgba(10, 167, 216, 0.22);
  color: #1e3343;
}
.compat-guide-row { display: contents; font-size: 0.82rem; }
.compat-guide-row > span {
  padding: 10px 14px;
  border-bottom: 1px solid rgba(99, 121, 138, 0.1);
  display: flex;
  align-items: center;
}
.compat-guide-row:last-child > span { border-bottom: none; }
.compat-guide-row .format-cell {
  font-weight: 650;
  font-family: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace;
  font-size: 0.78rem;
}
.theme-dark .compat-guide-table { border-color: rgba(74, 190, 255, 0.24); }
.theme-dark .compat-guide-header > span {
  background: rgba(10, 167, 216, 0.12);
  color: #edf7fb;
}
.theme-dark .compat-guide-row > span { border-bottom-color: rgba(74, 190, 255, 0.12); }

/* ── Container management: page layout ─────────────────────────────── */
.services-split {
  display: block;
}
.preset-container-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: stretch;
  align-content: flex-start;
}
.preset-container-grid > .glass-card {
  width: 340px;
  flex-shrink: 0;
}
/* Custom container cards also get fixed width */
.preset-container-grid .compact-card.custom-container-card {
  width: 340px;
  flex-shrink: 0;
}

/* ── Container: dashed-border add-custom zone ──────────────────────── */
.services-add-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: stretch;
  justify-content: flex-end;
}
.add-custom-zone {
  width: 340px;
  flex-shrink: 0;
  border-radius: 8px;
  padding: 20px 24px;
  text-align: center;
  cursor: pointer;
  background: rgba(255,255,255,.95);
  border: 1px solid #d6e4ee;
  box-shadow: 0 8px 20px rgba(18,45,63,.055);
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  color: #63798a;
  font-size: 0.86rem;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.add-custom-zone:hover {
  border-color: #0aa7d8;
  background: rgba(10, 167, 216, 0.07);
  box-shadow: 0 0 16px rgba(10, 167, 216, 0.08);
}
.add-custom-zone .add-icon {
  font-size: 1.6rem;
  color: #0aa7d8;
  margin-bottom: 4px;
}
.add-custom-caption { font-size: .74rem; margin-top: 4px; opacity: .7; }
.theme-dark .add-custom-zone {
  border-color: rgba(74, 190, 255, 0.25);
  background: rgba(10, 167, 216, 0.04);
  color: #9bb4c3;
}
.theme-dark .add-custom-zone:hover {
  border-color: #4abeff;
  background: rgba(10, 167, 216, 0.1);
  box-shadow: 0 0 20px rgba(10, 167, 216, 0.12);
}

.compose-image-panel {
  display: grid;
  gap: 8px;
  margin-bottom: 10px;
}
.compose-image-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.compose-image-head strong {
  color: #17364f;
  font-size: 13px;
  font-weight: 820;
}
.compose-image-head span {
  color: #587085;
  font-size: 12px;
  font-weight: 740;
}
.compose-image-card {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid rgba(99,121,138,.16);
  border-radius: 8px;
  background: rgba(99,121,138,.08);
}
.compose-image-card b,
.compose-image-card span,
.compose-image-card small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.compose-image-card b {
  color: #17364f;
  font-size: 13px;
  line-height: 1.25;
  font-weight: 820;
}
.compose-image-card span {
  justify-self: end;
  max-width: 120px;
  padding: 2px 8px;
  border: 1px solid rgba(88,112,133,.18);
  border-radius: 999px;
  color: #2f5f78;
  background: rgba(255,255,255,.58);
  font-size: 12px;
  line-height: 1.35;
  font-weight: 780;
}
.compose-image-card small {
  color: #587085;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  line-height: 1.3;
  font-weight: 700;
}
.theme-dark .compose-image-head strong,
.theme-dark .compose-image-card b { color: #edf7fb; }
.theme-dark .compose-image-head span,
.theme-dark .compose-image-card small { color: #c6d3df; }
.theme-dark .compose-image-card span { color: #eaf7ff; background: rgba(74,190,255,.12); border-color: rgba(74,190,255,.24); }

.theme-dark .compose-image-card { border-color: rgba(74,190,255,.16); background: rgba(255,255,255,.045); }


.runtime-compose-panel {
  display: grid;
  gap: 12px;
  margin: 12px 0;
}
.runtime-compose-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
.runtime-compose-grid label {
  min-width: 0;
  display: grid;
  gap: 6px;
  color: #587085;
  font-size: 12px;
  font-weight: 760;
}
.runtime-compose-grid .ant-input-number,
.runtime-compose-grid .ant-select {
  width: 100%;
}
.runtime-compose-readonly-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}
.runtime-compose-readonly-grid span,
.runtime-compose-mount-grid span {
  min-width: 0;
  display: grid;
  gap: 4px;
  padding: 9px 10px;
  border: 1px solid rgba(99,121,138,.16);
  border-radius: 8px;
  background: rgba(99,121,138,.07);
  color: #587085;
  font-size: 11px;
  font-weight: 760;
}
.runtime-compose-readonly-grid b,
.runtime-compose-mount-grid b,
.runtime-compose-mount-grid small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.runtime-compose-readonly-grid b,
.runtime-compose-mount-grid b {
  color: #17364f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  font-weight: 780;
}
.runtime-compose-mounts {
  display: grid;
  gap: 8px;
}
.runtime-compose-mounts > strong {
  color: #17364f;
  font-size: 13px;
  font-weight: 800;
}
.runtime-compose-mount-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}
.runtime-compose-mount-grid small,
.runtime-compose-empty {
  color: #587085;
  font-size: 11px;
  font-weight: 680;
}
.compose-advanced-block {
  margin-top: 12px;
  border-top: 1px solid rgba(99,121,138,.14);
  padding-top: 10px;
}
.compose-advanced-block summary {
  cursor: pointer;
  color: #2f5f78;
  font-size: 12px;
  font-weight: 820;
}
.compose-advanced-block .ant-form-item {
  margin-top: 10px;
}
.runtime-compose-actions {
  margin-top: 12px;
}
.theme-dark .runtime-compose-grid label,
.theme-dark .runtime-compose-mount-grid small,
.theme-dark .runtime-compose-empty { color: #c6d3df; }
.theme-dark .runtime-compose-readonly-grid span,
.theme-dark .runtime-compose-mount-grid span {
  border-color: rgba(74,190,255,.16);
  background: rgba(255,255,255,.045);
  color: #c6d3df;
}
.theme-dark .runtime-compose-readonly-grid b,
.theme-dark .runtime-compose-mount-grid b,
.theme-dark .runtime-compose-mounts > strong { color: #edf7fb; }
.theme-dark .compose-advanced-block { border-top-color: rgba(74,190,255,.12); }
.theme-dark .compose-advanced-block summary { color: #eaf7ff; }
@media (max-width: 760px) {
  .runtime-compose-grid,
  .runtime-compose-readonly-grid,
  .runtime-compose-mount-grid { grid-template-columns: 1fr; }
  .runtime-compose-actions { flex-wrap: wrap; }
  .runtime-compose-actions .ant-btn { flex: 1 1 auto; }
}

/* ── Container: compose YAML editor ────────────────────────────────── */
.compose-editor {
  font-family: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace;
  font-size: 0.82rem;
  line-height: 1.5;
}



/* ── Container: Dockerfile image editor ─────────────────────────────── */
.dockerfile-editor-shell {
  display: grid;
  gap: 12px;
}
.dockerfile-empty-state {
  padding: 18px;
  border: 1px dashed rgba(99,121,138,.28);
  border-radius: 8px;
  color: #587085;
  background: rgba(99,121,138,.06);
  font-size: 13px;
  font-weight: 720;
}
.dockerfile-editor-meta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 8px;
}
.dockerfile-editor-meta span {
  min-width: 0;
  display: grid;
  gap: 4px;
  padding: 9px 10px;
  border: 1px solid rgba(99,121,138,.16);
  border-radius: 8px;
  background: rgba(99,121,138,.08);
  color: #587085;
  font-size: 11px;
  font-weight: 760;
}
.dockerfile-editor-meta b {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #17364f;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  font-weight: 780;
}
.dockerfile-editor {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.5;
  tab-size: 2;
}
.dockerfile-editor textarea {
  min-height: 420px;
}
.dockerfile-editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}
.theme-dark .dockerfile-editor-meta span {
  border-color: rgba(74,190,255,.16);
  background: rgba(255,255,255,.045);
  color: #c6d3df;
}
.theme-dark .dockerfile-editor-meta b { color: #edf7fb; }
@media (max-width: 760px) {
  .dockerfile-editor-meta { grid-template-columns: 1fr; }
  .dockerfile-editor-actions { flex-wrap: wrap; }
  .dockerfile-editor-actions .ant-btn { flex: 1 1 auto; }
}

/* ── Container: validation result ──────────────────────────────────── */
.validation-result {
  margin-top: 8px;
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 0.82rem;
  font-family: 'JetBrains Mono', monospace;
  white-space: pre-wrap;
}
.validation-result.success {
  background: rgba(82, 196, 26, 0.08);
  border: 1px solid rgba(82, 196, 26, 0.25);
  color: #389e0d;
}
.validation-result.error {
  background: rgba(255, 77, 79, 0.08);
  border: 1px solid rgba(255, 77, 79, 0.25);
  color: #cf1322;
}
.theme-dark .validation-result.success {
  background: rgba(82, 196, 26, 0.12);
  color: #95de64;
}
.theme-dark .validation-result.error {
  background: rgba(255, 77, 79, 0.12);
  color: #ff7875;
}

/* ── Container: action row with top border ─────────────────────────── */
.container-action-row {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
  padding-top: 10px;
  border-top: 1px solid rgba(99, 121, 138, 0.14);
}
.theme-dark .container-action-row {
  border-top-color: rgba(74, 190, 255, 0.14);
}

/* ── Font variable ─────────────────────────────────────────────────── */
:root {
  --font-mono: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
}

/* ── Custom Gauge Ring ────────────────────────────────────────────── */
.gauge-ring {
  display: inline-grid;
  place-items: center;
  width: 90px;
  height: 90px;
  position: relative;
}
.gauge-ring svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.gauge-ring .gauge-bg {
  fill: none;
  stroke: rgba(99, 121, 138, 0.14);
  stroke-width: 6;
}
.gauge-ring .gauge-fill {
  fill: none;
  stroke: #0aa7d8;
  stroke-width: 6;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.6s ease;
}
.theme-dark .gauge-ring .gauge-bg { stroke: rgba(255, 255, 255, 0.08); }
.theme-dark .gauge-ring .gauge-fill { stroke: #67e8f9; }
.gauge-inner {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 2px;
  text-align: center;
}
.gauge-inner strong {
  font-size: 1.25rem;
  font-weight: 760;
  color: #1e3343;
  line-height: 1;
}
.gauge-inner small {
  font-size: .68rem;
  color: #63798a;
  line-height: 1;
}
.theme-dark .gauge-inner strong { color: #edf7fb; }
.theme-dark .gauge-inner small { color: #9bb4c3; }

/* ── Models page: split layout with right log panel ────────────────── */
.models-split-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 14px;
  height: calc(100vh - 222px);
  min-height: 0;
  overflow: hidden;
}
.models-main-col {
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-right: 2px;
}
.models-card-grid {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  align-content: start;
}
/* Guide card pinned to bottom of left column */
.models-guide-bottom {
  margin-top: auto;
  flex-shrink: 0;
}
.models-guide-bottom .ant-card-body { padding: 8px 14px; }
.models-guide-bottom .compat-guide-table { border: none; }
.models-guide-bottom .compat-guide-row > span { padding: 5px 8px; }
/* Right log panel: full height with top/bottom split */
.models-log-col {
  min-height: 0;
  height: 100%;
  display: grid;
  grid-template-rows: minmax(180px, 34%) minmax(0, 1fr);
  gap: 12px;
  overflow: hidden;
}
.models-log-top { min-height: 0; overflow: hidden; }
.models-log-top .ant-card-body { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.models-log-bottom { min-height: 0; overflow: hidden; }
.models-log-bottom .ant-card-body { display: flex; flex-direction: column; min-height: 0; height: 100%; overflow: hidden; }
.models-log-card {
  min-height: 0;
}
.models-log-card .ant-card-body {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  padding: 10px 12px;
}
.models-task-list {
  flex: 1;
  min-height: 0;
  min-width: 0;
  overflow-y: auto;
}
.models-task-list .ant-list-item { padding: 6px 8px !important; }
.models-task-list .ant-list-item-meta-title { font-size: .82rem !important; }
.models-task-list .ant-list-item-meta-description { font-size: .72rem !important; }
.models-task-list .ant-list-item {
  cursor: pointer;
  padding: 8px 10px;
  border-radius: 6px;
}
.models-log-block {
  flex: 1;
  min-height: 0;
  max-height: none;
  overflow: auto;
}

@media (max-width: 1120px) {
  .models-split-layout {
    grid-template-columns: 1fr;
    height: auto;
    overflow: visible;
  }
  .models-log-col {
    height: auto;
    max-height: 50vh;
    order: 10;
  }
  .models-log-top { max-height: 220px; }
}

.models-task-progress { width: 76px; flex: 0 0 76px; }
.task-control-buttons { flex: 0 0 auto; margin-left: 4px; }
.task-control-buttons .ant-btn, .task-action-icon-button {
  width: 26px; min-width: 26px; height: 26px;
  padding-inline: 0; display: inline-flex; align-items: center; justify-content: center;
}
.task-action-icon-button .anticon { font-size: 13px; }
@media (max-width: 1320px) {
  .models-task-progress { width: 64px; flex-basis: 64px; }
  .task-control-buttons { gap: 3px !important; }
}

.event-log-block {
  font-size: .86rem;
  line-height: 1.8;
}
.task-page-controls {
  margin-left: 2px;
}
.task-list .ant-list-item {
  align-items: center;
}
.task-list .ant-list-item-meta {
  min-width: 0;
}
.task-list .ant-list-item-meta-description {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-format-tag {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-inline-end: 0;
  padding: 0 10px;
  white-space: nowrap;
}

.task-events-card .ant-card-body {
  overflow: hidden;
}
.task-event-timeline {
  height: 100%;
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 2px 4px 2px 2px;
}
.task-event-line {
  display: grid;
  width: 100%;
  grid-template-columns: 10px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  padding: 7px 8px;
  border-radius: 8px;
  background: rgba(10, 167, 216, .055);
  color: #294253;
  font-size: .82rem;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.task-event-dot {
  width: 7px;
  height: 7px;
  margin-top: 6px;
  border-radius: 999px;
  background: #0aa7d8;
  box-shadow: 0 0 0 3px rgba(10, 167, 216, .14);
}
.theme-dark .task-event-line {
  background: rgba(10, 167, 216, .1);
  color: #d8eef8;
}
.theme-dark .task-event-dot {
  background: #67e8f9;
}

.task-description { display: grid; gap: 6px; min-width: 0; }
.task-title-line { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; min-width: 0; }
.task-title-line strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-primary); }
.task-title-line time { flex: none; color: var(--text-tertiary); font-family: var(--font-mono); font-size: .68rem; font-weight: 500; }
.task-plan-stages { min-width: 0; }
.task-plan-stages .ant-tag { margin-inline-end: 0; font-size: .68rem; line-height: 18px; }

.task-event-block {
  white-space: pre-wrap; margin-bottom: 10px; font-family: var(--font-mono);
  background: rgba(20, 184, 166, .08); max-height: 140px; overflow: auto;
}
.task-log-tail {
  contain: content; overscroll-behavior: contain;
  font-family: var(--font-mono); font-size: .76rem; line-height: 1.5;
}

.deployment-plan-preview { margin-top: 12px; display: grid; gap: 8px; padding-top: 10px; border-top: 1px solid rgba(99, 121, 138, .14); }
.plan-preview-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.plan-preview-kv { margin-top: 0; }
.plan-preview-command { max-height: 96px; overflow: auto; font-size: .72rem; }
.theme-dark .deployment-plan-preview { border-top-color: rgba(74, 190, 255, .14); }
.home-flow { grid-template-rows: auto auto minmax(0, 1fr); }
.home-action-card .ant-card-body { padding: 18px 20px; }
.home-action-main { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.home-action-main h2 { margin: 10px 0 6px; font-size: 1.35rem; line-height: 1.25; }
.home-stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.home-stat { min-height: 82px; display: grid; align-content: center; gap: 6px; }
.home-stat span { color: #63798a; font-size: .78rem; }
.home-stat b { font-size: 1.8rem; line-height: 1; color: #163247; }
.home-stat strong { font-size: .92rem; line-height: 1.25; color: #163247; overflow-wrap: anywhere; }
.theme-dark .home-stat span { color: #9bb4c3; }
.theme-dark .home-stat b, .theme-dark .home-stat strong { color: #edf7fb; }
.home-two-col { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr); gap: 12px; min-height: 0; }
.running-grid { grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); align-items: start; }
.running-card .deploy-kv-grid span { white-space: normal; }
@media (max-width: 980px) {
  .home-action-main { align-items: flex-start; flex-direction: column; }
  .home-stat-grid, .home-two-col { grid-template-columns: 1fr; }
}
.models-filter-card .ant-card-body { padding: 10px 14px; }
.models-filter-grid { display: grid; grid-template-columns: minmax(220px, 1fr) repeat(4, minmax(130px, 170px)); gap: 10px; align-items: center; }
.model-chip-row { margin: 4px 0 10px; }
.drawer-section { display: grid; gap: 8px; margin-top: 16px; }
.drawer-section > b { color: #1e3343; }
.theme-dark .drawer-section > b { color: #edf7fb; }
.drawer-actions { margin-top: 18px; }
.load-wizard-header { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.wizard-step { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(99,121,138,.16); background: rgba(255,255,255,.72); color: #63798a; }
.wizard-step b { width: 24px; height: 24px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: rgba(99,121,138,.14); color: #294253; }
.wizard-step.active { border-color: rgba(10,167,216,.42); background: rgba(10,167,216,.08); color: #163247; }
.wizard-step.active b { background: #0aa7d8; color: #fff; }
.theme-dark .wizard-step { background: rgba(13,24,34,.7); border-color: rgba(74,190,255,.16); color: #9bb4c3; }
.theme-dark .wizard-step b { background: rgba(74,190,255,.16); color: #d8eef8; }
.theme-dark .wizard-step.active { background: rgba(10,167,216,.12); border-color: rgba(74,190,255,.38); color: #edf7fb; }
.publish-summary { display: grid; grid-template-columns: 1fr; gap: 8px; margin-bottom: 10px; padding: 10px 12px; border-radius: 8px; background: rgba(10,167,216,.07); }
.publish-summary span { color: #63798a; font-size: .78rem; overflow-wrap: anywhere; }
.publish-summary b { display: block; margin-top: 2px; color: #1e3343; font-size: .84rem; }
.theme-dark .publish-summary { background: rgba(10,167,216,.12); }
.theme-dark .publish-summary span { color: #9bb4c3; }
.theme-dark .publish-summary b { color: #edf7fb; }
.advanced-collapse { margin: 4px 0 12px; border: 1px solid rgba(99,121,138,.14); border-radius: 8px; }
.advanced-collapse .ant-collapse-header { padding: 8px 10px !important; }
.advanced-collapse .ant-collapse-content-box { padding: 0 10px 8px !important; }
.theme-dark .advanced-collapse { border-color: rgba(74,190,255,.14); }
@media (max-width: 1280px) { .models-filter-grid { grid-template-columns: minmax(220px, 1fr) repeat(2, minmax(130px, 1fr)); } }
@media (max-width: 760px) { .models-filter-grid, .load-wizard-header { grid-template-columns: 1fr; } }
.running-log-card { grid-column: 1 / -1; }
.running-log-block { max-height: 320px; overflow: auto; }
.diagnostics-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 12px; }
.diagnostic-card .ant-card-body { min-height: 104px; display: grid; align-content: center; gap: 5px; }
.diagnostic-card span { color: #63798a; font-size: .78rem; }
.diagnostic-card b { color: #163247; font-size: 1rem; line-height: 1.25; overflow-wrap: anywhere; }
.diagnostic-card small { color: #63798a; overflow-wrap: anywhere; }
.theme-dark .diagnostic-card span, .theme-dark .diagnostic-card small { color: #9bb4c3; }
.theme-dark .diagnostic-card b { color: #edf7fb; }
.diagnostics-detail-grid { display: grid; grid-template-columns: minmax(320px, .9fr) minmax(360px, 1.1fr); gap: 12px; margin-bottom: 12px; }
.diagnostics-resource-grid { grid-template-columns: repeat(3, minmax(92px, 1fr)); }
.section-label { margin: 4px 0 8px; color: #63798a; font-size: .78rem; font-weight: 700; text-transform: uppercase; }
.theme-dark .section-label { color: #9bb4c3; }
@media (max-width: 1180px) { .diagnostics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .diagnostics-detail-grid { grid-template-columns: 1fr; } }
@media (max-width: 680px) { .diagnostics-grid { grid-template-columns: 1fr; } }
.task-failed-row { border-left: 3px solid #ff4d4f; }
.theme-dark .task-failed-row { border-left-color: #ff7875; }

/* Tasks: list item spacing */
.tasks-layout .task-list .ant-list-item {
  padding: 12px 12px 12px 14px !important;
  margin-bottom: 10px;
  border-radius: 12px !important;
  cursor: pointer;
}

/* Tasks: banner layout */
.tasks-layout .taskBanner {
  position: relative; min-height: 120px; display: flex; align-items: center;
  padding: 18px 22px; overflow: hidden; border-radius: 14px;
}
.tasks-layout .taskBanner::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 75% 35%, rgba(10,167,216,.13), transparent 24%),
              radial-gradient(circle at 85% 72%, rgba(130,82,241,.14), transparent 30%);
}
.tasks-layout .taskBanner > div { position: relative; z-index: 1; }
.tasks-layout .taskBanner > div span:first-child { font-size: 11px; font-weight: 700; letter-spacing: .08em; }
.tasks-layout .taskBanner h1 { margin: 6px 0 8px; font-size: 28px; line-height: 1; }
.tasks-layout .taskBanner p { max-width: 460px; margin: 0; font-size: 12px; }

/* Tasks: overview cards layout */
.tasks-layout .task-overview .ant-card { border-radius: 14px !important; }
.missing-file-list { display: flex; flex-wrap: wrap; gap: 6px; }
.missing-file-list .ant-tag { max-width: 100%; white-space: normal; overflow-wrap: anywhere; margin-inline-end: 0; }
.drawer-task-item { cursor: pointer; border-radius: 6px; padding-inline: 8px !important; }
.drawer-task-item:hover { background: rgba(10,167,216,.06); }
.theme-dark .drawer-task-item:hover { background: rgba(10,167,216,.12); }
.task-overview { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.task-stat-card .ant-card-body { min-height: 72px; display: grid; align-content: center; gap: 4px; }
.task-stat-card span { color: #63798a; font-size: .78rem; }
.task-stat-card b { color: #163247; font-size: 1.55rem; line-height: 1; }
.theme-dark .task-stat-card span { color: #9bb4c3; }
.theme-dark .task-stat-card b { color: #edf7fb; }
@media (max-width: 820px) { .task-overview { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.models-filter-grid { grid-template-columns: minmax(220px, 1fr) repeat(4, minmax(130px, 170px)) auto; }
.models-filter-summary { justify-content: flex-end; white-space: nowrap; }
@media (max-width: 1280px) { .models-filter-grid { grid-template-columns: minmax(220px, 1fr) repeat(2, minmax(130px, 1fr)); } .models-filter-summary { justify-content: flex-start; } }
.publish-readiness { gap: 10px; }
.publish-summary-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.publish-summary-head > span { color: #1e3343; font-weight: 700; font-size: .86rem; }
.publish-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 10px; }
.publish-capability-row { margin-top: 2px; }
.publish-summary-note { margin: 0; color: #63798a; font-size: .78rem; line-height: 1.55; }
.theme-dark .publish-summary-head > span { color: #edf7fb; }
.theme-dark .publish-summary-note { color: #9bb4c3; }
@media (max-width: 760px) { .publish-summary-grid { grid-template-columns: 1fr; } }
.task-detail-card .ant-card-body { display: flex; flex-direction: column; min-height: 0; }
.task-diagnostic-panel { display: grid; gap: 8px; margin-bottom: 10px; padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(255, 77, 79, .22); background: rgba(255, 77, 79, .06); }
.task-diagnostic-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.task-diagnostic-head b { color: #a8071a; }
.task-diagnostic-panel p { margin: 0; color: #294253; line-height: 1.55; overflow-wrap: anywhere; }
.task-diagnostic-actions { margin-top: 2px; }
.theme-dark .task-diagnostic-panel { border-color: rgba(255, 120, 117, .26); background: rgba(255, 77, 79, .12); }
.theme-dark .task-diagnostic-head b { color: #ff9995; }
.theme-dark .task-diagnostic-panel p { color: #d8eef8; }
.diagnostics-workbench-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 12px; }
.diagnostics-info-card .ant-card-body { display: grid; gap: 12px; }
.diagnostics-kv-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 10px; }
.diagnostics-kv-list span { min-width: 0; color: #63798a; font-size: .78rem; overflow-wrap: anywhere; }
.diagnostics-kv-list b { display: block; margin-top: 3px; color: #163247; font-size: .86rem; line-height: 1.35; overflow-wrap: anywhere; }
.diagnostics-card-actions { padding-top: 2px; }
.diagnostics-log-card { margin-bottom: 12px; }
.theme-dark .diagnostics-kv-list span { color: #9bb4c3; }
.theme-dark .diagnostics-kv-list b { color: #edf7fb; }
@media (max-width: 980px) { .diagnostics-workbench-grid { grid-template-columns: 1fr; } }
@media (max-width: 680px) { .diagnostics-kv-list { grid-template-columns: 1fr; } }
.task-next-step-panel { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; padding: 10px 12px; border-radius: 8px; background: rgba(10, 167, 216, .07); border: 1px solid rgba(10, 167, 216, .16); }
.task-next-step-panel > div { display: grid; min-width: 0; gap: 2px; }
.task-next-step-panel b { color: #163247; font-size: .86rem; }
.task-next-step-panel span { color: #63798a; font-size: .78rem; overflow-wrap: anywhere; }
.theme-dark .task-next-step-panel { background: rgba(10, 167, 216, .12); border-color: rgba(74, 190, 255, .2); }
.theme-dark .task-next-step-panel b { color: #edf7fb; }
.theme-dark .task-next-step-panel span { color: #9bb4c3; }
@media (max-width: 760px) { .task-next-step-panel { align-items: stretch; flex-direction: column; } }
/* Playground readability pass: center output + right params panel. */
.playground-layout { align-items: stretch; gap: 0; }
.playground-action-row { padding-top: 2px; }
.playground-action-row .ant-btn { min-width: 0; }
.playground-image-preview {
  width: 100%;
  height: 148px;
  margin: -2px 0 12px;
  border-radius: 8px;
  border: 1px solid rgba(99,121,138,.14);
  background: rgba(247,250,252,.9);
  overflow: hidden;
}
.playground-image-preview img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
.theme-dark .playground-image-preview {
  border-color: rgba(74,190,255,.14);
  background: rgba(8,16,24,.72);
}
.audio-template-panel { display: grid; gap: 2px; }
.audio-template-note { display: grid; gap: 7px; margin-bottom: 4px; }
.audio-template-note p { margin: 0; color: #63798a; line-height: 1.5; }
.audio-template-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 4px; }
.audio-template-card {
  min-width: 0;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid rgba(99,121,138,.16);
  background: rgba(255,255,255,.72);
  color: inherit;
  text-align: left;
  cursor: pointer;
}
.audio-template-card:hover { border-color: rgba(10,167,216,.45); background: rgba(10,167,216,.07); }
.audio-template-card b { display: block; color: #1e3343; font-size: .82rem; margin-bottom: 4px; }
.audio-template-card span { display: block; color: #63798a; font-size: .72rem; line-height: 1.35; }
.theme-dark .audio-template-note p,
.theme-dark .audio-template-card span { color: #9bb4c3; }
.theme-dark .audio-template-card { border-color: rgba(74,190,255,.16); background: rgba(255,255,255,.035); }
.theme-dark .audio-template-card:hover { border-color: rgba(74,190,255,.38); background: rgba(10,167,216,.11); }
.theme-dark .audio-template-card b { color: #edf7fb; }
@media (max-width: 680px) { .audio-template-grid, .model-facts-clean { grid-template-columns: 1fr; } }
.playground-output-card .ant-card-body { min-height: 100%; padding: 16px 18px; }
.playground-output-card .ant-card-head { min-height: 44px; }
.playground-output-card .ant-card-head-title { font-size: .92rem; }
.playground-metrics { margin-bottom: 8px; }
/* ── 消息列表 ─────────────────────────────── */
.playground-message-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 0;
}
.playground-empty-chat {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200px;
  color: #63798a;
  font-size: .9rem;
}
/* ── 聊天气泡 ─────────────────────────────── */
.playground-chat-bubble {
  display: flex;
  gap: 10px;
  max-width: 85%;
  animation: msgFadeIn .2s ease;
}
.playground-chat-bubble.user { align-self: flex-end; flex-direction: row-reverse; }
.playground-chat-bubble.assistant { align-self: flex-start; }
.playground-chat-bubble.error { align-self: center; max-width: 92%; }
@keyframes msgFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.playground-bubble-avatar {
  width: 36px; height: 36px; border-radius: 50%; background: rgba(10,167,216,.12);
  display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
  flex-shrink: 0; margin-top: 2px;
}
.playground-chat-bubble.user .playground-bubble-avatar { background: rgba(10,167,216,.2); }
.playground-chat-bubble.error .playground-bubble-avatar { background: rgba(255,77,79,.15); }
.playground-bubble-body { min-width: 0; display: grid; gap: 4px; }
.playground-chat-bubble.user .playground-bubble-body { justify-items: end; }
.playground-bubble-role {
  font-size: .72rem; color: #63798a; font-weight: 700;
  padding: 0 2px;
}
.playground-bubble-content {
  background: #f0f4f8; border-radius: 12px; padding: 10px 14px;
  border: 1px solid rgba(99,121,138,.1);
  font-size: .85rem; line-height: 1.55; color: #1a2b3c;
  white-space: pre-wrap; word-break: break-word; max-width: 100%;
}
.playground-chat-bubble.user .playground-bubble-content {
  background: rgba(10,167,216,.12); border-color: rgba(10,167,216,.2);
}
.playground-chat-bubble.error .playground-bubble-content {
  background: rgba(255,77,79,.08); border-color: rgba(255,77,79,.2);
  color: #a61d24;
}
.playground-bubble-content pre {
  margin: 0; padding: 0; border: none; background: transparent;
  font: inherit; white-space: pre-wrap;
}
.playground-bubble-time {
  font-size: .66rem; color: #94a6b8; padding: 0 2px;
}
/* ── 打字指示器 ──────────────────────────── */
.playground-typing-indicator { display: inline-flex; gap: 4px; padding: 4px 0; }
.playground-typing-indicator i {
  width: 6px; height: 6px; border-radius: 50%; background: #94a6b8;
  animation: typingBounce 1.4s infinite;
}
.playground-typing-indicator i:nth-child(2) { animation-delay: .2s; }
.playground-typing-indicator i:nth-child(3) { animation-delay: .4s; }
@keyframes typingBounce { 0%,60%,100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
/* ── 指标栏 ──────────────────────────────── */
.playground-metrics-bar {
  padding: 8px 18px; display: flex; gap: 6px; flex-wrap: wrap;
  border-top: 1px solid rgba(99,121,138,.08);
}
/* ── 图片预览 ────────────────────────────── */
.playground-image-preview {
  margin-bottom: 8px; border-radius: 8px; overflow: hidden;
  border: 1px solid rgba(99,121,138,.12);
}
.playground-image-preview img { max-width: 240px; max-height: 180px; display: block; }
/* ── 暗色主题 ────────────────────────────── */
.theme-dark .playground-bubble-content { background: rgba(8,16,24,.84); border-color: rgba(74,190,255,.1); color: #d6e8f5; }
.theme-dark .playground-chat-bubble.user .playground-bubble-content { background: rgba(10,167,216,.14); border-color: rgba(74,190,255,.16); }
.theme-dark .playground-chat-bubble.error .playground-bubble-content { background: rgba(255,77,79,.12); border-color: rgba(255,77,79,.2); color: #ff7875; }
.theme-dark .playground-empty-chat { color: #688296; }
@media (max-width: 680px) { .playground-chat-bubble { max-width: 92%; } .playground-message-list { padding: 12px; } }

@media (max-width: 760px) {
  .shell-titlebar { grid-template-columns: 40px minmax(0, 1fr) 82px; }
  .shell-toolbar { grid-template-columns: 44px minmax(0, 1fr); }
  .shell-toolbar-right { grid-column: 1 / -1; min-height: 42px; border-left: 0; border-top: 1px solid rgba(92,132,154,.18); justify-content: center; }
  .workspace { height: calc(100vh - 117px); }
}


/* Prototype strict layout pass: mirror stack.zip page geometry while keeping live Vue data. */
.workspace { height: 100%; overflow: hidden; }
.prototype-page {
  height: 100%;
  min-height: 0;
  overflow: auto;
  padding: 14px 16px;
  gap: 14px;
}
.prototype-banner {
  position: relative;
  min-height: 120px;
  overflow: hidden;
  border-radius: 8px;
  border: 1px solid rgba(10,167,216,.2);
  background: linear-gradient(90deg, rgba(10,167,216,.13), rgba(10,167,216,.03));
  box-shadow: 0 8px 20px rgba(18,45,63,.055);
}
.prototype-banner > div,
.prototype-banner .home-action-main { position: relative; z-index: 1; }
.prototype-banner > div { padding: 18px 22px; }
.prototype-banner span:first-child,
.prototype-banner p:first-child { color: #0076a3; font-weight: 800; font-size: .72rem; text-transform: uppercase; }
.prototype-banner h1 { margin: 4px 0 8px; font-size: 1.68rem; line-height: 1.1; }
.prototype-banner p { margin: 0; max-width: 680px; color: #526b7b; }
.prototype-banner::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 76% 34%, rgba(74,190,255,.18), transparent 22%), radial-gradient(circle at 88% 70%, rgba(10,167,216,.16), transparent 28%);
}
.prototype-banner::after {
  content: "";
  position: absolute;
  right: 24px;
  top: 50%;
  transform: translateY(-50%);
  width: 160px;
  height: 80px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(10,167,216,.08) 0%, transparent 70%);
  pointer-events: none;
}
.theme-dark .prototype-banner::after {
  background: radial-gradient(circle, rgba(74,190,255,.1) 0%, transparent 70%);
}

/* Banner decor dots pattern */
.home-action-card.prototype-banner::after {
  right: 60px;
  width: 200px;
  height: 100px;
  background:
    radial-gradient(circle at 30% 40%, rgba(10,167,216,.12) 2px, transparent 2px),
    radial-gradient(circle at 60% 60%, rgba(10,167,216,.1) 3px, transparent 3px),
    radial-gradient(circle at 85% 30%, rgba(10,167,216,.14) 2px, transparent 2px),
    radial-gradient(circle, rgba(10,167,216,.06) 0%, transparent 70%);
}
.theme-dark .home-action-card.prototype-banner::after {
  background:
    radial-gradient(circle at 30% 40%, rgba(74,190,255,.14) 2px, transparent 2px),
    radial-gradient(circle at 60% 60%, rgba(74,190,255,.12) 3px, transparent 3px),
    radial-gradient(circle at 85% 30%, rgba(74,190,255,.16) 2px, transparent 2px),
    radial-gradient(circle, rgba(74,190,255,.08) 0%, transparent 70%);
}
.prototype-banner-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .42; }
.theme-dark .prototype-banner { border-color: rgba(74,190,255,.22); background: linear-gradient(90deg, rgba(10,167,216,.16), rgba(13,24,34,.88)); }
.theme-dark .prototype-banner span:first-child,
.theme-dark .prototype-banner p:first-child { color: #67e8f9; }
.theme-dark .prototype-banner p { color: #bdd4df; }

.dashboard-layout {
  display: grid;
  grid-template-columns: minmax(760px, 1fr) 360px;
  grid-template-rows: 120px auto minmax(0, 1fr);
  grid-template-areas:
    "banner side"
    "stats side"
    "main side";
}
.dashboard-layout .home-action-card { grid-area: banner; min-height: 120px; }
.dashboard-layout .home-action-card .ant-card-body { height: 100%; padding: 18px 22px; }
.dashboard-layout .home-stat-grid { grid-area: stats; grid-template-columns: repeat(4, minmax(120px, 1fr)); }
.dashboard-layout .home-two-col { grid-area: main; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
.dashboard-layout .home-two-col > .glass-card:first-child { min-height: 0; overflow: hidden; }
.dashboard-layout .home-two-col > .glass-card:last-child { grid-area: side; }
.dashboard-layout > .home-two-col > .glass-card:last-child {
  position: absolute;
  right: 18px;
  top: 18px;
  bottom: 18px;
  width: 360px;
  overflow: hidden;
}
.dashboard-layout .home-two-col > .glass-card:last-child .ant-card-body { height: calc(100% - 44px); overflow: auto; }

.model-library-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  grid-template-rows: 120px minmax(0, 1fr);
  grid-template-areas: "banner side" "main side";
}
.model-library-layout.right-panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas: "banner" "main";
}
.model-library-layout .prototype-banner { grid-area: banner; }
.model-library-layout .models-main-col { grid-area: main; min-height: 0; overflow: auto; padding-right: 2px; }
.model-library-layout .models-log-col { grid-area: side; min-height: 0; overflow: hidden; display: grid; grid-template-rows: 1fr 1fr; gap: 14px; }
.model-library-layout .models-log-card .ant-card-body { height: calc(100% - 44px); overflow: auto; }
.model-library-layout .models-card-grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

.chat-test-layout {
  display: grid;
  grid-template-columns: 260px minmax(520px, 1fr) 360px;
  grid-template-rows: 120px minmax(0, 1fr);
  grid-template-areas: "chat banner side" "chat main side";
  padding: 0;
  gap: 0;
}
.chat-test-layout.right-panel-collapsed {
  grid-template-columns: 260px minmax(0, 1fr);
  grid-template-areas: "chat banner" "chat main";
}
.chat-test-layout .prototype-chat-list {
  grid-area: chat;
  min-height: 0;
  padding: 10px 8px;
  border-right: 1px solid rgba(92,132,154,.18);
  background: linear-gradient(180deg, rgba(255,255,255,.24), rgba(255,255,255,.14));
}
.prototype-chat-list .chatPanelHeader { display: flex; justify-content: space-between; align-items: center; height: 38px; }
.prototype-chat-list h1 { margin: 0; font-size: 13px; font-weight: 800; }
.chatPanelTools { display: inline-flex; align-items: center; gap: 6px; }
.chatPanelIcon {
  width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #63798a;
  font-size: 14px;
  cursor: pointer;
}
.chatPanelIcon:hover {
  background: rgba(10,167,216,.1);
  color: #006b95;
}
.playgroundSearchWrap { margin: 8px 0 10px; }
.playgroundSearchWrap .ant-input-affix-wrapper {
  border-radius: 10px;
  border-color: rgba(92,132,154,.12);
  background: rgba(255,255,255,.56);
}
.playgroundChatSection {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.playgroundChatSection span { color: #4f6275; font-size: .74rem; font-weight: 700; }
.prototype-chat-list .chatList { display: grid; gap: 6px; margin-top: 6px; overflow: auto; }
.prototype-chat-list .chatItem {
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  border-radius: 8px;
  padding: 9px 10px;
  cursor: pointer;
  display: grid;
  gap: 4px;
}
.chatItemTitle {
  display: block;
  font-size: .79rem;
  font-weight: 700;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.chatItemMeta {
  display: block;
  font-size: .68rem;
  color: #63798a;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.prototype-chat-list .chatItem:hover,
.prototype-chat-list .chatItem.isSelected { background: rgba(10,167,216,.12); }
.playgroundModelList {
  display: grid;
  align-content: start;
  gap: 10px;
  padding-bottom: 14px;
}
.playgroundModelGroup {
  display: grid;
  gap: 3px;
}
.playgroundModelGroupHead {
  min-height: 24px;
  padding: 2px 8px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #63798a;
  font-size: 11px;
  font-weight: 700;
}
.playgroundModelGroupHead b {
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  display: inline-grid;
  place-items: center;
  border-radius: 8px;
  background: rgba(92,132,154,.1);
  color: #476477;
  font-size: 10px;
}
.playgroundModelList .chatItem {
  position: relative;
  border-left: 2px solid transparent;
}
.playgroundModelList .chatItem.isRunning::after {
  content: '';
  position: absolute;
  top: 10px;
  right: 9px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #16a36a;
  box-shadow: 0 0 0 3px rgba(22,163,106,.11);
}
.playgroundModelList .chatItem.isSelected { border-left-color: #0aa7d8; }
.playgroundModelEmpty { padding: 18px 10px; color: #63798a; font-size: 12px; text-align: center; }
.theme-dark .playgroundModelGroupHead { color: #8ba4b6; }
.theme-dark .playgroundModelGroupHead b { background: rgba(255,255,255,.06); color: #a8c0d0; }
.chat-test-layout .playgroundBanner { grid-area: banner; margin: 14px 14px 0; }
.chat-test-layout .playground-main-panel { grid-area: main; margin: 18px 14px 14px; min-height: 0; overflow: auto; }
.playground-conversation-shell { min-height: 100%; display: flex; flex-direction: column; gap: 0; }
.playground-conversation-shell > .playground-message-list { flex: 1; min-height: 0; }
.chat-test-layout .playground-output-card, .chat-test-layout .playground-output-card .ant-card-body { display: none; }
.playground-composer-card .ant-card-body { display: grid; gap: 8px; padding: 12px 14px; }
.playgroundComposerHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.playgroundComposerHead span { color: #63798a; font-size: .74rem; font-weight: 700; }
.playgroundComposerHead b {
  min-width: 0;
  color: #1e3343;
  font-size: .76rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.playgroundComposerInput :is(textarea, .ant-input) {
  border-radius: 14px;
  background: rgba(255,255,255,.72);
  border-color: rgba(92,132,154,.14);
  padding: 12px 14px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.2);
}
.audioUploadRow {
  min-height: 44px;
  padding: 8px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px dashed rgba(10,167,216,.32);
  border-radius: 8px;
  background: rgba(10,167,216,.045);
}
.audioUploadRow > span {
  min-width: 0;
  color: #63798a;
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.audioUploadRow > span.hasFile { color: #167a58; font-weight: 650; }
.speakerUploadGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}
.speakerThresholdRow {
  display: grid;
  grid-template-columns: auto 74px minmax(120px, 1fr);
  align-items: center;
  gap: 10px;
  min-height: 36px;
}
.speakerThresholdRow > span { color: #63798a; font-size: 12px; font-weight: 650; }
.audioCapabilityNotice {
  display: grid;
  gap: 5px;
  padding: 11px 12px;
  border: 1px solid rgba(219,151,29,.24);
  border-radius: 8px;
  background: rgba(255,184,61,.075);
}
.audioCapabilityNotice b { font-size: 13px; color: #6b4b13; }
.audioCapabilityNotice p, .audioCapabilityNotice span { margin: 0; color: #76674f; font-size: 12px; line-height: 1.5; }
.theme-dark .audioUploadRow { background: rgba(10,167,216,.08); border-color: rgba(74,190,255,.24); }
.theme-dark .audioUploadRow > span { color: #9bb4c3; }
.theme-dark .audioUploadRow > span.hasFile { color: #62d4a8; }
.theme-dark .speakerThresholdRow > span { color: #9bb4c3; }
.theme-dark .audioCapabilityNotice { background: rgba(255,184,61,.08); border-color: rgba(255,184,61,.2); }
.theme-dark .audioCapabilityNotice b { color: #f2c46d; }
.theme-dark .audioCapabilityNotice p, .theme-dark .audioCapabilityNotice span { color: #bba982; }
@media (max-width: 680px) {
  .speakerUploadGrid { grid-template-columns: 1fr; }
  .speakerThresholdRow { grid-template-columns: auto 70px minmax(90px, 1fr); }
}
.chat-test-layout .playground-side-panel {
  grid-area: side;
  min-height: 0;
  border-left: 1px solid var(--rail-border);
  padding: 14px 12px;
  overflow: hidden;
  display: grid;
  grid-template-rows: minmax(0, 1fr);
}
/* ── 参数面板 Layout 容器 ──────────────────── */
.playgroundParamsPanel {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.playgroundParamsPanelHead {
  padding: 0 0 10px 2px;
}
.playgroundParamsPanelHead h2 { margin: 0; font-size: .84rem; font-weight: 720; }
.playgroundParamsPanelBody {
  flex: 1;
  overflow: auto;
  display: grid;
  gap: 12px;
  align-content: start;
}
.playgroundParamsField {
  display: grid;
  gap: 5px;
}
.playgroundParamsField > label {
  font-size: .72rem;
  font-weight: 650;
  color: #63798a;
}
.playgroundSwitchField {
  min-height: 36px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid rgba(92,132,154,.14);
  border-radius: 8px;
  background: rgba(255,255,255,.48);
}
.playgroundSwitchField span { font-size: 12px; font-weight: 650; }
.theme-dark .playgroundSwitchField { background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.theme-dark .playgroundParamsField > label { color: #7a95ae; }
.playground-mode-detection {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 8px;
  background: rgba(255,255,255,.52);
}
.playground-mode-detection span {
  font-size: 11px;
  font-weight: 650;
  color: #63798a;
}
.playground-mode-detection strong {
  font-size: 13px;
  line-height: 1.4;
}
.playground-mode-detection p {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: #63798a;
}
.playgroundRuntimeState {
  display: flex;
  align-items: center;
  gap: 7px;
  padding-top: 4px;
  border-top: 1px solid rgba(92,132,154,.12);
}
.playgroundRuntimeState i {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #d39a35;
}
.playgroundRuntimeState i.ready { background: #16a36a; }
.playgroundRuntimeState span { min-width: 0; font-size: 11px; color: #526b7c; }
.theme-dark .playgroundRuntimeState { border-top-color: rgba(74,190,255,.1); }
.theme-dark .playgroundRuntimeState span { color: #9bb4c3; }
.theme-dark .playground-mode-detection {
  background: rgba(255,255,255,.035);
  border-color: rgba(74,190,255,.14);
}
.theme-dark .playground-mode-detection span,
.theme-dark .playground-mode-detection p { color: #7a95ae; }
.theme-dark .prototype-chat-list { background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.02)); }
.theme-dark .chatPanelIcon,
.theme-dark .playgroundChatSection span,
.theme-dark .chatItemMeta,
.theme-dark .playgroundComposerHead span { color: #9bb4c3; }
.theme-dark .playgroundSearchWrap .ant-input-affix-wrapper,
.theme-dark .playgroundComposerInput :is(textarea, .ant-input) {
  background: rgba(255,255,255,.035);
  border-color: rgba(74,190,255,.14);
}
.theme-dark .playgroundComposerHead b { color: #edf7fb; }
.playground-params-note {
  display: grid;
  gap: 4px;
  margin-top: 4px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(10,167,216,.06);
  border: 1px solid rgba(10,167,216,.12);
}
.playground-params-note b { color: #1e3343; font-size: .8rem; }
.playground-params-note span { color: #63798a; font-size: .75rem; line-height: 1.55; }
.theme-dark .playground-params-note { background: rgba(10,167,216,.1); border-color: rgba(74,190,255,.16); }
.theme-dark .playground-params-note b { color: #edf7fb; }
.theme-dark .playground-params-note span { color: #9bb4c3; }
.playground-welcome-panel {
  min-height: 100%;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 10px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 14px;
  background: rgba(255,255,255,.72);
  text-align: center;
  padding: 28px 24px;
}
.playground-welcome-symbol { font-size: 34px; line-height: 1; color: #8252f1; }
.playground-welcome-panel h2 { margin: 0; font-size: 28px; line-height: 1; }
.playground-welcome-panel p { max-width: 460px; margin: 0; color: #63798a; line-height: 1.65; }
.playgroundSuggestionList {
  width: min(100%, 620px);
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}
.playgroundSuggestionItem {
  min-height: 42px;
  padding: 0 14px;
  border-radius: 12px;
  border: 1px solid rgba(92,132,154,.14);
  background: rgba(255,255,255,.68);
  color: inherit;
  text-align: left;
  font-size: .8rem;
  cursor: pointer;
}
.playground-welcome-button {
  height: 38px;
  padding: 0 18px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 10px;
  background: rgba(255,255,255,.88);
  color: #1e3343;
  font-size: 14px;
  cursor: pointer;
}
.theme-dark .playground-welcome-panel { background: rgba(13,24,34,.72); border-color: rgba(74,190,255,.18); }
.theme-dark .playground-welcome-panel p { color: #9bb4c3; }
.theme-dark .playgroundSuggestionItem { background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.theme-dark .playground-welcome-button { background: rgba(255,255,255,.04); color: #edf7fb; border-color: rgba(74,190,255,.16); }

.publish-console-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  grid-template-rows: auto minmax(0, 1fr);
  grid-template-areas: "top side" "main side";
  gap: 0;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.publish-console-layout.right-panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas: "top" "main";
}
.publish-console-layout > .publish-topbar-prototype { grid-area: top; }
.publish-console-main {
  grid-area: main;
  min-width: 0;
  min-height: 0;
  margin: 12px 14px 14px;
  overflow: auto;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 10px;
}
.publish-console-side {
  grid-area: side;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: grid;
  border-left: 1px solid var(--rail-border);
  padding: 14px 12px;
}
.publish-topbar-prototype {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  margin: 14px 14px 0;
  padding: 7px 10px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: var(--surface-radius);
  background: rgba(255,255,255,.5);
}
.publish-toolbar-left,
.publish-toolbar-right { display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: wrap; }
.publish-toolbar-right {
  justify-content: flex-end;
  margin-right: clamp(56px, 7vw, 112px);
}
.publish-toolbar-label { color: #63798a; font-size: .78rem; font-weight: 650; }
.publish-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 30px;
  padding: 0 10px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 8px;
  background: rgba(255,255,255,.62);
  font-size: 12px;
}
.publish-status-pill i {
  width: 22px;
  height: 14px;
  border-radius: 99px;
  background: rgba(99,121,138,.24);
  position: relative;
}
.publish-status-pill i::after {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,.18);
}
.publish-status-pill.is-running i { background: rgba(31,207,112,.82); }
.publish-status-pill.is-running i::after { left: 10px; }
.publish-url-button {
  max-width: 360px;
  border-radius: 8px;
  font-family: var(--font-mono);
}
.publish-url-button > span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-log-stage,
.publish-loaded-stage {
  min-height: 0;
  display: grid;
  align-content: start;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: var(--surface-radius);
  background: rgba(255,255,255,.42);
  overflow: hidden;
}
.publish-stage-header {
  min-height: 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 0 12px;
  border-bottom: 1px solid rgba(92,132,154,.14);
}
.publish-stage-header strong { font-size: 13px; font-weight: 760; }
.publish-stage-actions { display: inline-flex; align-items: center; gap: 8px; }
.publish-console-log {
  min-height: 360px;
  height: 100%;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.publish-loaded-body { display: grid; gap: 10px; padding: 10px; }
.publish-loaded-card {
  display: grid;
  gap: 12px;
  padding: 10px 12px 12px;
  border: 1px solid rgba(53,88,230,.72);
  border-radius: 10px;
  background: rgba(10,167,216,.025);
  cursor: pointer;
  transition: border-color .16s ease, background .16s ease, box-shadow .16s ease;
}
.publish-loaded-card:hover { background: rgba(10,167,216,.055); }
.publish-loaded-card.is-selected {
  border-color: #1d6df2;
  background: rgba(29,109,242,.07);
  box-shadow: 0 0 0 2px rgba(29,109,242,.12);
}
.publish-loaded-card-head,
.publish-loaded-row,
.publish-endpoint-strip,
.publish-loaded-runtime {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.publish-loaded-card-head { justify-content: space-between; }
.publish-loaded-row { justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid rgba(92,132,154,.12); }
.publish-loaded-title { min-width: 0; display: flex; align-items: center; gap: 8px; }
.publish-loaded-title > span { min-width: 0; display: grid; gap: 2px; }
.publish-loaded-title strong {
  min-width: 0;
  color: #1d6df2;
  font-size: .84rem;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-loaded-title small {
  color: #63798a;
  font-size: .7rem;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-loaded-stats { flex: none; display: inline-flex; align-items: center; gap: 8px; }
.publish-loaded-stats > span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 30px;
  padding: 0 10px;
  border: 1px solid rgba(92,132,154,.14);
  border-radius: 8px;
  color: #63798a;
  font-size: .74rem;
  background: rgba(255,255,255,.48);
}
.publish-loaded-stats b { color: #1e3343; font-weight: 760; }
.publish-load-progress {
  display: grid;
  gap: 4px;
  min-width: 0;
  padding: 2px 0 0;
  color: #63798a;
  font-size: .74rem;
}
.publish-load-progress span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-loaded-runtime { flex-wrap: wrap; color: #63798a; font-size: .74rem; }
.publish-failure-note {
  color: #cf1322;
  font-size: .72rem;
  font-weight: 700;
}
.publish-failure-actions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; min-width: 0; }
.publish-failure-actions .ant-btn {
  min-width: 78px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.publish-failure-actions .ant-btn .anticon {
  width: 14px;
  height: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.publish-loaded-runtime small { color: #7a8a98; }
.publish-endpoint-item {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.publish-endpoint-item b { flex: none; color: #526b7c; font-size: .7rem; }
.publish-endpoint-item a,
.publish-endpoint-item code {
  min-width: 0;
  overflow: hidden;
  color: #1d6df2;
  font-family: var(--font-mono);
  font-size: .72rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-endpoint-item a:hover { text-decoration: underline; }
.publish-endpoint-item.is-primary { flex: 1; }
.publish-endpoint-strip {
  justify-content: space-between;
  padding-top: 10px;
  border-top: 1px solid rgba(92,132,154,.1);
  color: #63798a;
  font-size: .76rem;
}
.publish-card-arrow {
  width: 22px;
  height: 22px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: #63798a;
  cursor: pointer;
}
.publish-card-arrow:hover { background: rgba(10,167,216,.1); color: #006b95; }
.publish-loaded-empty {
  display: grid;
  place-items: center;
  gap: 8px;
  min-height: 128px;
  color: #63798a;
  text-align: center;
}
.publish-loaded-empty strong { color: #1e3343; }
.publish-empty-selected {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  max-width: 100%;
  flex-wrap: wrap;
}
.publish-runtime-picker {
  order: -2;
  flex: 0 0 auto;
  min-width: 0;
  min-height: 64px;
  padding: 9px 10px;
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(10,167,216,.22);
  border-radius: 8px;
  background: rgba(10,167,216,.045);
}
.publish-loaded-stage { order: -1; }
.publish-runtime-placeholder {
  min-width: 0;
  min-height: 42px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  border: 1px dashed rgba(92,132,154,.18);
  border-radius: 7px;
  color: #63798a;
  background: rgba(255,255,255,.34);
  font-size: 11px;
}
.publish-runtime-picker-copy {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.publish-runtime-picker-copy span { color: #63798a; font-size: 11px; font-weight: 650; }
.publish-runtime-picker-copy strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
}
.publish-runtime-rail {
  min-width: 0;
  display: flex;
  gap: 7px;
  overflow-x: auto;
  padding: 1px 2px 4px;
  scrollbar-width: thin;
}
.publish-runtime-option {
  min-width: 156px;
  max-width: 220px;
  height: 42px;
  padding: 0 9px;
  display: grid;
  grid-template-columns: 8px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 7px;
  background: rgba(255,255,255,.68);
  color: inherit;
  text-align: left;
  cursor: pointer;
}
.publish-runtime-option:hover { border-color: rgba(10,167,216,.36); }
.publish-runtime-option.is-selected {
  border-color: #0aa7d8;
  background: rgba(10,167,216,.11);
  box-shadow: inset 0 0 0 1px rgba(10,167,216,.08);
}
.publish-runtime-option > i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #c89639;
}
.publish-runtime-option > i.running { background: #16a36a; }
.publish-runtime-option > span { min-width: 0; display: grid; gap: 2px; }
.publish-runtime-option strong,
.publish-runtime-option small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-runtime-option strong { font-size: 12px; }
.publish-runtime-option small { color: #63798a; font-size: 10px; }
.publish-runtime-actions { display: inline-flex; align-items: center; gap: 7px; }
.publish-binding-track { grid-column: 1 / -1; min-width: 0; display: flex; align-items: center; gap: 7px; padding-top: 8px; border-top: 1px solid rgba(10,167,216,.12); }
.publish-binding-node { max-width: 180px; min-height: 24px; display: inline-flex; align-items: center; padding: 0 8px; border: 1px solid rgba(92,132,154,.16); border-radius: 7px; background: rgba(255,255,255,.54); color: #27465d; font-size: 11px; font-weight: 720; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publish-binding-node.is-target { color: #006b95; border-color: rgba(10,167,216,.28); background: rgba(10,167,216,.1); }
.publish-binding-track > i { flex: none; color: #0aa7d8; font-style: normal; font-weight: 800; }
.publish-binding-track > small { min-width: 0; margin-left: 3px; color: #63798a; font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.theme-dark .publish-binding-node { color: #edf7fb; background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.runtime-metadata-form { display: grid; gap: 16px; }
.runtime-metadata-form label {
  display: grid;
  gap: 7px;
  color: var(--text-secondary);
  font-size: 13px;
}
.runtime-metadata-form label > span { color: var(--text-primary); font-weight: 600; }
.runtime-metadata-form > small { color: var(--text-tertiary); line-height: 1.6; }
.theme-dark .publish-runtime-picker { background: rgba(10,167,216,.08); border-color: rgba(74,190,255,.18); }
.theme-dark .publish-runtime-picker-copy span,
.theme-dark .publish-runtime-option small { color: #9bb4c3; }
.theme-dark .publish-runtime-option { background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.theme-dark .publish-runtime-option.is-selected { background: rgba(10,167,216,.16); border-color: #4abfff; }
.theme-dark .publish-runtime-placeholder { color: #9bb4c3; background: rgba(255,255,255,.025); border-color: rgba(74,190,255,.14); }
.publish-mode-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.publish-mode-tab {
  height: 32px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 8px;
  background: rgba(255,255,255,.62);
  color: inherit;
  font-size: .78rem;
  cursor: pointer;
}
.publish-mode-tab.is-active { background: rgba(10,167,216,.12); color: #006b95; border-color: rgba(10,167,216,.26); }
.publish-info-table { display: grid; }
.publish-info-row {
  display: grid;
  grid-template-columns: 160px minmax(0, 1fr);
  gap: 14px;
  align-items: center;
  min-height: 42px;
  padding: 0 14px;
  border-bottom: 1px solid rgba(92,132,154,.1);
}
.publish-info-row:last-child { border-bottom: 0; }
.publish-info-row span { color: #63798a; font-size: .78rem; }
.publish-info-row strong { min-width: 0; font-size: .82rem; font-weight: 650; overflow-wrap: anywhere; }
.publish-field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.publish-field-block { display: grid; gap: 6px; }
.publish-field-block span { color: #63798a; font-size: .74rem; font-weight: 650; }
.publish-endpoint-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.publish-endpoint-cell {
  min-width: 0;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(92,132,154,.12);
  background: rgba(10,167,216,.04);
}
.publish-endpoint-cell span { display: block; color: #63798a; font-size: .72rem; margin-bottom: 4px; }
.publish-endpoint-cell strong { display: block; font-size: .8rem; font-weight: 650; overflow-wrap: anywhere; }
.publish-side-stage { height: 100%; min-height: 0; display: flex; flex-direction: column; }
.publish-side-heading {
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 0 0 10px 2px;
}
.publish-side-heading strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: .84rem;
  font-weight: 760;
}
.publish-side-body {
  flex: 1;
  min-height: 0;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 12px;
  padding: 0 0 12px;
}
.publish-side-tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.publish-side-panel-body { display: grid; gap: 12px; align-content: start; }
.publish-side-card-title { padding: 0 0 2px; }
.publish-side-card-title strong { font-size: .84rem; font-weight: 760; }
.publish-side-model-meta {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(92,132,154,.12);
  background: rgba(10,167,216,.04);
}
.publish-side-model-meta strong { min-width: 0; font-size: .84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publish-side-model-meta span { color: #63798a; font-size: .74rem; line-height: 1.5; overflow-wrap: anywhere; }
.publish-side-info-table .publish-info-row {
  grid-template-columns: 1fr;
  gap: 4px;
  min-height: auto;
  padding: 10px 0;
}
.publish-side-info-table .publish-info-row span { font-size: .72rem; }
.publish-side-info-table .publish-info-row strong { font-size: .8rem; }
.publish-side-field-grid { grid-template-columns: 1fr; }
.publish-side-endpoint-grid { grid-template-columns: 1fr; }
.publish-parameter-panel { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 0; }
.publish-parameter-panel-head { padding: 0 0 8px 2px; font-size: .82rem; font-weight: 720; }
.publish-parameter-panel-body { flex: 1; overflow: auto; display: grid; gap: 10px; align-content: start; }
.publishParamField { display: grid; gap: 4px; }
.publishParamField > label { font-size: .72rem; font-weight: 650; color: #63798a; }
.theme-dark .publishParamField > label { color: #7a95ae; }
.publish-side-footer {
  display: grid;
  gap: 8px;
  flex: none;
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid rgba(92,132,154,.14);
}
.publish-api-usage-card {
  display: grid;
  gap: 10px;
  padding: 12px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 10px;
  background: rgba(255,255,255,.42);
}
.publish-api-usage-card > strong { font-size: .84rem; }
.publish-api-usage-card label { min-width: 0; display: grid; gap: 6px; }
.publish-api-usage-card label > span { color: #63798a; font-size: .72rem; }
.publish-copy-field {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 30px;
  gap: 8px;
  align-items: center;
}
.publish-copy-field b {
  min-width: 0;
  height: 32px;
  display: flex;
  align-items: center;
  padding: 0 10px;
  border: 1px solid rgba(92,132,154,.12);
  border-radius: 8px;
  background: rgba(255,255,255,.42);
  font-size: .75rem;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.publish-copy-field button {
  width: 30px;
  height: 30px;
  border: 1px solid rgba(92,132,154,.14);
  border-radius: 8px;
  background: transparent;
  color: inherit;
  cursor: pointer;
}
.publish-copy-field button:hover { background: rgba(10,167,216,.1); color: #006b95; }
.publish-plan-preview { margin: 0; }
.publish-console-layout .deploy-kv-grid span {
  padding: 8px 10px;
  border-radius: 8px;
  background: rgba(10,167,216,.04);
  white-space: normal;
}
.publish-console-layout .deploy-kv-grid b { white-space: normal; overflow-wrap: anywhere; }
.publish-console-layout .deploy-live-log { min-height: 260px; }
.theme-dark .publish-topbar-prototype,
.theme-dark .publish-log-stage,
.theme-dark .publish-loaded-stage,
.theme-dark .publish-api-usage-card { background: rgba(255,255,255,.03); border-color: rgba(74,190,255,.14); }
.theme-dark .publish-side-footer { border-color: rgba(74,190,255,.14); }
.theme-dark .publish-loaded-card { background: rgba(8,16,24,.52); border-color: rgba(53,88,230,.8); }
.theme-dark .publish-loaded-card:hover { background: rgba(22,43,65,.58); }
.theme-dark .publish-loaded-card.is-selected { background: rgba(29,109,242,.14); border-color: #4abfff; }
.theme-dark .publish-status-pill,
.theme-dark .publish-loaded-stats > span,
.theme-dark .publish-copy-field b {
  background: rgba(255,255,255,.035);
  border-color: rgba(74,190,255,.14);
}
.theme-dark .publish-loaded-title strong,
.theme-dark .publish-loaded-empty strong,
.theme-dark .publish-loaded-stats b { color: #edf7fb; }
.theme-dark .publish-loaded-title small,
.theme-dark .publish-load-progress,
.theme-dark .publish-loaded-runtime,
.theme-dark .publish-loaded-runtime small,
.theme-dark .publish-endpoint-strip,
.theme-dark .publish-api-usage-card label > span { color: #9bb4c3; }
.theme-dark .publish-url-button {
  border-color: rgba(74,190,255,.16);
  background: rgba(255,255,255,.035);
}
.theme-dark .publish-toolbar-label { color: #9bb4c3; }
.theme-dark .publish-mode-title span,
.theme-dark .publish-info-row span,
.theme-dark .publish-field-block span,
.theme-dark .publish-endpoint-cell span,
.theme-dark .publish-side-model-meta span { color: #9bb4c3; }
.theme-dark .publish-mode-tab { background: rgba(255,255,255,.04); border-color: rgba(74,190,255,.14); }
.theme-dark .publish-mode-tab.is-active { color: #edf7fb; background: rgba(10,167,216,.16); border-color: rgba(74,190,255,.28); }
.theme-dark .publish-endpoint-cell,
.theme-dark .publish-side-model-meta,
.theme-dark .publish-console-layout .deploy-kv-grid span { background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.12); }

@media (max-width: 980px) {
  .publish-console-layout { grid-template-columns: minmax(0, 1fr); grid-template-areas: "top" "main" "side"; overflow: auto; }
  .publish-console-side { border-left: 0; padding: 0 14px 14px; }
  .publish-loaded-row { align-items: flex-start; flex-direction: column; }
  .publish-loaded-stats { flex-wrap: wrap; }
  .publish-topbar-prototype { align-items: flex-start; flex-direction: column; }
  .publish-toolbar-right { justify-content: flex-start; margin-right: 0; }
  .publish-runtime-picker { grid-template-columns: 1fr; }
  .publish-runtime-actions { justify-content: flex-end; }
}

.runtime-layout {
  display: grid;
  grid-template-rows: 120px auto minmax(0, 1fr);
}
.runtime-layout .prototype-banner { grid-row: 1; }
.runtime-layout .preset-container-grid {
  min-height: 0;
  overflow: auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(248px, 284px));
  gap: 12px;
  align-content: start;
  justify-content: start;
}
.runtime-layout .diagnostics-log-card { max-height: 260px; overflow: hidden; }

.system-status-layout {
  display: grid;
  grid-template-rows: 120px auto minmax(0, .8fr) minmax(0, 1fr);
}
.system-status-layout .prototype-banner { grid-row: 1; }
.system-status-layout .diagnostics-grid { grid-template-columns: repeat(4, minmax(120px, 1fr)); }
.system-status-layout .diagnostics-detail-grid,
.system-status-layout .diagnostics-workbench-grid { min-height: 0; }

.tasks-layout {
  display: grid;
  grid-template-rows: 120px auto minmax(0, 1fr);
}
.tasks-layout .taskBanner { grid-row: 1; }
.tasks-layout .task-overview { grid-template-columns: repeat(4, minmax(120px, 1fr)); }
.tasks-layout > .glass-card:nth-of-type(1),
.tasks-layout > .task-detail-card { min-height: 0; overflow: hidden; }
.tasks-layout { grid-template-columns: minmax(420px, .95fr) minmax(480px, 1.25fr); grid-template-areas: "banner banner" "summary summary" "list log"; }
.tasks-layout .taskBanner { grid-area: banner; }
.tasks-layout .task-overview { grid-area: summary; }
.tasks-layout > .glass-card:nth-of-type(1) { grid-area: list; }
.tasks-layout > .task-detail-card { grid-area: log; }
.tasks-layout .task-list { height: 100%; overflow: auto; }
.tasks-layout .task-detail-card .ant-card-body { height: calc(100% - 44px); overflow: auto; }

.tasks-layout.right-panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    "banner"
    "summary"
    "list";
}
.tasks-layout.right-panel-expanded {
  grid-template-columns: minmax(420px, 1fr) minmax(420px, 1fr);
  grid-template-areas:
    "banner log"
    "summary log"
    "list log";
}
.tasks-layout.right-panel-expanded .taskLogPanel {
  height: 100%;
  align-self: stretch;
}
.tasks-layout.right-panel-collapsed .taskMonitorPanel {
  height: 100%;
}

.settings-layout {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  gap: 0;
  padding: 0;
}
.settings-layout .settingsNavigator { display: flex; flex-direction: column; gap: 8px; padding: 18px 14px; border-right: 1px solid rgba(92,132,154,.18); background: rgba(10,167,216,.04); min-height: 0; }
.settingsNavigatorHeader { display: grid; gap: 3px; margin-bottom: 10px; }
.settingsNavigatorHeader b { font-size: 18px; }
.settingsNavigatorHeader span { color: #63798a; font-size: .78rem; }
.settingsNavButton { height: 34px; border: 0; border-radius: 8px; background: transparent; color: inherit; text-align: left; padding: 0 10px; cursor: pointer; }
/* Settings prototype layout */
.settingsWorkbench { display: grid; grid-template-columns: 220px minmax(0, 1fr); width: 100%; height: 100%; }
.settingsNavigator { display: flex; flex-direction: column; min-height: 0; padding: 18px 14px 16px; border-right: 1px solid rgba(92,132,154,.18); background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,0)), var(--bgPanel); }
.settingsNavigatorHeader { padding: 4px 10px 14px; font-size: 22px; font-weight: 700; }
.settingsNavigatorGroup { display: flex; flex-direction: column; gap: 4px; }
.settingsNavigatorTitle { padding: 0 10px 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #8a96aa; }
.settingsNavigatorDivider { height: 1px; margin: 14px 10px; background: rgba(92,132,154,.16); }
.settingsNavButton:hover,
.settingsNavButton.isActive { background: rgba(10,167,216,.12); color: #006b95; }
.theme-dark .settingsNavigator { border-right-color: rgba(74,190,255,.14); }
.theme-dark .settingsNavigatorDivider { background: rgba(74,190,255,.12); }
.theme-dark .settingsNavigatorTitle { color: #818793; }

/* Settings detail */
.settingsDetailPane { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.settingsDetailBody { flex: 1; min-height: 0; padding: 20px 28px 32px; overflow: auto; }
.settingsPanel { display: none; }
.settingsPanel.isActive { display: block; }
.settingsSection + .settingsSection { margin-top: 22px; }
.settingsSectionTitle { margin: 0 0 12px; font-size: 13px; font-weight: 700; color: #5f6c82; }
.settingsList { overflow: hidden; border: 1px solid rgba(92,132,154,.16); border-radius: 16px; background: rgba(255,255,255,.72); box-shadow: 0 14px 28px rgba(16,28,56,.08); }
.settingRow { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 18px; min-height: 78px; padding: 18px 20px; }
.settingRow + .settingRow { border-top: 1px solid rgba(92,132,154,.14); }
.settingMain { min-width: 0; }
.settingLabel { font-size: 13px; font-weight: 700; line-height: 1.5; }
.settingDesc { margin-top: 4px; font-size: 12px; line-height: 1.7; color: #8a96aa; }
.settingControl { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
.settingInlineGroup { display: flex; align-items: center; gap: 10px; }
.settingValueText { font-size: 13px; font-weight: 600; text-align: right; }
.settingValueStack { min-width: min(360px, 42vw); flex-wrap: wrap; justify-content: flex-end; }
.settingMonoValue { max-width: 100%; padding: 3px 7px; border-radius: 6px; color: #1a2433; background: rgba(10,167,216,.07); font-family: var(--font-mono); font-size: 12px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.settingMessage { padding: 10px 14px; color: #63798a; font-size: 12px; line-height: 1.5; }
.theme-dark .settingMonoValue { color: #edf7fb; background: rgba(74,190,255,.10); }
.theme-dark .settingMessage { color: #9bb4c3; }
.theme-dark .settingsSectionTitle { color: #b9bdc6; }
.theme-dark .settingsList { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); box-shadow: 0 16px 32px rgba(0,0,0,.22); }
.theme-dark .settingRow + .settingRow { border-top-color: rgba(74,190,255,.1); }
.theme-dark .settingDesc { color: #818793; }
.theme-dark .settingsNavButton:hover, .theme-dark .settingsNavButton.isActive { color: #fff; background: rgba(10,167,216,.18); }
.settingsNavDot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; background: rgba(99,121,138,.2); flex-shrink: 0; }
.settingsNavButton.isActive .settingsNavDot { background: #0aa7d8; }
.theme-dark .settingsNavButton.isActive .settingsNavDot { background: #67e8f9; }

/* Settings: header sticky */
.settingsDetailHeader {
  position: sticky; top: 0; z-index: 5;
  display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
  padding: 24px 28px 18px;
}
.settingsDetailHeader h1 { margin: 0; font-size: 32px; line-height: 1; }
.settingsDetailHeader p { margin: 10px 0 0; font-size: 13px; }

/* Settings: body layout */
.settingsDetailBody { flex: 1; min-height: 0; padding: 20px 28px 32px; overflow: auto; }
.settingsDetailBody > .settings-card { margin: 0 0 22px; }
.settingsDetailBody > .settings-card > .ant-card-head { padding: 0 0 10px; border-bottom: 0; min-height: auto; }
.settingsDetailBody > .settings-card > .ant-card-head .ant-card-head-title { font-size: 13px; font-weight: 700; }
.settingsDetailBody > .settings-card > .ant-card-body { padding: 0; border-radius: 16px; overflow: hidden; }
.settingsDetailBody .settings-row-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
.settingsDetailBody .settings-block { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18px; min-height: 78px; padding: 18px 20px; }
.settingsDetailBody .settings-block + .settings-block { border-top: 1px solid rgba(92,132,154,.14); }
.theme-dark .settingsDetailBody .settings-block + .settings-block { border-top-color: rgba(74,190,255,.14); }
.settingsDetailBody .settings-block > b { font-size: 13px; font-weight: 700; }
.settingsDetailBody .settings-block > .muted-line { grid-column: 1; margin: 4px 0 0; font-size: 12px; line-height: 1.7; }
.settingsDetailBody .settings-block > .settings-controls,
.settingsDetailBody .settings-block > .ant-input-number,
.settingsDetailBody .settings-block > .ant-btn,
.settingsDetailBody .settings-block > .settings-summary,
.settingsDetailBody .settings-block > .ant-select { grid-column: 2; }
.settingsDetailBody .plan-alert { margin: 0; border-radius: 0; border-left: 0; border-right: 0; border-bottom: 0; }
.settingsDetailBody .settings-summary.compact-settings-summary { display: grid; gap: 8px; }
.settingsDetailBody .settings-summary span { padding: 0; border: 0; background: transparent; }
.settingsNavigatorDivider { height: 1px; background: rgba(92,132,154,.18); margin: 8px 0; }
.settingsAccountCard { margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 8px; border: 1px solid rgba(92,132,154,.18); }
.settingsAccountAvatar { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; color: #fff; background: #0aa7d8; font-weight: 800; }
.settingsAccountCard div:last-child { display: grid; }
.settingsAccountCard span { color: #63798a; font-size: .72rem; }
.settingsDetailPane { min-height: 0; display: grid; grid-template-rows: auto minmax(0, 1fr); }
.settingsDetailHeader { padding: 18px 22px; border-bottom: 1px solid rgba(92,132,154,.18); }
.settingsDetailHeader h1 { margin: 0; font-size: 1.5rem; }
.settingsDetailHeader p { margin: 6px 0 0; color: #63798a; }
.settingsDetailBody { min-height: 0; overflow: auto; padding: 18px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-content: start; }
.settingsDetailBody .capability-settings-card { grid-column: 1 / -1; }

@media (max-width: 1180px) {
  .dashboard-layout,
  .model-library-layout,
  .publish-layout,
  .tasks-layout { grid-template-columns: 1fr; grid-template-areas: none; overflow: auto; }
  .dashboard-layout > .home-two-col > .glass-card:last-child { position: static; width: auto; }
  .chat-test-layout { grid-template-columns: 220px minmax(0, 1fr); grid-template-areas: "chat banner" "chat main" "chat side"; overflow: auto; }
  .chat-test-layout .playground-side-panel { border-left: 0; padding: 0 16px 16px; }
  .settings-layout { grid-template-columns: 1fr; overflow: auto; }
  .settings-layout .settingsNavigator { border-right: 0; border-bottom: 1px solid rgba(92,132,154,.18); }
}
@media (max-width: 760px) {
  .prototype-page { padding: 12px; overflow: auto; }
  .chat-test-layout { display: grid; grid-template-columns: 1fr; }
  .prototype-chat-list { max-height: 220px; }
  .runtime-layout .runtime-summary-strip,
  .system-status-layout .diagnostics-grid,
  .tasks-layout .task-overview,
  .settingsDetailBody { grid-template-columns: 1fr; }
}


/* Prototype inner components */
.model-library-layout {
  grid-template-columns: 214px minmax(640px, 1fr) 310px;
  grid-template-rows: minmax(0, 1fr);
  grid-template-areas: "libnav main side";
  padding: 14px 16px;
}
.model-library-layout .librarySidebar { grid-area: libnav; min-height: 0; height: 100%; display: flex; flex-direction: column; gap: 18px; padding: 8px 0; }
.librarySidebarHeader { padding: 0 10px; }
.librarySidebarHeader span { color: #63798a; font-size: 11px; font-weight: 800; letter-spacing: .08em; }
.librarySidebarHeader h1 { margin: 10px 0; font-size: 28px; line-height: 1; }
.librarySidebarHeader p { margin: 0; color: #63798a; font-size: 12px; line-height: 1.75; }
.libraryNavGroup { display: flex; flex-direction: column; gap: 6px; }
.libraryCategoryButton { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 40px; padding: 0 12px; border: 0; border-radius: 10px; color: inherit; background: transparent; text-align: left; cursor: pointer; }
.libraryCategoryButton span { font-size: 13px; font-weight: 650; }
.libraryCategoryButton strong { min-width: 24px; height: 24px; display: grid; place-items: center; padding: 0 6px; border-radius: 999px; color: #63798a; background: rgba(10,167,216,.08); font-size: 11px; }
.libraryCategoryButton:hover, .libraryCategoryButton.isActive { background: rgba(10,167,216,.12); color: #005d82; }
.theme-dark .libraryCategoryButton:hover, .theme-dark .libraryCategoryButton.isActive { color: #edf7fb; }
.libraryCategoryButton.isActive strong { color: #fff; background: #0aa7d8; }
.model-library-workspace {
  display: grid;
  grid-template-columns: 214px minmax(0, 1fr) 296px;
  gap: 12px;
  padding: 12px 14px;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.model-library-workspace .librarySidebar {
  position: relative;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 72px;
}
.model-library-workspace.right-panel-collapsed {
  grid-template-columns: 214px minmax(0, 1fr);
}
.model-library-workspace .libraryNavGroup {
  min-height: 0;
  overflow-y: auto;
}
.librarySidebarFooter { position: absolute; left: 0; right: 0; bottom: 8px; margin-top: 0; display: grid; gap: 10px; padding: 14px 12px 0; border-top: 1px solid rgba(92,132,154,.18); }
.librarySidebarSync { display: grid; gap: 8px; }
.librarySidebarFooter span, .librarySidebarFooter small { color: #63798a; font-size: 11px; }
.librarySidebarFooter strong { font-size: 24px; line-height: 1; }
.librarySidebarFooter .ant-btn { height: 36px; border-radius: 10px; }
.librarySidebarDownloadButton { width: 100%; justify-content: center; }
.librarySidebarDownloadButton.ant-btn-primary,
.libraryDownloadButton.ant-btn-primary,
.model-library-table .ant-empty .ant-btn-primary {
  color: #ffffff !important;
  font-weight: 760;
  text-shadow: none;
  box-shadow: 0 10px 22px rgba(10,167,216,.24);
}
.librarySidebarDownloadButton .anticon,
.libraryDownloadButton .anticon,
.model-library-table .ant-empty .ant-btn-primary .anticon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
}

.libraryBanner { flex: 0 0 auto; min-height: 120px; margin-bottom: 10px; }
.libraryBanner .homeBannerDecor {
  right: 22px;
  top: auto;
  bottom: 16px;
  width: auto;
  height: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.libraryMainPanel { border-left: 1px solid rgba(92,132,154,.14); border-right: 1px solid rgba(92,132,154,.14); padding: 0 14px; display: flex; flex-direction: column; height: 100%; min-height: 0; overflow: hidden; }
.libraryToolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
  padding: 2px 0 10px;
  flex: 0 0 auto;
}
.libraryToolbarTitleGroup { display: grid; gap: 4px; min-width: 0; }
.libraryToolbarTitleGroup strong { font-size: 14px; font-weight: 750; }
.libraryToolbarTitleGroup span { color: #63798a; font-size: 12px; }
.libraryToolbarActions { display: flex; align-items: center; justify-content: flex-end; gap: 8px; min-width: 0; flex: 0 0 auto; }
.librarySearchField {
  width: min(100%, 340px);
  height: 34px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 10px;
  background: rgba(255,255,255,.72);
  flex: 0 0 auto;
}
.librarySearchIcon { color: #63798a; font-size: 14px; line-height: 1; }
.librarySearchField input {
  width: 100%;
  height: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  outline: none;
  font-size: 12px;
}
.libraryDownloadButton {
  height: 34px;
  padding-inline: 14px;
  border-radius: 10px;
  flex: 0 0 auto;
}
.theme-dark .librarySearchField { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); }
.theme-dark .libraryToolbarTitleGroup span, .theme-dark .librarySearchIcon { color: #9bb4c3; }
.model-library-layout .models-filter-card { order: -2; }
.model-library-layout .models-main-col > .glass-card:first-child { order: -1; }
.model-library-layout .models-card-grid { display: grid; gap: 0; grid-template-columns: 1fr; border: 1px solid rgba(92,132,154,.16); border-radius: 8px; overflow: auto; }
.model-library-layout .model-library-card { border-radius: 0 !important; border: 0 !important; border-bottom: 1px solid rgba(92,132,154,.12) !important; box-shadow: none !important; cursor: pointer; }
.model-library-layout .model-library-card.selected-library-model { background: rgba(10,167,216,.1) !important; }
.model-library-layout .model-library-card .ant-card-body { padding: 10px 12px; }
.model-library-layout .model-card-body { grid-template-columns: 1.3fr 1fr 1.2fr; align-items: center; gap: 12px; }
.model-library-layout .model-path-row, .model-library-layout .model-facts-clean, .model-library-layout .model-support-row { margin: 0; }
.model-library-layout .model-facts-clean { grid-template-columns: repeat(3, minmax(72px, 1fr)); }
.model-library-layout .model-audit-summary, .model-library-layout .compatibility-matrix.compact-support { grid-column: 1 / -1; }
/* ── 模型详情三区域 Layout ──────────────────── */
.modelDetailPanel {
  height: 100%;
  min-height: 0;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-left: 12px;
  border-left: 1px solid var(--rail-border);
}
.model-library-layout .modelDetailPanel {
  grid-template-rows: none;
}
.modelDetailSection {
  padding: 12px 0;
  border-bottom: 1px solid rgba(92,132,154,.08);
}
.modelDetailSection:first-child { padding-top: 0; }
.modelDetailSection:last-child { border-bottom: 0; }
.modelDetailDownloadSection { margin-top: auto; }
.modelDetailSectionHead {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  margin-bottom: 8px;
}
.modelDetailSectionHead h3 { margin: 0; font-size: .8rem; font-weight: 720; }
.modelDetailBadge {
  font-size: .68rem; font-weight: 700; color: #63798a;
  padding: 2px 8px; border-radius: 999px; background: rgba(99,121,138,.08);
}
.modelDetailCount {
  min-width: 20px; height: 20px; border-radius: 999px;
  background: rgba(99,121,138,.08); color: #63798a;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: .68rem; font-weight: 700; padding: 0 6px;
}
.modelDetailKv { display: grid; gap: 5px; }
.modelDetailKvRow { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: .78rem; }
.modelDetailKvRow span { color: #63798a; font-size: .72rem; flex-shrink: 0; }
.modelDetailKvRow strong { font-weight: 620; text-align: right; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.modelDetailActions { display: flex; gap: 6px; margin-top: 10px; }
.modelDetailNote { margin: 8px 0 0; color: #63798a; font-size: .74rem; line-height: 1.45; }
.modelDetailTaskList { display: grid; gap: 1px; background: rgba(92,132,154,.06); border-radius: 6px; overflow: hidden; }
.modelDetailTaskRow {
  width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 8px 10px; border: 0; background: transparent; color: inherit; cursor: pointer;
  font-size: .76rem; transition: background .12s;
}
.modelDetailTaskRow:hover { background: rgba(10,167,216,.04); }
.modelDetailTaskName { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 540; }
.modelDetailEmpty { padding: 20px; text-align: center; color: #94a6b8; font-size: .78rem; }
.theme-dark .modelDetailSection { border-bottom-color: rgba(74,190,255,.06); }
.theme-dark .modelDetailKvRow span { color: #7a95ae; }
.theme-dark .modelDetailNote { color: #7a95ae; }
.theme-dark .modelDetailTaskList { background: rgba(74,190,255,.04); }
.theme-dark .modelDetailTaskRow:hover { background: rgba(74,190,255,.06); }
.theme-dark .modelDetailBadge { color: #7a95ae; background: rgba(122,149,174,.12); }
.theme-dark .modelDetailCount { background: rgba(122,149,174,.12); color: #7a95ae; }

/* legacy detail panel - kept for compatibility */
.libraryDetailPanel {
  min-height: 0;
  overflow: auto;
  display: grid;
  grid-auto-rows: max-content;
  align-content: start;
  gap: 10px;
  padding-left: 12px;
  border-left: 1px solid var(--rail-border);
}

/* Model library table layout */
.model-library-table { flex: 1 1 auto; min-height: 0; border-radius: 12px; overflow: hidden; }
.model-library-table,
.model-library-table .ant-spin-nested-loading,
.model-library-table .ant-spin-container,
.model-library-table .ant-table,
.model-library-table .ant-table-container {
  height: 100%;
  min-height: 0;
}
.model-library-table .ant-table { font-size: .82rem; }
.model-library-table .ant-table-container { border-radius: 14px 14px 0 0; }
.model-library-table .ant-table-body {
  height: calc(100vh - 304px) !important;
  max-height: calc(100vh - 304px) !important;
}
.model-library-table .ant-table-thead > tr > th {
  height: 42px;
  padding: 0 12px;
  font-weight: 700;
  font-size: .72rem;
  text-transform: uppercase;
  letter-spacing: .04em;
  background: rgba(10,167,216,.06);
}
.model-library-table .ant-table-tbody > tr > td {
  min-height: 46px;
  padding: 8px 12px;
  cursor: pointer;
  vertical-align: middle;
}
.model-library-table .ant-table-tbody > tr:hover > td { background: rgba(10,167,216,.05); }
.theme-dark .model-library-table .ant-table-thead > tr > th { background: rgba(10,167,216,.1); }
.theme-dark .model-library-table .ant-table-tbody > tr:hover > td { background: rgba(10,167,216,.08); }
.model-library-table .ant-empty { min-height: 240px; display: grid; place-items: center; }
.table-model-cell { display: grid; gap: 2px; min-width: 0; }
.table-model-name { font-weight: 650; font-size: .84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.table-model-path { font-size: .7rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-mono); }
.table-compact-text { display: inline-block; max-width: 100%; font-size: .78rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.table-mono-chip {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 0 8px;
  border-radius: 999px;
  background: rgba(10,167,216,.08);
  color: #1e3343;
  font-family: var(--font-mono);
  font-size: .72rem;
  line-height: 1;
}
.theme-dark .table-mono-chip { background: rgba(10,167,216,.16); color: #edf7fb; }
.model-library-footer { flex: 0 0 auto; display: flex; align-items: center; gap: 14px; padding: 8px 12px; font-size: .75rem; border-radius: 0 0 12px 12px; }
.model-library-footer b { font-weight: 700; }
.model-download-alert { margin-top: 12px; }
.download-check-preview {
  display: grid;
  gap: 6px;
  min-width: 0;
}
.download-check-row {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #1f2d3d;
  font-size: 12px;
  line-height: 1.55;
}
.download-check-runtime {
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  overflow: hidden;
}
.download-check-runtime b {
  flex: 0 0 auto;
  font-size: 12px;
}
.download-check-runtime .ant-space {
  min-width: 0;
  flex-wrap: wrap;
}
.download-check-runtime .ant-space-item {
  min-width: 0;
  flex: 0 1 auto;
}
.download-check-runtime .ant-tag {
  max-width: 100%;
  margin-inline-end: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.download-check-runtime .download-runtime-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 24px;
  padding: 2px 9px;
  border-width: 1px;
  border-style: solid;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 750;
  line-height: 1.35;
  box-shadow: 0 1px 0 rgba(255,255,255,.08) inset, 0 4px 12px rgba(0,0,0,.1);
}
.download-check-runtime .download-runtime-tag::before {
  content: "";
  width: 6px;
  height: 6px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: currentColor;
  box-shadow: 0 0 0 3px currentColor;
  opacity: .65;
}
.download-check-runtime .download-runtime-tag.is-compatible {
  color: #22d378;
  background: rgba(34,211,120,.14);
  border-color: rgba(34,211,120,.48);
}
.download-check-runtime .download-runtime-tag.is-possible,
.download-check-runtime .download-runtime-tag.is-external {
  color: #ffc44d;
  background: rgba(255,196,77,.15);
  border-color: rgba(255,196,77,.52);
}
.download-check-runtime .download-runtime-tag.is-unsupported {
  color: #ff5f6d;
  background: rgba(255,95,109,.14);
  border-color: rgba(255,95,109,.5);
}
.theme-dark .download-check-row { color: #edf7fb; }
.model-download-task-section {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid rgba(92,132,154,.14);
  display: grid;
  gap: 10px;
}
.model-download-task-section .ant-list-item {
  cursor: pointer;
  padding-inline: 0 !important;
}
.model-download-empty {
  min-height: 128px; display: grid; place-items: center;
  color: #8a9aaa; font-size: .82rem;
  border: 1px dashed rgba(92,132,154,.18); border-radius: 8px;
  background: rgba(99,121,138,.035);
}
.theme-dark .model-download-empty { color: #9bb4c3; border-color: rgba(74,190,255,.16); background: rgba(255,255,255,.025); }
.theme-dark .model-download-task-section { border-top-color: rgba(74,190,255,.16); }

/* System: diagnostic grid spacing */
.diagnostics-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 14px; }
.diagnostics-detail-grid { display: grid; grid-template-columns: minmax(320px, .9fr) minmax(360px, 1.1fr); gap: 14px; margin-bottom: 14px; }
.diagnostics-workbench-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 14px; }
.diagnostic-card .ant-card-body { min-height: 104px; display: grid; align-content: center; gap: 5px; }
.diagnostics-resource-grid { grid-template-columns: repeat(3, minmax(110px, 1fr)); gap: 14px; padding: 14px; }
.diagnostics-resource-grid > div { min-height: 130px; border-radius: 8px; display: grid; place-items: center; align-content: center; gap: 8px; }
.diagnostics-kv-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 10px; padding: 12px; }
.diagnostics-kv-list span { padding: 10px; border-radius: 8px; }
.detailHeroCard, .detailCard { }
.theme-dark .detailHeroCard, .theme-dark .detailCard { }
.detailHeroCard { padding: 0 0 14px; display: grid; gap: 12px; border-bottom: 1px solid rgba(92,132,154,.1); }
.theme-dark .detailHeroCard { border-bottom-color: rgba(74,190,255,.1); }
.detailCard { border-bottom: 1px solid rgba(92,132,154,.06); }
.theme-dark .detailCard { border-bottom-color: rgba(74,190,255,.08); }
.detailCard:last-child { border-bottom: 0; }
.detailHeroTop { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.detailHeroTop h2 { margin: 0; font-size: 18px; line-height: 1.15; overflow-wrap: anywhere; }
.detailTitleTag { display: inline-flex; margin-top: 8px; color: #63798a; font-size: 11px; font-weight: 700; }
.detailStatusDot { width: 10px; height: 10px; border-radius: 50%; background: #52c41a; box-shadow: 0 0 0 4px rgba(82,196,26,.12); }
.detailStatusDot.isIdle { background: #8c8c8c; box-shadow: 0 0 0 4px rgba(140,140,140,.14); }
.detailActionRow, .detailQuickActions { display: flex; gap: 6px; flex-wrap: wrap; }
.detailActionRow .ant-btn { height: 32px; padding-inline: 12px; border-radius: 10px; }
.detailChipButton { height: 32px; padding: 0 12px; border: 1px solid rgba(92,132,154,.16); border-radius: 999px; background: transparent; color: inherit; font-size: 12px; cursor: pointer; }
.detailChipButton.isActive, .detailChipButton:hover { background: rgba(10,167,216,.12); color: #006b95; }
.detailChipButton:disabled { cursor: not-allowed; opacity: .72; }
.detailCard { padding: 10px 0; display: grid; gap: 8px; }
.detailCardTitle { color: #1e3343; font-weight: 750; font-size: 13px; }
.theme-dark .detailCardTitle { color: #edf7fb; }
.detailInfoList, .detailDomainList { display: grid; gap: 8px; }
.detailInfoRow, .detailDomainRow { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px; align-items: baseline; min-height: 22px; }
.detailInfoRow span, .detailDomainRow span { color: #63798a; font-size: 11px; }
.detailInfoRow strong, .detailDomainRow strong { min-width: 0; font-size: 12px; overflow-wrap: anywhere; }
.detailDownloadsCard .ant-list-item { cursor: pointer; padding-inline: 0 !important; }
.detailHeroPlaceholder { min-height: 180px; align-content: start; }
.detailPlaceholderText { margin: 0; color: #63798a; font-size: 12px; line-height: 1.65; }
.detailPlaceholderList strong { color: #8a96aa; }
.theme-dark .detailPlaceholderText, .theme-dark .detailPlaceholderList strong { color: #9bb4c3; }

.runtime-layout .compact-card { min-height: 214px; border-radius: 14px !important; }
.runtime-layout .compact-card .ant-card-head { border-bottom: 0; padding: 4px 14px 0; min-height: 42px; }
.runtime-layout .compact-card .ant-card-head-title { font-size: 16px; font-weight: 760; }
.runtime-layout .compact-card .ant-card-body { min-height: 154px; display: flex; flex-direction: column; gap: 10px; padding: 6px 14px 14px; }
.runtime-layout .compact-card .ant-card-extra .ant-space { gap: 4px !important; }
.runtime-layout .compact-card .ant-card-extra .ant-tag { margin-inline-end: 0; font-size: 11px; line-height: 18px; padding-inline: 7px; }
.runtime-layout .container-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.runtime-layout .container-facts span, .runtime-layout .version-tags { min-height: 58px; padding: 10px 12px; border-radius: 10px; }
.runtime-layout .container-facts span,
.runtime-layout .version-tags b { font-size: 11px; }
.runtime-layout .container-facts b { margin-top: 2px; font-size: 12px; line-height: 1.35; }
.runtime-layout .version-tags { gap: 6px; margin-top: 0; }
.runtime-layout .version-tags .ant-tag { font-size: 10px; line-height: 18px; }
.runtime-layout .container-action-row { margin-top: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; padding-top: 8px; }
.runtime-layout .container-action-row .ant-btn { border-radius: 10px; height: 28px; padding-inline: 10px; font-size: 12px; }
.runtime-layout .action-label { font-size: 11px; }
.runtime-layout .container-config-inline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 6px; align-items: end; margin-top: 8px; padding-top: 8px; }
.runtime-layout .config-inline-item { display: grid; gap: 4px; }
.runtime-layout .config-inline-item label { font-size: 11px; font-weight: 700; }
.runtime-layout .container-config-inline .ant-input-number,
.runtime-layout .container-config-inline .ant-select,
.runtime-layout .container-config-inline .ant-segmented { width: 100%; }
.runtime-layout .container-config-inline .ant-input-number,
.runtime-layout .container-config-inline .ant-select-single:not(.ant-select-customize-input) .ant-select-selector,
.runtime-layout .container-config-inline .ant-segmented { min-height: 28px; }
.runtime-layout .container-config-inline .ant-btn { height: 28px; }
.runtime-layout .add-custom-zone {
  width: auto;
  min-height: 214px;
  padding: 18px;
  font-size: 12px;
}
.runtime-layout .add-custom-zone .add-icon { font-size: 1.45rem; }
.runtime-layout .add-custom-caption { font-size: 11px; }

@media (max-width: 1180px) {
  .runtime-layout { grid-template-rows: 120px auto auto; }
  .runtime-layout .preset-container-grid { grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); }
}
@media (max-width: 760px) {
  .runtime-layout .runtime-summary-strip,
  .runtime-layout .preset-container-grid,
  .runtime-layout .container-facts,
  .runtime-layout .container-config-inline { grid-template-columns: 1fr; }
}

/* Runtime page aligned to the console/card surface used by Model Test and Publish. */
.runtime-layout {
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  gap: 18px;
  align-content: stretch;
  padding: 18px;
  overflow: hidden;
}
.runtime-layout .prototype-banner {
  min-height: 132px;
  border-radius: 12px;
}
.runtime-layout .prototype-banner h1 {
  font-size: 30px;
  line-height: 1;
}
.runtime-tab-shell {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(420px, .9fr) minmax(280px, 1.1fr);
  gap: 14px;
  align-items: stretch;
  padding: 10px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 12px;
  background: rgba(255,255,255,.42);
  box-shadow: 0 10px 24px rgba(16,28,56,.05);
}
.runtime-object-tabs {
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
  padding: 4px;
  border-radius: 9px;
  background: rgba(99,121,138,.08);
}
.runtime-object-tab {
  min-width: 0;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 10px;
  border: 0;
  border-radius: 7px;
  color: #587085;
  background: transparent;
  font: inherit;
  font-size: 12px;
  font-weight: 760;
  cursor: pointer;
  transition: color .16s ease, background .16s ease, box-shadow .16s ease;
}
.runtime-object-tab:hover { color: #17364f; background: rgba(255,255,255,.56); }
.runtime-object-tab.is-active {
  color: #17364f;
  background: #fff;
  box-shadow: 0 3px 10px rgba(16,28,56,.09);
}
.runtime-object-tab b {
  min-width: 20px;
  height: 20px;
  display: inline-grid;
  place-items: center;
  padding: 0 5px;
  border-radius: 999px;
  color: #0a7aa4;
  background: rgba(10,167,216,.1);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}
.runtime-tab-intro {
  min-width: 0;
  display: grid;
  align-content: center;
  gap: 3px;
  padding: 2px 8px;
}
.runtime-tab-intro strong { color: #17364f; font-size: 12px; font-weight: 800; }
.runtime-tab-intro span {
  min-width: 0;
  color: #63798a;
  font-size: 11px;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-dark .runtime-tab-shell {
  background: rgba(255,255,255,.035);
  border-color: rgba(74,190,255,.12);
  box-shadow: 0 12px 28px rgba(0,0,0,.16);
}
.theme-dark .runtime-object-tabs { background: rgba(255,255,255,.045); }
.theme-dark .runtime-object-tab { color: #9bb4c3; }
.theme-dark .runtime-object-tab:hover { color: #edf7fb; background: rgba(255,255,255,.045); }
.theme-dark .runtime-object-tab.is-active { color: #edf7fb; background: rgba(10,167,216,.13); box-shadow: none; }
.theme-dark .runtime-tab-intro strong { color: #edf7fb; }
.theme-dark .runtime-tab-intro span { color: #9bb4c3; }
.runtime-container-section {
  min-width: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 12px;
  overflow: hidden;
}
.runtime-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.runtime-section-title {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.runtime-create-button {
  flex: 0 0 auto;
  height: 30px;
  border-radius: 8px;
  font-weight: 700;
}
.runtime-section-head h2 {
  margin: 0;
  color: #1e3343;
  font-size: 15px;
  line-height: 1.2;
  font-weight: 780;
}
.runtime-section-title > span {
  min-width: 24px;
  height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(92,132,154,.14);
  border-radius: 999px;
  color: #63798a;
  background: rgba(255,255,255,.44);
  font-size: 12px;
  font-weight: 760;
}
.runtime-layout .preset-container-grid {
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  align-content: start;
  justify-content: stretch;
  padding: 0 6px 8px 0;
  overscroll-behavior: contain;
}
.runtime-layout .runtime-custom-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.runtime-layout .runtime-custom-grid > .runtime-card {
  width: auto;
}
.runtime-card {
  min-width: 0;
  min-height: 340px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 12px;
  background: rgba(255,255,255,.42);
  box-shadow: 0 16px 32px rgba(16,28,56,.08);
}
.runtime-card-head {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.runtime-card-title-group { min-width: 0; display: grid; gap: 3px; }
.runtime-card-kicker { color: #0aa7d8; font-size: 10px; line-height: 1; font-weight: 780; letter-spacing: .025em; }

.runtime-card h2 {
  min-width: 0;
  margin: 0;
  font-size: 22px;
  line-height: 1.2;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.runtime-usage-pill {
  flex: none;
  min-height: 22px;
  display: inline-flex;
  align-items: center;
  padding: 0 8px;
  border: 1px solid rgba(92,132,154,.16);
  border-radius: 999px;
  color: #63798a;
  background: rgba(255,255,255,.44);
  font-size: 11px;
  font-weight: 760;
}
.runtime-usage-pill.is-active {
  color: #0a7a42;
  border-color: rgba(31,143,80,.24);
  background: rgba(31,143,80,.1);
}
.runtime-card-facts {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  gap: 10px;
  align-self: stretch;
}
.runtime-fact {
  min-width: 0;
  min-height: 72px;
  display: grid;
  align-content: start;
  gap: 8px;
  padding: 14px;
  border-radius: 8px;
  background: rgba(99,121,138,.08);
}
.runtime-fact span {
  color: #587085;
  font-size: 12px;
  font-weight: 780;
}
.runtime-fact strong {
  min-width: 0;
  color: #17364f;
  font-size: 14px;
  line-height: 1.45;
  font-weight: 820;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.runtime-fact-detail small {
  min-width: 0;
  color: #63798a;
  font-size: 10px;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.runtime-status-list {
  display: grid;
  gap: 6px;
}
.runtime-ready-summary {
  min-height: 44px;
  display: flex;
  align-items: center;
}
.runtime-ready-check {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
  display: inline-grid;
  place-items: center;
  border-radius: 50%;
  color: #1f8f50;
  background: rgba(31,143,80,.18);
  box-shadow: inset 0 0 0 1px rgba(31,143,80,.34);
  font-style: normal;
  font-size: 14px;
  font-weight: 860;
  line-height: 1;
}
.runtime-status-dot {
  position: relative;
  min-width: 0;
  display: block;
  padding-left: 24px;
  color: #63798a;
  font-size: 13px;
  line-height: 18px;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.runtime-status-dot::before {
  content: "";
  position: absolute;
  left: 0;
  top: 1px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: rgba(99,121,138,.2);
}
.runtime-status-dot.green { color: #1f8f50; }
.runtime-status-dot.green::before { background: rgba(31,143,80,.22); box-shadow: inset 0 0 0 1px rgba(31,143,80,.36); }
.runtime-status-dot.green::after {
  content: "✓";
  position: absolute;
  left: 4px;
  top: -1px;
  color: #1f8f50;
  font-size: 12px;
}
.runtime-status-dot.red { color: #d45b61; }
.runtime-status-dot.red::before { background: rgba(212,91,97,.18); box-shadow: inset 0 0 0 1px rgba(212,91,97,.32); }
.runtime-status-dot.red::after {
  content: "×";
  position: absolute;
  left: 5px;
  top: -1px;
  color: #d45b61;
  font-size: 12px;
}
.runtime-status-dot.gold { color: #b9811d; }
.runtime-status-dot.gold::before { background: #ffbd4a; }
.runtime-status-dot.blue { color: #1d78ad; }
.runtime-status-dot.blue::before { background: rgba(48,152,214,.2); box-shadow: inset 0 0 0 1px rgba(48,152,214,.34); }
.runtime-card-actions {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  margin-top: auto;
  padding-top: 4px;
}
.runtime-card-actions-split {
  justify-content: space-between;
}
.runtime-card-action-group {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.runtime-delete-icon {
  margin-left: auto;
}
.runtime-card-actions .ant-btn {
  border-radius: 8px;
  height: 32px;
}
.runtime-card-actions .ant-btn-circle {
  width: 32px;
  min-width: 32px;
  max-width: 32px;
  flex: 0 0 32px;
  padding-inline: 0 !important;
  border-radius: 50% !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.runtime-card-actions .ant-btn:not(.ant-btn-circle) {
  padding-inline: 13px;
  font-weight: 700;
}
 .runtime-card-actions .runtime-action-icon {
  width: 32px !important;
  min-width: 32px !important;
  max-width: 32px !important;
  height: 32px !important;
  flex: 0 0 32px;
  padding: 0 !important;
  border-radius: 50% !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.runtime-card-actions .runtime-action-icon .anticon,
.runtime-card-actions .runtime-action-icon .ant-btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.runtime-log-drawer .ant-drawer-content {
  background: rgba(245,248,251,.98);
}
.runtime-log-drawer .ant-drawer-header {
  min-height: 52px;
  padding: 12px 18px;
  border-bottom-color: rgba(92,132,154,.16);
}
.runtime-log-drawer .ant-drawer-body {
  min-height: 0;
  padding: 0;
}
.runtime-log-drawer-block {
  height: calc(42vh - 53px);
  min-height: 180px;
  margin: 0;
  padding: 14px 18px;
  overflow: auto;
  color: #d9f7ff;
  background: #071018;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.theme-dark .runtime-log-drawer .ant-drawer-content {
  background: #101820;
}
.theme-dark .runtime-log-drawer .ant-drawer-header {
  border-bottom-color: rgba(255,255,255,.08);
}
.runtime-detail-popover,
.runtime-config-popover {
  width: min(300px, calc(100vw - 48px));
  display: grid;
  gap: 9px;
}
.runtime-detail-popover span {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.runtime-detail-popover span,
.runtime-config-popover label > span {
  color: #587085;
  font-size: 12px;
  font-weight: 780;
}
.runtime-detail-popover b {
  min-width: 0;
  color: #17364f;
  font-size: 12px;
  line-height: 1.35;
  font-weight: 760;
  overflow-wrap: anywhere;
}
.runtime-detail-models {
  min-width: 0;
  display: grid;
  gap: 6px;
}
.runtime-detail-models-label {
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.runtime-detail-models-label i {
  min-width: 20px;
  height: 20px;
  display: inline-grid;
  place-items: center;
  border-radius: 999px;
  color: #0a7aa4;
  background: rgba(10,167,216,.1);
  font-size: 10px;
  font-style: normal;
}
.runtime-detail-model-list {
  min-width: 0;
  max-height: 144px;
  display: grid;
  gap: 4px;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 7px;
  border: 1px solid rgba(92,132,154,.14);
  border-radius: 7px;
  background: rgba(99,121,138,.06);
}
.runtime-detail-model-list code {
  min-width: 0;
  color: #17364f;
  font: 600 10px/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  overflow-wrap: anywhere;
}
.runtime-detail-edit-button {
  width: 100%;
  display: flex;
  justify-content: flex-start;
  border-radius: 7px;
}
.runtime-version-list {
  display: grid;
  gap: 2px;
}
.runtime-version-list i {
  display: block;
  font-style: normal;
}
.runtime-config-popover label {
  display: grid;
  gap: 6px;
}
.runtime-config-popover .ant-input-number,
.runtime-config-popover .ant-select,
.runtime-config-popover .ant-segmented {
  width: 100%;
}
.runtime-config-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
  padding-top: 2px;
}
.theme-dark .runtime-card {
  background: rgba(255,255,255,.055);
  border-color: rgba(255,255,255,.08);
  box-shadow: 0 18px 36px rgba(0,0,0,.22);
}
.theme-dark .runtime-fact { background: rgba(255,255,255,.045); }
.theme-dark .runtime-usage-pill { color: #9bb4c3; background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.theme-dark .runtime-usage-pill.is-active { color: #76d69e; background: rgba(31,143,80,.12); border-color: rgba(31,143,80,.28); }
.theme-dark .runtime-fact span,
.theme-dark .runtime-status-dot,
.theme-dark .runtime-detail-popover span,
.theme-dark .runtime-config-popover label > span { color: #9bb4c3; }
.theme-dark .runtime-fact strong { color: #c6d3df; }
.theme-dark .runtime-fact-detail small { color: #86a1b2; }
.theme-dark .runtime-detail-popover b { color: #edf7fb; }
.theme-dark .runtime-detail-model-list { background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
.theme-dark .runtime-detail-model-list code { color: #d8eef8; }
.theme-dark .runtime-section-head h2 { color: #edf7fb; }
.theme-dark .runtime-section-title > span { color: #9bb4c3; background: rgba(255,255,255,.035); border-color: rgba(74,190,255,.14); }
@media (max-width: 1040px) {
  .runtime-tab-shell { grid-template-columns: 1fr; }
  .runtime-layout .preset-container-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .runtime-layout { padding: 14px; }
  .runtime-tab-shell { grid-template-columns: 1fr; }
  .runtime-object-tabs { grid-template-columns: 1fr; }
  .runtime-tab-intro span { white-space: normal; }
  .runtime-layout .preset-container-grid { grid-template-columns: 1fr; }
  .runtime-card-facts { grid-template-columns: 1fr; }
}

/* Deploy: card layout */
.runtime-service-card { border-radius: 14px !important; width: 380px; flex-shrink: 0; }
.runtime-service-card .ant-card-head { border-bottom: 0; padding: 4px 18px 0; min-height: 48px; }
.runtime-service-card .ant-card-head-title { font-size: 22px; font-weight: 760; }
.runtime-service-card .ant-card-body { padding: 8px 18px 18px; }
.deploy-kv-grid.compact-kv span { padding: 9px 10px; border-radius: 8px; }

.tasks-layout .task-overview .ant-card { border-radius: 8px !important; }
.tasks-layout > .glass-card:nth-of-type(1) .ant-card-head,
.tasks-layout > .task-detail-card .ant-card-head { padding: 0 16px; min-height: 56px; }
.tasks-layout .task-list.ant-list { padding: 8px; }
.tasks-layout .task-list .ant-list-item { border: 1px solid rgba(92,132,154,.12); border-radius: 8px; margin-bottom: 6px; padding: 10px !important; cursor: pointer; background: rgba(255,255,255,.45); }
.theme-dark .tasks-layout .task-list .ant-list-item { background: rgba(255,255,255,.035); }
.tasks-layout .task-list .ant-list-item.selected-row { border-color: rgba(10,167,216,.42); background: rgba(10,167,216,.1); }
.tasks-layout .task-diagnostic-panel, .tasks-layout .task-next-step-panel, .tasks-layout .task-event-block { border-radius: 8px; }


/* Publish page prototype internals */
.publish-layout .publishStepStrip { display: none; }
.publishToolHeader { display: grid; gap: 10px; padding: 12px; border: 1px solid rgba(92,132,154,.16); border-radius: 8px 8px 0 0; background: rgba(10,167,216,.055); }
.publishToolTitleRow { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.publishToolTitleRow strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.publishToolTabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
.publishToolTabButton { height: 30px; border: 1px solid rgba(92,132,154,.16); border-radius: 8px; background: rgba(255,255,255,.45); color: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
.theme-dark .publishToolTabButton { background: rgba(255,255,255,.04); }
.publishToolTabButton.isActive, .publishToolTabButton:hover { background: rgba(10,167,216,.16); color: #006b95; }
@media (max-width:1180px) {
  .publish-console-layout { grid-template-columns: 1fr; grid-template-areas: "top" "main" "side"; overflow: auto; }
  .publish-console-main { grid-template-rows: auto auto auto; overflow: auto; }
  .publish-topbar-prototype { align-items: flex-start; }
  .publish-toolbar-right { justify-content: flex-start; }
  .publish-field-grid,
  .publish-endpoint-grid { grid-template-columns: 1fr; }
  .publish-console-side { max-height: none; }
  .publish-side-stage { height: auto; }
  .libraryToolbar { align-items: flex-start; }
  .libraryToolbarActions { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
  .librarySearchField { width: min(100%, 420px); }
}


/* Dashboard and system-status prototype internals */
.overviewCards { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 10px; }
.statCard { min-height: 86px; padding: 14px 16px; border: 1px solid rgba(92,132,154,.16); border-radius: 8px; background: rgba(255,255,255,.72); display: flex; flex-direction: column; gap: 8px; justify-content: center; }
.theme-dark .statCard { background: rgba(13,24,34,.82); border-color: rgba(74,190,255,.18); }
.statCard span { color: #63798a; font-size: 12px; }
.statCard strong { color: #162d3d; font-size: 30px; line-height: 1; overflow-wrap: anywhere; }
.theme-dark .statCard strong { color: #edf7fb; }
.dashboardReadyCardMain {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.dashboardReadyCardMain strong {
  min-width: 0;
}
.dashboardReadyCardMain .ant-btn {
  flex: 0 0 auto;
  height: 28px;
  padding: 0 9px;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 700;
}
.modelPanel { min-height: 0; border: 1px solid rgba(92,132,154,.16); border-radius: var(--surface-radius); background: rgba(255,255,255,.72); overflow: hidden; }
.theme-dark .modelPanel { background: rgba(13,24,34,.82); border-color: rgba(74,190,255,.18); }
.detailPanel {
  min-height: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 8px;
  overflow: hidden;
  border: 0;
  border-left: 1px solid var(--rail-border);
  border-radius: 0;
  background: transparent;
  padding-left: 12px;
}
.theme-dark .detailPanel { background: transparent; border-left-color: rgba(74,190,255,.18); }
.panelHeader { display: flex; align-items: center; justify-content: space-between; min-height: 42px; padding: 0 14px; border-bottom: 1px solid rgba(92,132,154,.14); }
.panelHeader h2 { margin: 0; font-size: 14px; font-weight: 760; }
.modelTable { height: calc(100% - 42px); display: grid; grid-template-rows: auto minmax(0, 1fr); }
.modelTableHead, .modelTableRow { display: grid; grid-template-columns: minmax(180px, .8fr) minmax(0, 1.2fr); gap: 10px; align-items: center; padding: 10px 14px; }
.modelTableHead { color: #63798a; font-size: 12px; font-weight: 750; border-bottom: 1px solid rgba(92,132,154,.14); }
.modelTableBody { overflow: auto; }
.modelTableRow { border-bottom: 1px solid rgba(92,132,154,.1); font-size: 12px; }
.modelTableRow strong { font-weight: 650; overflow-wrap: anywhere; }
.modelTableEmpty { height: 100%; min-height: 140px; display: grid; place-items: center; color: #63798a; }
.detailPanel .panelHeader { min-height: 34px; padding: 0 2px 0 0; border-bottom: 0; }
.detailPanel .taskList { height: 100%; overflow: auto; display: grid; align-content: start; gap: 6px; padding: 0; }
.taskItem { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start; padding: 10px; border: 1px solid rgba(92,132,154,.12); border-radius: 8px; background: rgba(10,167,216,.035); color: inherit; text-align: left; cursor: pointer; }
.taskItem:hover { background: rgba(10,167,216,.09); }
.taskItem:disabled { cursor: default; opacity: 1; }
.taskItemMain { min-width: 0; display: grid; gap: 6px; }
.taskItemTitle { display: flex; gap: 7px; align-items: center; min-width: 0; }
.taskItemTitle strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.taskItem p { margin: 0; color: #63798a; font-size: 12px; line-height: 1.45; overflow-wrap: anywhere; }
.taskTypeTag, .taskTag { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 999px; font-size: 11px; font-weight: 750; }
.taskTypeTag.isDownload { color: #006b95; background: rgba(10,167,216,.12); }
.taskTypeTag.isLoad { color: #389e0d; background: rgba(82,196,26,.12); }
.taskTag { color: #63798a; background: rgba(99,121,138,.12); }
.taskTag.isError { color: #cf1322; background: rgba(255,77,79,.12); }

/* ── Dashboard 近期任务 Layout 容器 ──────────────────────────── */
.dashboardTaskPanel {
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  overflow: hidden;
  border: 1px solid rgba(92,132,154,.12);
  border-radius: 12px;
  background: rgba(245,249,252,.6);
}
.dashboardTaskPanelHead {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(92,132,154,.08);
}
.dashboardTaskPanelHead h2 { margin: 0; font-size: .84rem; font-weight: 720; }
.dashboardTaskCount {
  min-width: 22px; height: 22px; border-radius: 999px;
  background: rgba(10,167,216,.1); color: #006b95;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: .72rem; font-weight: 700; padding: 0 7px;
}
.dashboardTaskList { flex: 1; overflow: auto; display: grid; align-content: start; gap: 1px; padding: 0; background: rgba(92,132,154,.06); }
.dashboardTaskRow {
  position: relative; overflow: hidden;
  width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px; align-items: center; padding: 9px 14px;
  border: 0; background: #fff; color: inherit; text-align: left; cursor: pointer;
  transition: background .12s;
}
.dashboardTaskBeam {
  position: absolute; left: 0; top: 0; height: 2px; width: var(--task-progress, 0%);
  min-width: 10px; border-radius: 0 999px 999px 0;
  background: linear-gradient(90deg, #0aa7d8, #67e8f9, #7c8fff);
  box-shadow: 0 0 10px rgba(10,167,216,.55);
  pointer-events: none;
}
.dashboardTaskRow.hasProgressBeam::after {
  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px;
  background: rgba(10,167,216,.12); pointer-events: none;
}
.dashboardTaskRow:hover { background: rgba(10,167,216,.04); }
.dashboardTaskRowMain { min-width: 0; display: grid; gap: 5px; }
.dashboardTaskRowTop { min-width: 0; display: flex; align-items: center; gap: 8px; }
.dashboardTaskRowSide { display: grid; justify-items: end; gap: 5px; }
.dashboardTaskSummary {
  min-width: 0;
  display: grid;
  gap: 2px;
  color: #63798a;
  font-size: .72rem;
  line-height: 1.35;
  overflow: hidden;
}
.dashboardTaskSummaryLine {
  min-width: 0;
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr);
  gap: 6px;
  align-items: baseline;
}
.dashboardTaskSummaryLine span {
  color: #8a96aa;
  font-weight: 700;
}
.dashboardTaskSummaryLine b {
  min-width: 0;
  color: #526b7b;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dashboardTaskProgress { color: #63798a; font-size: .68rem; font-weight: 700; }
.dashboardTaskType {
  display: inline-flex; align-items: center; height: 20px; padding: 0 7px;
  border: 1px solid transparent; border-radius: 999px; font-size: .64rem; font-weight: 750; flex-shrink: 0;
}
.dashboardTaskType.active { color: #006b95; background: rgba(10,167,216,.1); }
.dashboardTaskType.succeeded {
  color: #79e68c;
  background: linear-gradient(180deg, rgba(55, 197, 93, .16), rgba(55, 197, 93, .10));
  border-color: rgba(89, 221, 124, .28);
  box-shadow: inset 0 1px 0 rgba(197, 255, 211, .06);
}
.dashboardTaskType.failed {
  color: #ff8589;
  background: linear-gradient(180deg, rgba(255, 77, 79, .15), rgba(255, 77, 79, .09));
  border-color: rgba(255, 104, 107, .27);
  box-shadow: inset 0 1px 0 rgba(255, 220, 220, .05);
}
.dashboardTaskType.neutral { color: #63798a; background: rgba(99,121,138,.09); }
.dashboardTaskTitle {
  font-size: .8rem; font-weight: 620; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; min-width: 0;
}
.dashboardTaskStatus {
  display: inline-flex; align-items: center; height: 20px; padding: 0 7px;
  border-radius: 999px; font-size: .64rem; font-weight: 750; flex-shrink: 0;
  color: #63798a; background: rgba(99,121,138,.09);
}
.dashboardTaskStatus.failed, .dashboardTaskStatus.canceled { color: #cf1322; background: rgba(255,77,79,.1); }
.dashboardTaskStatus.running { color: #006b95; background: rgba(10,167,216,.12); }
.dashboardTaskStatus.succeeded { color: #389e0d; background: rgba(82,196,26,.1); }
.dashboardTaskEmpty {
  display: flex; align-items: center; justify-content: center;
  min-height: 100px; color: #94a6b8; font-size: .82rem; background: #fff;
}
/* theme-dark */
.theme-dark .dashboardTaskPanel { background: rgba(8,16,24,.6); border-color: rgba(74,190,255,.1); }
.theme-dark .dashboardTaskPanelHead { border-bottom-color: rgba(74,190,255,.08); }
.theme-dark .dashboardTaskCount { background: rgba(74,190,255,.1); color: #7cc8f0; }
.theme-dark .dashboardTaskList { background: rgba(74,190,255,.04); }
.theme-dark .dashboardTaskRow { background: rgba(4,10,16,.7); }
.theme-dark .dashboardTaskRow.hasProgressBeam::after { background: rgba(74,190,255,.12); }
.theme-dark .dashboardTaskRow:hover { background: rgba(74,190,255,.06); }
.theme-dark .dashboardTaskStatus { color: #7a95ae; background: rgba(122,149,174,.1); }
.theme-dark .dashboardTaskSummary,
.theme-dark .dashboardTaskProgress { color: #9bb4c3; }
.theme-dark .dashboardTaskSummaryLine span { color: #7f95a8; }
.theme-dark .dashboardTaskSummaryLine b { color: #b9d0dc; }
@media (max-width: 1180px) {
  .dashboard-home-layout { grid-template-columns: minmax(0, 1fr); overflow: auto; }
  .dashboardTaskPanel { min-height: 280px; }
}
.statusSummaryGrid { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 10px; }
.statusGrid { display: grid; gap: 12px; }
.system-status-layout .statusCard { border-radius: 8px !important; overflow: hidden; }
.system-status-layout .resource-grid { display: grid; grid-template-columns: repeat(3, minmax(110px, 1fr)); gap: 14px; padding: 14px; }
.system-status-layout .resource-grid > div { min-height: 130px; border: 1px solid rgba(92,132,154,.12); border-radius: 8px; background: rgba(10,167,216,.035); display: grid; place-items: center; align-content: center; gap: 8px; }
.system-status-layout .ant-progress-text { font-weight: 800; }
.system-status-layout .ant-table-wrapper { padding: 10px; }
.diagnostics-kv-list { padding: 12px; }
.diagnostics-kv-list span { padding: 10px; border: 1px solid rgba(92,132,154,.12); border-radius: 8px; background: rgba(10,167,216,.035); }
.diagnostics-card-actions { padding: 0 12px 12px; }
@media (max-width: 900px) { .overviewCards, .statusSummaryGrid { grid-template-columns: repeat(2, minmax(0,1fr)); } }


/* Settings + model testing inner prototype details */
.settingsDetailBody { display: block; padding: 0; }
.settingsDetailBody > .settings-card { margin: 18px; border: 0 !important; box-shadow: none !important; background: transparent !important; }
.settingsDetailBody > .settings-card + .settings-card { margin-top: 24px; }
.settingsDetailBody > .settings-card > .ant-card-head { min-height: 34px; padding: 0 0 10px; border-bottom: 0; }
.settingsDetailBody > .settings-card > .ant-card-head .ant-card-head-title { font-size: 18px; font-weight: 760; }
.settingsDetailBody > .settings-card > .ant-card-body { padding: 0; border: 1px solid rgba(92,132,154,.16); border-radius: 8px; background: rgba(255,255,255,.72); overflow: hidden; }
.theme-dark .settingsDetailBody > .settings-card > .ant-card-body { background: rgba(13,24,34,.82); border-color: rgba(74,190,255,.18); }
.settings-row-grid, .capability-settings-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
.settings-block, .capability-setting-item { min-height: 78px; padding: 18px 20px; border: 0; border-radius: 0; background: transparent; }
.settings-block + .settings-block, .capability-setting-item + .capability-setting-item { border-top: 1px solid rgba(92,132,154,.14); }
.settings-block { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, auto); gap: 18px; align-items: center; }
.settings-block > b, .capability-setting-head b { font-size: 13px; line-height: 1.5; }
.settings-block > .ant-input-number, .settings-block > .ant-btn, .settings-block > .settings-summary, .settings-block > .muted-line, .settings-block > .settings-controls { grid-column: 2; }
.settings-block > .muted-line { grid-column: 1; margin: 4px 0 0; }
.settings-summary.compact-settings-summary { display: grid; gap: 8px; }
.settings-summary.compact-settings-summary span { padding: 0; border: 0; background: transparent; }
.settings-controls.compact-settings-controls { justify-content: flex-end; }
.settingsDetailBody .plan-alert { margin: 0; border-radius: 0; border-left: 0; border-right: 0; border-bottom: 0; }
.capability-settings-intro { padding: 0 0 10px; }
.capability-settings-grid { border-top: 1px solid rgba(92,132,154,.14); }
.capability-setting-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; align-items: center; }
.capability-setting-item p { min-height: 0; margin: 4px 0 0; grid-column: 1; }
.capability-setting-metrics, .capability-setting-actions { grid-column: 2; grid-row: 1 / span 2; }
.capability-setting-metrics { min-width: 150px; }
.capability-setting-actions { align-self: end; justify-content: flex-end; }

.chat-test-layout .playground-control-card { border: 0 !important; box-shadow: none !important; background: transparent !important; }
.chat-test-layout .playground-control-card > .ant-card-head { display: none; }
.chat-test-layout .playground-control-card > .ant-card-body { min-height: 100%; display: grid; align-content: start; padding: 0; }
.chat-test-layout .playground-control-card .ant-tabs { border-radius: 14px; overflow: hidden; }
.chat-test-layout .playground-control-card .ant-tabs-nav { margin: 0; padding: 0 12px; min-height: 42px; }
.chat-test-layout .playground-control-card .ant-tabs-content-holder { padding: 16px; }
.chat-test-layout .playground-result-card { border-radius: 14px !important; }
.chat-test-layout .playground-chat-transcript { min-height: 0; display: none; }

/* statusCard — System Status */
.statusCard { border: 1px solid rgba(92,132,154,.16); border-radius: var(--surface-radius); background: rgba(255,255,255,.5); overflow: hidden; box-shadow: 0 14px 28px rgba(16,28,56,.08); }
.statusCard > span { display: block; padding: 14px 14px 0; font-size: 11px; color: #8a96aa; }
.statusCard > b { display: block; padding: 4px 14px 0; font-size: 1rem; color: #1a2433; }
.statusCard > small { display: block; padding: 4px 14px 14px; font-size: 11px; color: #8a96aa; }
.resourceItem { text-align: center; }
.resourceName { font-size: 14px; font-weight: 700; color: #1a2433; }
.theme-dark .statusCard { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); box-shadow: 0 16px 32px rgba(0,0,0,.22); }
.theme-dark .statusCard > b, .theme-dark .resourceName { color: #f3f4f6; }
.theme-dark .statusCard > small { color: #818793; }

/* ── Welcome / Dashboard prototype ────────────────────────────────── */
.homeBanner {
  position: relative; display: flex; align-items: center; min-height: 120px;
  padding: 16px 20px; overflow: hidden; border-radius: 12px;
  border: 1px solid rgba(92,132,154,.16);
  background: linear-gradient(90deg, rgba(53,85,230,.08), rgba(62,209,255,.02)), rgba(255,255,255,.4);
}
.homeBanner::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(circle at 75% 35%, rgba(62,209,255,.14), transparent 22%),
              radial-gradient(circle at 85% 70%, rgba(130,82,241,.14), transparent 28%);
}
.homeBannerInner, .homeBannerDecor { position: relative; z-index: 1; }
.homeBannerEyebrow { display: inline-block; color: #0aa7d8; font-size: 11px; font-weight: 700; letter-spacing: .08em; }
.homeBanner h1 { margin: 6px 0 8px; font-size: 28px; line-height: 1; }
.homeBanner p { max-width: 420px; margin: 0; font-size: 12px; color: #526b7b; }
.homeBannerDecor {
  position: absolute; right: 24px; top: 18px; width: 180px; height: 76px;
  display: flex; align-items: flex-end; justify-content: flex-end;
  padding: 10px 12px;
  border: 1px dashed rgba(0,0,0,.08); border-radius: 14px;
  background: linear-gradient(135deg, rgba(255,255,255,.03), rgba(255,255,255,.01)),
              radial-gradient(circle at 72% 36%, rgba(62,209,255,.12), transparent 28%);
}
.runtime-layout .homeBannerDecor {
  inset: 0;
  width: auto; height: auto;
  padding: 0; border: 0; border-radius: 0;
  background: transparent;
  pointer-events: none;
}
.runtimeBannerMeta {
  position: absolute; right: 24px; bottom: 18px; z-index: 1;
  display: flex; flex-direction: column; gap: 3px; align-items: flex-start;
  min-width: 132px;
  font-size: 12px; line-height: 1.35; font-weight: 600; padding: 8px 12px;
  border: 1px solid rgba(0,0,0,.06); border-radius: 12px;
  color: #63798a; background: rgba(255,255,255,.68);
}
.runtimeBannerMeta span { display: block; white-space: nowrap; }
.theme-dark .runtimeBannerMeta { color: #b9bdc6; border-color: rgba(255,255,255,.06); background: rgba(18,24,36,.36); }
.theme-dark .homeBanner { background: linear-gradient(90deg, rgba(53,85,230,.08), rgba(62,209,255,.02)), rgba(255,255,255,.03); border-color: rgba(74,190,255,.18); }
.theme-dark .homeBanner p { color: #b9bdc6; }
.theme-dark .homeBannerDecor { border-color: rgba(255,255,255,.08); }
.theme-dark .homeBannerEyebrow { color: #67e8f9; }
.dashboardHomeMain .homeBannerDecor {
  right: 22px; top: auto; bottom: 16px; width: auto; height: auto;
  padding: 0; border: 0; border-radius: 0; background: transparent;
}
.dashboardBannerMeta { display: flex; justify-content: flex-end; align-items: flex-end; width: 100%; text-align: right; }
.dashboardBannerMeta .ant-tag { margin-inline-end: 0; border-radius: 999px; font-weight: 700; }
.dashboardConsoleChip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-height: 28px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.68);
  color: #4f6275;
  font-size: 12px;
  box-shadow: inset 0 0 0 1px rgba(92,132,154,.14);
  transform: scale(0.7);
  transform-origin: right center;
}
.dashboardConsoleChip b { color: #1a2433; font-weight: 700; }
.theme-dark .dashboardConsoleChip { background: rgba(7,12,18,.42); color: #bdd4df; box-shadow: inset 0 0 0 1px rgba(74,190,255,.16); }
.theme-dark .dashboardConsoleChip b { color: #edf7fb; }

/* overviewCards */
.overviewCards { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 12px; flex: none; }
.statCard { padding: 14px 16px; border-radius: var(--surface-radius); border: 1px solid rgba(92,132,154,.16); }
.statCard span { display: block; font-size: 11px; color: #8a96aa; }
.statCard strong { display: block; margin-top: 10px; font-size: 26px; color: #1a2433; }
.theme-dark .statCard { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); }
.theme-dark .statCard span { color: #818793; }
.theme-dark .statCard strong { color: #f3f4f6; }
.dashboardReadyCardMain strong { margin-top: 0; }
.dashboardReadyCardMain .ant-btn { white-space: nowrap; }
.dashboardDownloadButton,
.dashboardReadyCardMain .dashboardDownloadButton.ant-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #0a7fab;
  border-color: rgba(10,127,171,.42);
  background: transparent;
  box-shadow: none;
}
.dashboardDownloadButton .anticon {
  margin-inline-end: 0 !important;
  font-size: 13px;
}
.dashboardDownloadButton:hover,
.dashboardReadyCardMain .dashboardDownloadButton.ant-btn:hover {
  color: #006b95;
  border-color: rgba(10,167,216,.72);
  background: rgba(10,167,216,.06);
}
.theme-dark .dashboardDownloadButton,
.theme-dark .dashboardReadyCardMain .dashboardDownloadButton.ant-btn {
  color: #7dd3fc;
  border-color: rgba(125,211,252,.42);
  background: transparent;
}
.theme-dark .dashboardDownloadButton:hover,
.theme-dark .dashboardReadyCardMain .dashboardDownloadButton.ant-btn:hover {
  color: #b8ecff;
  border-color: rgba(125,211,252,.7);
  background: rgba(74,190,255,.08);
}

/* resourcePanel */
.resourcePanel { flex: none; overflow: hidden; border-radius: 12px; border: 1px solid rgba(92,132,154,.16); }
.resourceGrid { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 6px; padding: 12px 10px 10px; }
.resourceCard { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 12px 8px; }
.resourceMeta { font-size: 12px; color: #63798a; }
.theme-dark .resourcePanel { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); }
.theme-dark .resourceMeta { color: #818793; }

/* panelHeader / modelTable */
.panelHeader { display: flex; align-items: center; justify-content: space-between; min-height: 42px; padding: 0 14px; border-bottom: 1px solid rgba(92,132,154,.14); }
.panelHeader h2 { margin: 0; font-size: 14px; font-weight: 760; }
.modelPanel { display: flex; flex-direction: column; min-height: 0; overflow: hidden; border-radius: 14px; border: 1px solid rgba(92,132,154,.16); }
.modelTable { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; }
.modelTableHead, .modelTableRow { display: grid; grid-template-columns: minmax(180px,.8fr) minmax(0,1.2fr); gap: 10px; align-items: center; padding: 10px 14px; }
.modelTableHead { font-size: 12px; font-weight: 750; color: #63798a; border-bottom: 1px solid rgba(92,132,154,.14); }
.modelTableBody { overflow: auto; min-height: 100px; }
.modelTableRow { border-bottom: 1px solid rgba(92,132,154,.1); font-size: 12px; }
.modelTableRow strong { font-weight: 650; overflow-wrap: anywhere; }
.modelTableEmpty { height: 100%; min-height: 140px; display: grid; place-items: center; color: #63798a; }
.emptyBoxIcon { width: 40px; height: 40px; border-radius: 8px; border: 2px dashed rgba(99,121,138,.2); }
.theme-dark .modelPanel { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); }
.theme-dark .panelHeader { border-bottom-color: rgba(74,190,255,.1); }
.theme-dark .modelTableHead { border-bottom-color: rgba(74,190,255,.1); }
.theme-dark .modelTableRow { border-bottom-color: rgba(74,190,255,.08); }
.theme-dark .emptyBoxIcon { border-color: rgba(255,255,255,.08); }

/* detailPanel / taskList */
.detailPanel { display: flex; flex-direction: column; min-height: 0; overflow: hidden; border-radius: 14px; border: 1px solid rgba(92,132,154,.16); }
.detailPanel .taskList { overflow: auto; display: grid; align-content: start; gap: 8px; padding: 10px; }
.taskItem { width: 100%; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 10px; align-items: start; padding: 10px; border: 1px solid rgba(92,132,154,.12); border-radius: 12px; color: inherit; text-align: left; cursor: pointer; background: transparent; }
.taskItem:hover { background: rgba(10,167,216,.06); }
.taskItemMain { min-width: 0; display: grid; gap: 6px; }
.taskItemTitle { display: flex; gap: 7px; align-items: center; min-width: 0; }
.taskItemTitle strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
.taskItem p { margin: 0; font-size: 12px; line-height: 1.45; color: #63798a; overflow-wrap: anywhere; }
.taskTypeTag, .taskTag { display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 999px; font-size: 10px; font-weight: 700; }
.taskTypeTag.isDownload { color: #006b95; background: rgba(10,167,216,.12); }
.taskTypeTag.isLoad { color: #389e0d; background: rgba(82,196,26,.12); }
.taskTag { color: #63798a; background: rgba(99,121,138,.1); border: 1px solid rgba(99,121,138,.16); }
.taskTag.isError { color: #cf1322; background: rgba(255,77,79,.12); border-color: rgba(255,77,79,.3); }
.theme-dark .detailPanel { border-color: rgba(74,190,255,.14); background: rgba(255,255,255,.03); }
.theme-dark .taskItem { border-color: rgba(74,190,255,.1); }
.theme-dark .taskItem p { color: #b9bdc6; }
.theme-dark .taskTag { color: #b9bdc6; background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.08); }

/* Dashboard: stat card layout */
.home-stat-grid .glass-card { border-radius: 14px !important; }
.home-stat { min-height: 82px; display: grid; align-content: center; gap: 8px; padding: 4px; }
.home-stat span { font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
.home-stat b { font-size: 32px; line-height: 1; font-weight: 760; }
.prototype-chat-list .ant-input { margin: 4px 0 10px; }
.prototype-chat-list > .ant-btn { margin-bottom: 10px; }

@media (max-width: 760px) {
  .settings-block, .capability-setting-item { grid-template-columns: 1fr; }
  .settings-block > .ant-input-number, .settings-block > .ant-btn, .settings-block > .settings-summary, .settings-block > .settings-controls,
  .capability-setting-metrics, .capability-setting-actions { grid-column: 1; grid-row: auto; justify-content: flex-start; }
}


/* Strict prototype side navigation */
.sidebar.sideNav {
  padding: 0;
  gap: 0;
  overflow: hidden;
  border-right: 1px solid rgba(92,132,154,.18);
  background: linear-gradient(180deg, rgba(247,251,253,.98), rgba(255,255,255,.92));
}
.theme-dark .sidebar.sideNav { background: linear-gradient(180deg, #071016, #0d1822); border-right-color: rgba(74,190,255,.18); }
.sideNavHeader { position: relative; display: flex; align-items: center; gap: 12px; min-height: 68px; padding: 0 18px; border-bottom: 1px solid rgba(92,132,154,.14); }
.sideNavMiniLogo { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: rgba(10,167,216,.12); overflow: hidden; }
.sideNavMiniLogo img { width: 22px; height: 22px; object-fit: contain; }
.sideNavHeaderText { display: flex; flex-direction: column; min-width: 0; }
.sideNavHeaderText strong { font-size: 13px; line-height: 1.2; }
.sideNavHeaderText span { margin-top: 3px; color: #63798a; font-size: 10px; letter-spacing: .08em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.theme-dark .sideNavHeaderText span { color: #9bb4c3; }
.sideNavVersion { position: absolute; right: 14px; bottom: 9px; color: #7a8fa0; font-size: 9px; line-height: 1; letter-spacing: .02em; white-space: nowrap; }
.theme-dark .sideNavVersion { color: #82a4b6; }
.sideNavMenu { display: flex; flex-direction: column; gap: 6px; padding: 12px 10px; min-height: 0; }
.sideNavItem { display: flex; align-items: center; gap: 12px; width: 100%; height: 40px; padding: 0 14px; border: 0; border-radius: 10px; color: #294253; text-decoration: none; background: transparent; cursor: pointer; }
.theme-dark .sideNavItem { color: #cfe7f2; }
.sideNavItem:hover, .sideNavItem.isActive { color: #005d82; background: rgba(10,167,216,.12); }
.theme-dark .sideNavItem:hover, .theme-dark .sideNavItem.isActive { color: #fff; background: rgba(10,167,216,.18); }
.sideNavIcon { flex: none; width: 18px; height: 18px; display: block; background-color: currentColor; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center; -webkit-mask-size: contain; mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
.sideNavIcon.dashboard { -webkit-mask-image: url('/prototype-icons/dashboard.svg'); mask-image: url('/prototype-icons/dashboard.svg'); }
.sideNavIcon.modelTest { -webkit-mask-image: url('/prototype-icons/model-test.svg'); mask-image: url('/prototype-icons/model-test.svg'); }
.sideNavIcon.modelPublish { -webkit-mask-image: url('/prototype-icons/model-publish.svg'); mask-image: url('/prototype-icons/model-publish.svg'); }
.sideNavIcon.modelLibrary { -webkit-mask-image: url('/prototype-icons/model-library.svg'); mask-image: url('/prototype-icons/model-library.svg'); }
.sideNavIcon.runtime { -webkit-mask-image: url('/prototype-icons/runtime.svg'); mask-image: url('/prototype-icons/runtime.svg'); }
.sideNavIcon.systemStatus { -webkit-mask-image: url('/prototype-icons/system-status.svg'); mask-image: url('/prototype-icons/system-status.svg'); }
.sideNavIcon.tasks { -webkit-mask-image: url('/prototype-icons/tasks.svg'); mask-image: url('/prototype-icons/tasks.svg'); }
.sideNavIcon.settings { -webkit-mask-image: url('/prototype-icons/settings.svg'); mask-image: url('/prototype-icons/settings.svg'); }
.sideNavLabel { font-size: 13px; font-weight: 650; white-space: nowrap; }
.sideNavFooter { margin-top: auto; display: flex; flex-direction: column; gap: 4px; padding: 12px 10px 16px; color: #63798a; font-size: 10px; border-top: 1px solid rgba(92,132,154,.14); }
.theme-dark .sideNavFooter { color: #9bb4c3; border-top-color: rgba(74,190,255,.14); }
.sideNavFooterItem { margin-bottom: 8px; }
.sideNav.isCollapsed .sideNavHeader { justify-content: center; padding: 0 10px; }
.sideNav.isCollapsed .sideNavHeaderText, .sideNav.isCollapsed .sideNavLabel, .sideNav.isCollapsed .sideNavVersion { display: none; }
.sideNav.isCollapsed .sideNavItem, .sideNav.isCollapsed .sideNavFooterItem { justify-content: center; padding: 0; }
.sideNav.isCollapsed .sideNavFooter { padding: 12px 10px 16px; }
.sideNav.isCollapsed .sideNavMenu { padding-inline: 10px; }


/* Shell toolbar final prototype tightening */
.shell-titlebar { height: 24px; grid-template-columns: 240px minmax(0, 1fr) 140px; padding: 0 10px; background: #006b95; }
.shell-titlegroup { gap: 6px; }
.shell-titlegroup img { width: 13px; height: 13px; }
.shell-titlegroup strong { font-size: 11px; font-weight: 750; letter-spacing: .04em; }
.shell-window-actions { gap: 12px; font-size: 11px; }
.shell-toolbar { min-height: 48px; grid-template-columns: 44px minmax(0, 1fr) auto; }
.shell-toolbar-left { width: 44px; }
.shell-sidebar-dock { width: 18px; height: 18px; border-radius: 5px; }
.shell-sidebar-dock::before { left: 4px; top: 3px; bottom: 3px; width: 3px; }
.shell-sidebar-dock.is-collapsed::before { left: 10px; }
.shell-model-picker { width: min(540px, 100%); height: 30px; border-radius: 9px; background: rgba(10,167,216,.065); }
.shell-model-picker span { font-size: 12px; }
.shell-model-picker kbd { font-size: 10px; height: 20px; display: inline-flex; align-items: center; }
.shell-toolbar-right { gap: 12px; padding-right: 12px; }
.shell-toolbar-right .ant-btn-circle { width: 30px; min-width: 30px; height: 30px; }
.shell-switch.ant-switch { min-width: 58px; height: 26px; }
.shell-switch.ant-switch .ant-switch-inner { font-size: 11px; font-weight: 700; }
.shell-downloads-panel { top: 82px; right: 12px; width: min(390px, calc(100vw - 24px)); border-radius: 10px; }
.shell-download-row { grid-template-columns: 28px minmax(0,1fr) auto; border-radius: 8px; }
.shell-download-glyph { width: 28px; height: 28px; border-radius: 7px; }

/* Final page-by-page alignment pass */
.dashboard-home-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
  grid-template-rows: minmax(0, 1fr);
  gap: 14px;
  overflow: hidden;
}
.dashboard-home-layout.is-right-panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
}
.dashboardHomeMain {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: auto auto 196px minmax(0, 1fr);
  gap: 14px;
  overflow: hidden;
}
.dashboardHomeMain .homeBanner,
.dashboardHomeMain .resourcePanel,
.dashboardHomeMain .modelPanel { min-width: 0; }
.dashboardHomeMain .resourcePanel { min-height: 0; height: 196px; }
.dashboardHomeMain .modelPanel { min-height: 0; height: 100%; }
.dashboardHomeMain .modelTable { min-height: 0; }
.dashboardHomeMain .modelTableBody { min-height: 0; }

.system-status-layout {
  display: grid;
  grid-template-rows: 120px minmax(0, 1fr);
  overflow: hidden;
}
.system-status-layout .homeBanner { min-height: 120px; }
.systemStatusGrid {
  min-height: 0;
  overflow: auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(320px, 1fr));
  grid-template-rows: minmax(340px, auto) minmax(210px, auto);
  gap: 12px;
  align-content: start;
}
.systemStatusGrid .statusCard {
  min-width: 0;
  min-height: 210px;
  display: flex;
  flex-direction: column;
}
.systemStatusGrid .statusCard:nth-child(-n + 2) { min-height: 340px; }
.systemStatusGrid .panelHeader { flex: none; }
.systemResourceGrid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(92px, 1fr));
  grid-template-rows: repeat(2, minmax(128px, 1fr));
  gap: 14px;
  padding: 14px;
}
.systemResourceGrid .resourceItem {
  min-width: 0;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 8px;
  padding: 10px 6px;
  border-radius: 8px;
  border: 1px solid rgba(92,132,154,.12);
  background: rgba(10,167,216,.035);
  text-align: center;
}
.thermalResourceItem {
  grid-column: span 2;
  place-items: stretch !important;
  align-content: stretch !important;
  padding: 12px 14px !important;
  text-align: left !important;
}
.thermalHeader {
  min-width: 0;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10px;
  align-items: baseline;
}
.thermalHeader small {
  min-width: 0;
  overflow: hidden;
  color: #63798a;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.thermalSensorList {
  width: 100%;
  display: grid;
  gap: 7px;
  align-content: center;
}
.thermalSensorList > span {
  --thermal-percent: 0%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(86px, .72fr) minmax(100px, 1fr) 54px 46px;
  gap: 8px;
  align-items: center;
}
.thermalSensorList small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #63798a;
}
.thermalSensorList i {
  position: relative;
  display: block;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(99,121,138,.15);
}
.thermalSensorList i::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: var(--thermal-percent);
  border-radius: inherit;
  background: linear-gradient(90deg, #31c5ff, #67e8f9 56%, #fbbf24);
}
.thermalSensorList b {
  width: 54px;
  color: #1a2433;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.thermalSensorList em.isEmpty { visibility: hidden; }
.thermalSensorList em {
  width: 46px;
  color: #63798a;
  font-size: 11px;
  font-style: normal;
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.systemPortCard { min-height: 0; }
.systemPortTable { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 10px; }
.systemPortTable .tableHeader { flex: 0 0 auto; }
.systemPortTable .tableBody { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
.systemPortTable .tableRow {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128px 76px;
  gap: 8px;
  align-items: center;
  min-height: 34px;
  padding: 0 10px;
  font-size: 12px;
  border-bottom: 1px solid rgba(92,132,154,.08);
}
.systemPortTable .tableHeader {
  color: #63798a;
  font-weight: 750;
  border-bottom-color: rgba(92,132,154,.14);
}
.systemPortTable .tableRow > span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.systemPortTable .tableRow > span:nth-child(2) {
  overflow: visible;
  text-overflow: clip;
  text-align: left;
  font-variant-numeric: tabular-nums;
}
.systemPortTable .tableRow > span:nth-child(2) small { color: #63798a; }
.portNameCell {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.portNameCell b {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 650;
}
.portNameCell em {
  flex: none;
  padding: 1px 5px;
  border-radius: 999px;
  color: #0a7a42;
  background: rgba(31,143,80,.10);
  font-size: 10px;
  font-style: normal;
  font-weight: 760;
}
.statusBadge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  min-height: 22px;
  padding: 0 8px;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 650;
}
.statusBadge.isReady { color: #389e0d; background: rgba(82,196,26,.12); }
.statusBadge.isBusy { color: #cf1322; background: rgba(255,77,79,.12); }
.statusBadge.isNeutral { color: #63798a; background: rgba(99,121,138,.12); }
.systemInfoGrid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  padding: 12px;
}
.systemInfoGrid .infoItem {
  min-width: 0;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid rgba(92,132,154,.12);
  background: rgba(10,167,216,.025);
}
.systemInfoGrid .infoLabel {
  display: block;
  color: #63798a;
  font-size: 11px;
  line-height: 1.4;
}
.systemInfoGrid strong {
  display: block;
  margin-top: 4px;
  font-size: .84rem;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.systemActionRow {
  flex: none;
  display: flex;
  gap: 8px;
  padding: 0 12px 12px;
  flex-wrap: wrap;
}

.tasks-layout {
  overflow: hidden;
}
.tasks-layout .taskBanner p {
  max-width: 460px;
  margin: 0;
  color: #526b7b;
  font-size: 12px;
  line-height: 1.5;
}
.taskMonitorPanel,
.taskLogPanel { min-height: 0; overflow: hidden; }
.taskMonitorPanel .ant-card-body {
  height: calc(100% - 44px);
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.taskMonitorPanel .muted-line { flex: none; }
.taskMonitorPanel .task-list { flex: 1; min-height: 0; overflow: auto; }
.taskLogPanel .log-toolbar { margin-bottom: 10px; }
.taskLogPanel .log-block { min-height: 180px; }

/* Tasks compact log and flat list final override */
.tasks-layout > .glass-card:nth-of-type(1) .ant-card-head,
.tasks-layout > .task-detail-card .ant-card-head { padding: 0 12px; min-height: 40px; }
.tasks-layout > .glass-card:nth-of-type(1) .ant-card-body,
.tasks-layout > .task-detail-card .ant-card-body { padding: 10px 12px; }
.taskMonitorPanel .ant-card-body { height: calc(100% - 40px); }
.taskMonitorPanel .muted-line { flex: none; margin: 0 0 8px; }
.task-panel-tabs { flex: none; min-height: 34px; margin-bottom: 8px; }
.task-panel-tabs .ant-tabs-nav { margin: 0; min-height: 34px; }
.task-panel-tabs .ant-tabs-nav::before { border-bottom-color: rgba(92,132,154,.14); }
.task-panel-tabs .ant-tabs-tab { padding: 7px 0; font-size: 12px; font-weight: 700; }
.task-panel-tabs .ant-tabs-content-holder { display: none; }
.tasks-layout .taskMonitorPanel .ant-empty { margin: 44px 0; color: #63798a; }
.theme-dark .task-panel-tabs .ant-tabs-nav::before { border-bottom-color: rgba(74,190,255,.14); }
.theme-dark .tasks-layout .taskMonitorPanel .ant-empty { color: #9bb4c3; }
.tasks-layout .task-list.ant-list { padding: 0; border: 0; border-radius: 0; background: transparent; overflow: auto; }
.tasks-layout .taskMonitorPanel .task-list.ant-list,
.tasks-layout .taskMonitorPanel .ant-list.task-list { padding: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; }
.tasks-layout .task-list .ant-list-item { margin-bottom: 0; padding: 9px 10px !important; border: 0; border-bottom: 1px solid rgba(92,132,154,.1); border-radius: 0 !important; background: transparent; cursor: pointer; }
.tasks-layout .task-list .ant-list-item:last-child { border-bottom: 0; }
.tasks-layout .task-list .ant-list-item:hover { background: rgba(10,167,216,.055); }
.tasks-layout .task-list .ant-list-item.selected-row { border-color: rgba(92,132,154,.1); background: rgba(10,167,216,.1); }
.tasks-layout .task-list .ant-list-item.task-failed-row { box-shadow: inset 3px 0 0 #ff4d4f; }
.theme-dark .tasks-layout .task-list.ant-list { background: transparent; }
.theme-dark .tasks-layout .task-list .ant-list-item { border-bottom-color: rgba(74,190,255,.09); background: transparent; }
.theme-dark .tasks-layout .task-list .ant-list-item:hover { background: rgba(74,190,255,.06); }
.theme-dark .tasks-layout .task-list .ant-list-item.selected-row { background: rgba(74,190,255,.1); }
.taskLogPanel .ant-card-body { height: calc(100% - 40px); min-height: 0; overflow: hidden; display: flex; flex-direction: column; }
.taskLogPanel .log-toolbar { justify-content: flex-end; margin-bottom: 8px; min-height: 26px; }
.taskLogPanel .log-block,
.taskLogPanel .task-log-tail { flex: 1; min-height: 0; max-height: none; margin: 0; overflow: auto; }

.tasks-layout.right-panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
  grid-template-areas:
    "banner"
    "summary"
    "list";
}
.tasks-layout.right-panel-expanded {
  grid-template-columns: minmax(420px, 1fr) minmax(420px, 1fr);
  grid-template-areas:
    "banner log"
    "summary log"
    "list log";
}
.tasks-layout.right-panel-expanded .taskLogPanel {
  height: 100%;
  align-self: stretch;
}
.tasks-layout.right-panel-expanded .taskBanner,
.tasks-layout.right-panel-expanded .task-overview,
.tasks-layout.right-panel-expanded .taskMonitorPanel {
  min-width: 0;
}
.tasks-layout.right-panel-collapsed .taskMonitorPanel { height: 100%; }

.settingsWorkbench {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}
.settingsWorkbench .settingsDetailBody {
  display: block;
  min-height: 0;
  overflow: auto;
  padding: 18px 22px 28px;
}
.settingsWorkbench .settingsPanel.isActive {
  width: 100%;
  max-width: 920px;
}
.settingsWorkbench .settingsDetailHeader {
  min-height: 76px;
  align-items: center;
}
.settingsWorkbench .settingsDetailHeader p {
  color: #63798a;
  font-size: 13px;
}
.theme-dark .systemResourceGrid .resourceItem,
.theme-dark .systemInfoGrid .infoItem {
  border-color: rgba(74,190,255,.12);
  background: rgba(255,255,255,.035);
}
.theme-dark .thermalHeader small,
.theme-dark .thermalSensorList small,
.theme-dark .thermalSensorList em { color: #9bb4c3; }
.theme-dark .thermalSensorList b { color: #f3f7fb; }
.theme-dark .thermalSensorList i { background: rgba(74,190,255,.10); }
.theme-dark .systemPortTable .tableRow { border-bottom-color: rgba(74,190,255,.08); }
.theme-dark .systemPortTable .tableHeader,
.theme-dark .systemInfoGrid .infoLabel,
.theme-dark .tasks-layout .taskBanner p,
.theme-dark .settingsWorkbench .settingsDetailHeader p { color: #9bb4c3; }
@media (max-width: 980px) {
  .systemStatusGrid { grid-template-columns: 1fr; grid-template-rows: none; }
  .settingsWorkbench { grid-template-columns: 1fr; overflow: auto; }
  .settingsWorkbench .settingsNavigator { border-right: 0; border-bottom: 1px solid rgba(92,132,154,.18); }
}
@media (max-width: 680px) {
  .systemResourceGrid,
  .systemInfoGrid { grid-template-columns: 1fr; }
  .thermalResourceItem { grid-column: auto; }
  .thermalSensorList > span { grid-template-columns: minmax(0, 1fr) 72px auto; }
  .thermalSensorList em { display: none; }
}

/* Dark readability and publish replica corrections */
.theme-dark .workspace,
.theme-dark .prototype-page,
.theme-dark .contentPanel {
  color: #edf7fb;
}
.theme-dark :is(
  .homeBanner h1,
  .homeBanner h2,
  .prototype-banner h1,
  .panelHeader h2,
  .statCard strong,
  .resourceName,
  .modelTableRow strong,
  .statusCard b,
  .statusCard strong,
  .taskListTitleRow strong,
  .task-detail-card strong,
  .settingsDetailHeader h1,
  .settingsNavigatorHeader,
  .settingLabel,
  .publish-stage-header strong,
  .publish-side-heading strong,
  .publish-side-card-title strong,
  .publish-api-usage-card > strong,
  .publish-endpoint-cell strong,
  .publish-side-model-meta strong,
  .publish-copy-field b,
  .publish-info-row strong
) {
  color: #f3f7fb !important;
}
.theme-dark :is(
  .homeBanner p,
  .prototype-banner p,
  .statCard span,
  .panelHeader p,
  .resourceMeta,
  .modelTableHead span,
  .muted-line,
  .settingDesc,
  .settingsDetailHeader p,
  .task-meta,
  .taskListItemSummary,
  .publish-loaded-empty,
  .publish-toolbar-label,
  .publish-loaded-runtime,
  .publish-loaded-runtime small,
  .publish-endpoint-strip,
  .publish-info-row span,
  .publish-api-usage-card label > span,
  .publish-field-block span,
  .publish-endpoint-cell span,
  .publish-side-model-meta span
) {
  color: #9bb4c3 !important;
}
.theme-dark .load-model-current b { color: #edf7fb !important; }
.theme-dark .ant-empty-description { color: #9bb4c3 !important; }
.theme-dark .publish-console-layout {
  background: #091018;
}
.publish-console-layout {
  grid-template-columns: minmax(720px, 1fr) 260px;
  column-gap: 14px;
  row-gap: 0;
}
.publish-console-main {
  margin: 10px 8px 0 0;
  padding-right: 8px;
  border-right: 1px solid rgba(92,132,154,.12);
}
.publish-console-side {
  border-left: 0;
  padding: 14px 16px 14px 12px;
}
.publish-topbar-prototype {
  min-height: 46px;
  margin: 0 8px 0 0;
  padding: 0 10px;
  border-radius: 12px;
}
.publish-log-stage,
.publish-loaded-stage,
.publish-api-usage-card {
  border-radius: 12px;
}
.publish-loaded-body { padding: 10px 8px 8px; }
.publish-loaded-empty {
  min-height: 170px;
  border: 1px dashed rgba(92,132,154,.18);
  border-radius: 10px;
  background: rgba(99,121,138,.035);
}
.theme-dark .publish-topbar-prototype,
.theme-dark .publish-log-stage,
.theme-dark .publish-loaded-stage,
.theme-dark .publish-api-usage-card {
  background: linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.01));
  border-color: #2f3239;
}
.theme-dark .publish-loaded-empty {
  border-color: rgba(255,255,255,.08);
  background: rgba(255,255,255,.025);
}
.theme-dark .publish-status-pill,
.theme-dark .publish-url-button,
.theme-dark .publish-mode-tab,
.theme-dark .publish-loaded-stats > span,
.theme-dark .publish-copy-field b,
.theme-dark .publish-copy-field button {
  color: #edf7fb;
  background: rgba(255,255,255,.03);
  border-color: #2f3239;
}
.theme-dark .publish-mode-tab.is-active {
  color: #ffffff !important;
  background: rgba(76,131,255,.16);
  border-color: rgba(76,131,255,.35);
}
.theme-dark .publish-card-arrow,
.theme-dark .chatPanelIcon { color: #b9bec8; }
@media (max-width: 980px) {
  .publish-console-layout { grid-template-columns: minmax(0, 1fr); }
  .publish-console-main { border-right: 0; margin-right: 14px; padding-right: 0; }
  .publish-topbar-prototype { margin-right: 14px; }
}

/* Publish log bottom drawer */
.publish-console-main {
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow: hidden;
}
.publish-loaded-stage,
.publish-plan-preview {
  flex: 0 0 auto;
}
.publish-log-stage {
  flex: 0 0 40px;
  min-height: 40px;
  max-height: 40px;
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-content: normal;
  transition: flex-basis .18s ease, max-height .18s ease, box-shadow .18s ease;
}
.publish-log-stage .publish-stage-header {
  flex: 0 0 38px;
  cursor: pointer;
  user-select: none;
}
.publish-log-stage.is-collapsed .publish-stage-header {
  border-bottom: 0;
}
.publish-log-stage.is-expanded {
  flex-basis: min(42vh, 380px);
  max-height: 380px;
  box-shadow: 0 -14px 32px rgba(8,16,24,.12);
}
.publish-log-stage.is-expanded .publish-console-log {
  flex: 1;
  min-height: 0;
  height: auto;
  overflow: auto;
}
.theme-dark .publish-log-stage.is-expanded {
  box-shadow: 0 -16px 34px rgba(0,0,0,.26);
}

/* Dark model library table and runtime detail corrections */
.theme-dark .shell-toolbar,
.theme-dark .shell-toolbar-right,
.theme-dark .toolbarIconButton {
  color: #edf7fb;
}
.theme-dark .model-library-table .ant-table,
.theme-dark .model-library-table .ant-table-container,
.theme-dark .model-library-table .ant-table-content,
.theme-dark .model-library-table table {
  color: #edf7fb !important;
  background: transparent !important;
}
.theme-dark .model-library-table .ant-table-thead > tr > th {
  color: #9bb4c3 !important;
  background: rgba(10,167,216,.10) !important;
  border-bottom-color: rgba(74,190,255,.12) !important;
}
.theme-dark .model-library-table .ant-table-tbody > tr,
.theme-dark .model-library-table .ant-table-tbody > tr > td {
  color: #edf7fb !important;
  background: rgba(255,255,255,.018) !important;
  border-bottom-color: rgba(74,190,255,.08) !important;
}
.theme-dark .model-library-table .ant-table-tbody > tr:hover > td,
.theme-dark .model-library-table .ant-table-tbody > tr.selected-library-model > td {
  color: #ffffff !important;
  background: rgba(10,167,216,.11) !important;
}
.theme-dark .model-library-table :is(.table-model-name, .table-compact-text, .ant-table-cell, td > span) {
  color: #edf7fb !important;
}
.theme-dark .model-library-table .table-model-path {
  color: #9bb4c3 !important;
}
.theme-dark .model-library-table .ant-table-placeholder,
.theme-dark .model-library-table .ant-empty-description {
  color: #9bb4c3 !important;
  background: transparent !important;
}
.theme-dark .modelDetailSectionHead h3,
.theme-dark .modelDetailKvRow strong,
.theme-dark .modelDetailTaskName {
  color: #edf7fb !important;
}
.theme-dark .modelDetailKvRow span,
.theme-dark .modelDetailNote,
.theme-dark .modelDetailEmpty {
  color: #9bb4c3 !important;
}
.theme-dark .running-layout .deploy-kv-grid span {
  color: #9bb4c3 !important;
  background: rgba(255,255,255,.035) !important;
  border-color: rgba(74,190,255,.12) !important;
}
.theme-dark .running-layout .deploy-kv-grid b,
.theme-dark .running-layout .ant-card-head-title {
  color: #edf7fb !important;
}

/* Runtime popover dark theme for teleported overlays */
:root[data-theme="dark"] .ant-popover .runtime-detail-popover,
:root[data-theme="dark"] .ant-popover .runtime-config-popover {
  color: #edf7fb;
}
:root[data-theme="dark"] .ant-popover:has(.runtime-detail-popover) .ant-popover-inner,
:root[data-theme="dark"] .ant-popover:has(.runtime-config-popover) .ant-popover-inner {
  background: #202226 !important;
  border: 1px solid rgba(255,255,255,.08);
  box-shadow: 0 18px 36px rgba(0,0,0,.36);
}
:root[data-theme="dark"] .ant-popover:has(.runtime-detail-popover) .ant-popover-arrow::before,
:root[data-theme="dark"] .ant-popover:has(.runtime-config-popover) .ant-popover-arrow::before {
  background: #202226 !important;
}
:root[data-theme="dark"] .runtime-detail-popover span,
:root[data-theme="dark"] .runtime-config-popover label > span {
  color: #9bb4c3 !important;
}
:root[data-theme="dark"] .runtime-detail-popover b,
:root[data-theme="dark"] .runtime-detail-popover strong,
:root[data-theme="dark"] .runtime-detail-popover a {
  color: #edf7fb !important;
}
:root[data-theme="dark"] .runtime-config-popover .ant-input-number,
:root[data-theme="dark"] .runtime-config-popover .ant-select-selector,
:root[data-theme="dark"] .runtime-config-popover .ant-segmented {
  color: #edf7fb !important;
  background: rgba(255,255,255,.04) !important;
  border-color: rgba(74,190,255,.14) !important;
}


/* Downloads popover */
.shell-downloads-head strong { font-size: 16px; font-weight: 760; }
.shell-downloads-head-actions,
.shell-download-row-actions { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
.shell-download-row-actions { align-self: center; }
.shell-downloads-search {
  display: block;
  height: 26px;
  border-radius: 5px;
  border: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.06);
}
.shell-downloads-search input {
  width: 100%;
  height: 100%;
  border: 0;
  outline: 0;
  padding: 0 8px;
  color: inherit;
  background: transparent;
  font-size: 12px;
}
.shell-downloads-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 24px;
  color: #dbeafe;
  font-size: 12px;
  font-weight: 720;
}
.shell-downloads-section-head button {
  border: 0;
  padding: 0;
  color: #dbeafe;
  background: transparent;
  font-size: 12px;
  cursor: pointer;
}
.shell-downloads-section-head button:disabled { opacity: .4; cursor: default; }
.shell-download-row {
  grid-template-columns: 28px minmax(0, 1fr) auto;
  gap: 8px;
  padding: 9px 6px;
  border: 0;
  border-bottom: 1px solid rgba(255,255,255,.06);
  border-radius: 0;
  background: transparent;
}
.shell-download-row.isFailed { box-shadow: inset 3px 0 0 rgba(255,77,79,.8); }
.shell-download-row-main {
  min-width: 0;
  display: grid;
  gap: 2px;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  text-align: left;
  cursor: pointer;
}
.shell-download-row-main b,
.shell-download-row-main small {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shell-download-title-line {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #edf7fb;
  font-variant-numeric: tabular-nums;
}
.shell-download-row-main b { font-size: 12px; font-weight: 760; }
.shell-download-row-main small { color: #b9bdc6; font-size: 11px; }
.shell-download-meta {
  line-height: 1.25;
}
.shell-download-action {
  width: 24px;
  height: 24px;
  min-width: 24px;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 5px;
  color: #d7dde6;
  background: transparent;
  line-height: 1;
  cursor: pointer;
}
.shell-download-action .anticon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  font-size: 14px;
  line-height: 1;
}
.shell-download-action:hover { background: rgba(255,255,255,.09); }
.shell-download-action:disabled { opacity: .55; cursor: default; }
.shell-downloads-empty {
  display: grid;
  place-items: center;
  min-height: 120px;
  color: #9aa4b2;
  font-size: 12px;
}
.theme-light .shell-downloads-search { border-color: #dbe3ef; background: #f4f7fb; }
.theme-light .shell-downloads-head strong,
.theme-light .shell-download-title-line {
  color: #15202b;
}
.theme-light .shell-downloads-search input {
  color: #1f2d3d;
}
.theme-light .shell-downloads-search input::placeholder {
  color: #71839a;
}
.theme-light .shell-downloads-section-head,
.theme-light .shell-downloads-section-head button { color: #1f2d3d; }
.theme-light .shell-download-row { border-bottom-color: rgba(92,132,154,.12); }
.theme-light .shell-download-row-main small { color: #63798a; }
.theme-light .shell-download-action { color: #44526a; }
.theme-light .shell-download-action:hover { background: rgba(68,82,106,.08); }
.theme-light .shell-downloads-empty { color: #7f8ca0; }


/* Download task panel safety bounds */
.shell-downloads-scrim {
  position: fixed;
  inset: 0;
  z-index: 29;
  background: transparent;
}
.shell-downloads-panel {
  max-width: calc(100vw - 24px);
  overflow: hidden;
}
.shell-download-row {
  min-width: 0;
  overflow: hidden;
}
.shell-download-row-main {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}
.shell-download-row-main b,
.shell-download-row-main small {
  display: block;
  max-width: 100%;
}
.shell-download-row-main .shell-download-title-line {
  display: block;
}
.shell-download-row-actions {
  flex: 0 0 auto;
  max-width: 116px;
  overflow: hidden;
}
.download-clear-confirm p {
  margin: 0 0 10px;
  line-height: 1.45;
}
.download-clear-confirm dl {
  margin: 0;
  display: grid;
  gap: 7px;
}
.download-clear-confirm dl > div {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
}
.download-clear-confirm dt {
  color: #63798a;
  font-size: 12px;
}
.download-clear-confirm dd {
  margin: 0;
  min-width: 0;
  font-size: 12px;
  overflow-wrap: anywhere;
}
.download-clear-confirm small {
  display: block;
  margin-top: 10px;
  color: #8a95a5;
  line-height: 1.4;
}
.model-download-task-section .ant-list-item {
  min-width: 0;
  overflow: hidden;
}
.model-download-task-section .ant-list-item-meta {
  min-width: 0;
}
.model-download-task-section .ant-list-item-meta-title,
.model-download-task-section .ant-list-item-meta-description {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* Model library overflow guards */
.model-library-table .ant-table-content,
.model-library-table .ant-table-container,
.model-library-table .ant-table-body {
  min-width: 0;
  overflow-x: hidden !important;
}
.model-library-table table {
  width: 100% !important;
  table-layout: fixed !important;
}
.model-library-table .ant-table-cell {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.table-model-cell,
.table-model-name,
.table-model-path,
.table-compact-text,
.table-mono-chip {
  max-width: 100%;
}
.table-model-cell {
  width: 100%;
  overflow: hidden;
}
.table-mono-chip {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.modelDetailPanel,
.modelDetailSection,
.modelDetailSectionHead,
.modelDetailKv,
.modelDetailTaskList {
  min-width: 0;
}
.modelDetailSectionHead h3 {
  min-width: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.modelDetailBadge {
  flex: 0 0 auto;
  max-width: 86px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.modelDetailKvRow {
  min-width: 0;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  align-items: baseline;
}
.modelDetailKvRow strong {
  display: block;
  max-width: 100%;
}
.modelDetailTaskRow {
  min-width: 0;
  max-width: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  overflow: hidden;
}
.modelDetailTaskName {
  display: block;
  max-width: 100%;
}
.modelDetailTaskRow .ant-tag {
  flex: 0 0 auto;
  max-width: 84px;
  margin-inline-end: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


@media (max-width: 1400px) {
  .model-library-table colgroup col:nth-child(3),
  .model-library-table colgroup col:nth-child(4),
  .model-library-table .ant-table-thead > tr > th:nth-child(3),
  .model-library-table .ant-table-thead > tr > th:nth-child(4),
  .model-library-table .ant-table-tbody > tr > td:nth-child(3),
  .model-library-table .ant-table-tbody > tr > td:nth-child(4) {
    display: none;
  }
}


/* Custom runtime modal dark theme: Ant Modal is teleported outside the app shell. */
.custom-runtime-modal-wrap .ant-modal {
  top: 24px;
  max-width: calc(100vw - 32px);
  padding-bottom: 24px;
}
.custom-runtime-modal-wrap .ant-modal-content {
  max-height: calc(100vh - 48px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.custom-runtime-modal-wrap .ant-modal-header {
  flex: 0 0 auto;
}
.custom-runtime-modal-wrap .ant-modal-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-row,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control-input,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control-input-content {
  flex: 1 1 auto;
  min-height: 0;
  height: 100%;
  overflow: hidden;
}
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-row,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control-input,
.custom-runtime-modal-wrap .compose-editor-form .ant-form-item-control-input-content {
  display: flex;
}
.custom-runtime-modal-wrap .compose-editor-form .compose-editor,
.custom-runtime-modal-wrap .dockerfile-editor-shell .dockerfile-editor {
  flex: 1 1 auto;
  min-height: 0;
  height: 100% !important;
  resize: none;
  overflow: auto;
}
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-modal-content {
  color: #edf7fb;
  background: #1b1d20;
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 24px 64px rgba(0,0,0,.44);
}
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-modal-header {
  background: #1b1d20;
  border-bottom-color: rgba(255,255,255,.10);
}
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-modal-title,
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-modal-close {
  color: #edf7fb;
}
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-modal-body {
  color: #edf7fb;
  background: #1b1d20;
}
:root[data-theme="dark"] .custom-runtime-modal-wrap .ant-form-item-label > label {
  color: #9bb4c3;
}

/* Dark modal corrections for teleported Ant overlays */
:root[data-theme="dark"] .model-download-alert.ant-alert {
  color: #edf7fb;
  background: rgba(7, 25, 43, .96);
  border-color: rgba(74, 190, 255, .28);
}
:root[data-theme="dark"] .model-download-alert .ant-alert-message,
:root[data-theme="dark"] .model-download-alert .ant-alert-description,
:root[data-theme="dark"] .model-download-alert .inline-pre,
:root[data-theme="dark"] .model-download-alert .download-check-row {
  color: #edf7fb;
}
:root[data-theme="dark"] .model-download-alert .ant-alert-icon { color: #4abeff; }
:root[data-theme="dark"] .model-download-task-section { border-top-color: rgba(74,190,255,.16); }
:root[data-theme="dark"] .model-download-task-section .detailCardTitle,
:root[data-theme="dark"] .model-download-task-section .ant-list-item-meta-title {
  color: #edf7fb;
}
:root[data-theme="dark"] .model-download-task-section .ant-list-item-meta-description {
  color: #9bb4c3;
}
:root[data-theme="dark"] .model-download-task-section .ant-list-item {
  border-block-end-color: rgba(74,190,255,.1);
}

:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-nav::before {
  border-bottom-color: rgba(255,255,255,.11);
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-tab {
  color: #cfe7f2;
  background: #202226;
  border-color: rgba(255,255,255,.13);
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-tab:hover {
  color: #ffffff;
  background: rgba(74,190,255,.10);
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-tab-active {
  background: #101820;
  border-color: rgba(74,190,255,.38);
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-tab-active .ant-tabs-tab-btn {
  color: #4abeff;
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-tabs-content-holder {
  color: #edf7fb;
  background: #1b1d20;
}
:root[data-theme="dark"] .custom-container-flow-tabs .flow-panel,
:root[data-theme="dark"] .custom-container-flow-tabs .dockerfile-editor-shell,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-panel,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-image-panel,
:root[data-theme="dark"] .custom-container-flow-tabs .component-panel {
  color: #edf7fb;
  background: #202226;
  border-color: rgba(255,255,255,.13);
}
:root[data-theme="dark"] .custom-container-flow-tabs .basics-intro,
:root[data-theme="dark"] .custom-container-flow-tabs .basics-note,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-tab-head,
:root[data-theme="dark"] .custom-container-flow-tabs .component-panel-head,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-image-card,
:root[data-theme="dark"] .custom-container-flow-tabs .dockerfile-editor-meta span,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-readonly-grid span,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-mount-grid span {
  color: #cfe7f2;
  background: #282b31;
  border-color: rgba(255,255,255,.10);
}
:root[data-theme="dark"] .custom-container-flow-tabs .component-row {
  color: #edf7fb;
  border-top-color: rgba(255,255,255,.10);
}
:root[data-theme="dark"] .custom-container-flow-tabs .component-row.selected {
  background: rgba(74,190,255,.09);
}
:root[data-theme="dark"] .custom-container-flow-tabs .component-row.custom {
  background: rgba(34,211,120,.08);
}
:root[data-theme="dark"] .custom-container-flow-tabs .basics-intro span,
:root[data-theme="dark"] .custom-container-flow-tabs .basics-note,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-tab-head span,
:root[data-theme="dark"] .custom-container-flow-tabs .preset-row,
:root[data-theme="dark"] .custom-container-flow-tabs .component-empty,
:root[data-theme="dark"] .custom-container-flow-tabs .dockerfile-empty-state,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-empty,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-grid label,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-advanced-block summary,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-mount-grid small,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-image-card span {
  color: #9bb4c3;
}
:root[data-theme="dark"] .custom-container-flow-tabs .basics-intro strong,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-tab-head strong,
:root[data-theme="dark"] .custom-container-flow-tabs .component-row-main b,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-readonly-grid b,
:root[data-theme="dark"] .custom-container-flow-tabs .runtime-compose-mount-grid b,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-image-card b {
  color: #edf7fb;
}
:root[data-theme="dark"] .custom-container-flow-tabs .custom-component-row {
  border-top-color: rgba(255,255,255,.10);
}
:root[data-theme="dark"] .custom-container-flow-tabs :is(.ant-input, .ant-input-number, .ant-select-selector, textarea.ant-input) {
  color: #edf7fb !important;
  background: #101214 !important;
  border-color: rgba(255,255,255,.18) !important;
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-input-number-input,
:root[data-theme="dark"] .custom-container-flow-tabs .ant-select-selection-item {
  color: #edf7fb !important;
}
:root[data-theme="dark"] .custom-container-flow-tabs .ant-select-arrow {
  color: #9bb4c3;
}
:root[data-theme="dark"] .custom-container-flow-tabs :is(.ant-input::placeholder, textarea.ant-input::placeholder) {
  color: #6f7f91 !important;
}
:root[data-theme="dark"] .custom-container-flow-tabs :is(.ant-input[disabled], .ant-input-number-disabled, .ant-select-disabled .ant-select-selector) {
  color: #8fa1b3 !important;
  background: #15181c !important;
  border-color: rgba(255,255,255,.12) !important;
}
:root[data-theme="dark"] .custom-container-flow-tabs .dockerfile-editor,
:root[data-theme="dark"] .custom-container-flow-tabs .compose-editor {
  color: #edf7fb !important;
  background: #101214 !important;
  border-color: rgba(255,255,255,.18) !important;
  caret-color: #4abeff;
}
