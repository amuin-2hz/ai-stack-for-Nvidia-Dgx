{
  "name": "amuin-ai-stack",
  "version": "1.1.0",
  "private": true,
  "main": "apps/main/dist/index.js",
  "scripts": {
    "dev": "bash scripts/dev-electron.sh",
    "dev:web": "DISPLAY_MODE=web bash scripts/dev-electron.sh",
    "dev:electron": "DISPLAY_MODE=electron bash scripts/dev-electron.sh",
    "dev:xvfb": "DISPLAY_MODE=xvfb bash scripts/dev-electron.sh",
    "build:main": "tsc -p apps/main/tsconfig.json",
    "build:api": "npm --prefix apps/api run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build": "npm run build:main && npm run build:api && npm run build:frontend",
    "pack": "npm run pack:dir && node scripts/package-deb.js",
    "postinstall": "npm --prefix apps/api install && npm --prefix apps/frontend install",
    "pack:dir": "electron-builder --linux dir"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.amuin.ai-stack",
    "productName": "AMUIN AI STACK",
    "directories": {
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Science",
      "maintainer": "amuin@example.com"
    },
    "deb": {
      "depends": [
        "bash",
        "docker-ce | docker.io",
        "docker-compose-plugin | docker-compose-v2",
        "nvidia-container-toolkit | nvidia-docker2",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "files": [
      "apps/main/dist/**/*",
      "apps/api/dist/**/*",
      "apps/frontend/dist/**/*",
      "configs/**/*",
      "deploy/compose/**/*",
      "deploy/templates/**/*",
      "deploy/dockerfiles/**/*",
      "ops/scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "apps/api/node_modules",
        "to": "app.asar.unpacked/apps/api/node_modules"
      }
    ],
    "asarUnpack": [
      "apps/api/dist/**/*",
      "apps/frontend/dist/**/*",
      "configs/**/*",
      "deploy/**/*",
      "ops/scripts/**/*"
    ]
  },
  "description": "AMUIN AI STACK desktop workbench for local DGX Spark AI runtimes",
  "author": "AMUIN",
  "homepage": "https://amuin.ai"
}
